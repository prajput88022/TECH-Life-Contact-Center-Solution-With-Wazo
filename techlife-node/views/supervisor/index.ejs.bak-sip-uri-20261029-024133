<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<h1>Live Operations Dashboard</h1>
<p class="tl-subtitle">Auto-refreshes every 10 seconds. Filter by queue, campaign, or skill to focus on a specific team.</p>

<div class="supervisor-workspace">
<div class="tl-card" id="supervisorPhone" style="margin:16px 0">
    <h2 style="margin-top:0">Supervisor WebRTC Phone</h2>
    <p>Registration: <span id="supervisorSipStatus" class="tl-status-pill status-break">checking profile…</span></p>
    <p id="supervisorCallState" aria-live="polite">Waiting for phone registration.</p>

    <style>
      .supervisor-workspace {
        display:grid;
        grid-template-columns:minmax(0,1fr);
        gap:16px;
        align-items:start;
        margin:16px 0;
      }
      .supervisor-wallboard-kpis {
        display:grid;
        grid-template-columns:repeat(2,minmax(0,1fr));
        gap:8px;
        margin:12px 0;
      }
      .supervisor-wallboard-kpis > .tl-card { padding:10px; min-width:0; }
      .supervisor-wallboard-kpis .tl-kpi-value { font-size:1.5rem; }
      #supervisorWallboardCalls, #supervisorWallboardAgents {
        display:grid; gap:7px; max-height:300px; overflow:auto;
      }
      .supervisor-wallboard-item {
        display:flex; justify-content:space-between; align-items:center;
        gap:8px; padding:9px; border:1px solid #8885;
        border-radius:8px; min-width:0;
      }
      .supervisor-wallboard-item small {
        display:block; overflow-wrap:anywhere; opacity:.75; margin-top:3px;
      }
      @media (min-width:1050px) {
        .supervisor-workspace {
          grid-template-columns:minmax(280px,.85fr) minmax(400px,1.15fr);
        }
        .supervisor-wallboard-kpis { grid-template-columns:repeat(4,minmax(0,1fr)); }
      }
      #supervisorPhone .zp-phone {
        width:100%; max-width:310px; box-sizing:border-box; padding:12px;
        border:1px solid #444; border-radius:22px;
        background:linear-gradient(160deg,#292929,#080808 72%);
        color:#f6f6f6; box-shadow:0 8px 24px #0003;
      }
      #supervisorPhone .zp-screen {
        background:linear-gradient(135deg,#fffca0,#e8ed63);
        color:#171717; border:3px solid #111; border-radius:9px;
        padding:10px; min-height:72px; overflow-wrap:anywhere;
      }
      #supervisorPhone .zp-lines {
        display:grid; grid-template-columns:repeat(3,minmax(0,1fr));
        gap:6px; margin:10px 0;
      }
      #supervisorPhone .zp-line {
        min-width:0; padding:8px 3px; border:1px solid #555;
        border-radius:7px; background:#292929; color:#eee;
        font-size:12px; cursor:pointer;
      }
      #supervisorPhone .zp-line.active {
        background:#b9e76c; color:#14200b; border-color:#e5ffad;
      }
      #supervisorPhone .zp-line small { display:block; font-size:10px; margin-top:3px; }
      #supervisorPhone .zp-keys {
        display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:6px;
      }
      #supervisorPhone .zp-key {
        min-width:0; min-height:43px; border:1px solid #414141;
        border-radius:7px; color:white; background:linear-gradient(#343434,#171717);
        font-size:19px; font-weight:600; cursor:pointer;
      }
      #supervisorPhone .zp-key:active { background:#777; transform:scale(.98); }
      #supervisorPhone .zp-actions { display:flex; gap:7px; margin-top:9px; }
      #supervisorPhone .zp-actions button {
        flex:1; min-height:40px; min-width:0; padding:7px;
      }
      #supervisorPhone .zp-extra {
        margin-top:10px; padding:10px; border:1px solid #444;
        border-radius:10px; background:#151515;
      }
      #supervisorPhone .zp-extra input {
        box-sizing:border-box; width:100%; margin:4px 0 8px;
        min-height:36px; color:#fff; background:#252525;
        border:1px solid #555; border-radius:6px; padding:7px;
      }
      #supervisorPhone .zp-extra label { font-size:12px; color:#ddd; }
      @media(max-width:420px) {
        #supervisorPhone .zp-phone { max-width:100%; }
      }
    </style>

    <div class="zp-phone" id="supervisorDialpad">
      <div style="font-size:12px;letter-spacing:2px;color:#ddd;margin:0 0 8px">
        TECH-LIFE SOFTPHONE
      </div>

      <div class="zp-screen">
        <div id="supervisorActiveLineLabel" style="font-size:12px">LINE 1 · TECH-LIFE</div>
        <input id="supervisorDialInput" type="tel" inputmode="tel"
               autocomplete="off" aria-label="Number to dial"
               placeholder="Enter number"
               style="box-sizing:border-box;width:100%;height:37px;border:0;background:transparent;
                      color:#111;font-size:22px;outline:none">
        <div id="supervisorPhoneHint" style="font-size:11px">Ready when registered</div>
      </div>

      <div class="zp-lines">
        <button type="button" id="supervisorLineBtn1" class="zp-line active"
                onclick="selectSupervisorLine(1)">Line 1<small id="supervisorLineState1">Auto</small></button>
        <button type="button" id="supervisorLineBtn2" class="zp-line"
                onclick="selectSupervisorLine(2)">Line 2<small id="supervisorLineState2">Not set</small></button>
        <button type="button" id="supervisorLineBtn3" class="zp-line"
                onclick="selectSupervisorLine(3)">Line 3<small id="supervisorLineState3">Not set</small></button>
      </div>

      <div class="zp-keys">
        <% ['1','2','3','4','5','6','7','8','9','*','0','#'].forEach(k => { %>
          <button type="button" class="zp-key"
                  onclick="supervisorDialKey('<%= k %>')"><%= k %></button>
        <% }) %>
      </div>

      <div class="zp-actions">
        <button type="button" id="supervisorCallBtn" class="tl-btn"
                onclick="placeSupervisorCall()">Call</button>
        <button type="button" id="supervisorHangupBtn" class="tl-btn"
                style="background:#b42318;display:none"
                onclick="hangupSupervisorCall()">Hang up</button>
        <button type="button" class="tl-btn secondary"
                style="flex:0 0 44px" aria-label="Delete last digit"
                onclick="supervisorDeleteDigit()">⌫</button>
      </div>

      <button type="button" class="tl-btn secondary"
              style="width:100%;margin-top:8px"
              onclick="document.getElementById('supervisorExtraLines').hidden =
                       !document.getElementById('supervisorExtraLines').hidden">
        Configure extra SIP lines
      </button>
      <div id="supervisorCallControls" style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px;margin-top:9px">
        <button type="button" id="supervisorMuteBtn" class="tl-btn secondary" onclick="toggleSupervisorMute()" disabled>Mute</button>
        <button type="button" id="supervisorHoldBtn" class="tl-btn secondary" onclick="toggleSupervisorHold()" disabled>Hold</button>
        <button type="button" id="supervisorTransferBtn" class="tl-btn secondary" onclick="transferSupervisorCall()" disabled>Transfer</button>
        <button type="button" id="supervisorConferenceBtn" class="tl-btn secondary" onclick="conferenceSupervisorCall()" disabled>Conference</button>
      </div>
      <div style="margin-top:10px">
        <label for="supervisorVolume" style="display:flex;justify-content:space-between;font-size:12px">
          <span>Call volume</span><span id="supervisorVolumeValue">100%</span>
        </label>
        <input id="supervisorVolume" type="range" min="0" max="100" value="100" step="5"
               style="width:100%;accent-color:#10b981"
               oninput="setSupervisorVolume(this.value)">
      </div>

      <div id="supervisorExtraLines" class="zp-extra" hidden>
        <p style="font-size:12px;margin:0 0 8px;color:#ddd">
          Optional accounts stay in this page's memory only. Enter the WebSocket
          URI supplied by your SIP provider.
        </p>
        <% [2,3].forEach(n => { %>
          <div style="border-top:1px solid #444;padding-top:9px;margin-top:7px">
            <strong style="font-size:13px">Line <%= n %></strong>
            <label for="supervisorSipUser<%= n %>">SIP username</label>
            <input id="supervisorSipUser<%= n %>" autocomplete="off">
            <label for="supervisorSipPass<%= n %>">SIP password</label>
            <input id="supervisorSipPass<%= n %>" type="password" autocomplete="new-password">
            <label for="supervisorSipDomain<%= n %>">SIP domain</label>
            <input id="supervisorSipDomain<%= n %>" placeholder="sip.example.com" autocomplete="off">
            <label for="supervisorSipWs<%= n %>">Secure WebSocket URI</label>
            <input id="supervisorSipWs<%= n %>" placeholder="wss://sip.example.com/..." autocomplete="off">
            <button type="button" class="tl-btn" style="width:100%"
                    onclick="registerSupervisorExtraLine(<%= n %>)">
              Register Line <%= n %>
            </button>
            <p id="supervisorExtraMsg<%= n %>" style="font-size:11px;margin:6px 0">Not registered</p>
          </div>
        <% }) %>
        <p style="font-size:11px;color:#ccc">
          These credentials are not saved. Reloading the page clears the extra lines.
        </p>
      </div>
    </div>
    <div id="supervisorIncomingControls" style="display:none">
        <button class="tl-btn" type="button" onclick="answerSupervisorCall()">Answer monitoring call</button>
        <button class="tl-btn secondary" type="button" onclick="rejectSupervisorCall()">Reject</button>
    </div>
    <audio id="supervisorRemoteAudio" autoplay playsinline></audio>
</div>
<section class="tl-card" id="supervisorWallboard" style="margin:16px 0;min-width:0">
    <h2 style="margin-top:0">Live Wallboard</h2>
    <p class="tl-subtitle">Agent and call activity · refreshes every 10 seconds</p>
    <div id="supervisorWallboardKpis" class="supervisor-wallboard-kpis">
        <div class="tl-card"><div class="tl-kpi-value">—</div><div class="tl-kpi-label">Agents</div></div>
        <div class="tl-card"><div class="tl-kpi-value">—</div><div class="tl-kpi-label">Available</div></div>
        <div class="tl-card"><div class="tl-kpi-value">—</div><div class="tl-kpi-label">On Call</div></div>
        <div class="tl-card"><div class="tl-kpi-value">—</div><div class="tl-kpi-label">Calls Waiting</div></div>
    </div>
    <h3>Active Calls</h3>
    <div id="supervisorWallboardCalls">Waiting for live data…</div>
    <h3>Agent Status</h3>
    <div id="supervisorWallboardAgents">Waiting for live data…</div>
    <p id="supervisorWallboardUpdated" class="tl-subtitle">Waiting for first refresh…</p>
</section>
