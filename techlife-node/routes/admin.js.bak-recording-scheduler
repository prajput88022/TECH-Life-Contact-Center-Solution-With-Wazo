        `SELECT * FROM prefixes WHERE id=$1 AND tenant_id=$2`,
        [req.params.id, tenantId]
    );
    if (!found.rowCount) return res.status(404).send('Prefix not found.');

    const old = found.rows[0];
    if (old.is_active) {
        return res.status(409).send('Deactivate this prefix before editing it.');
    }
    if (old.provisioning_status === 'legacy' &&
        !old.wazo_pattern_extension_id) {
        return res.status(409).send(
            'This legacy route cannot be edited safely.'
        );
    }

    const digits = String(b.prefix_digits || '').trim();
    const routeName = String(b.route_name || '').trim() || null;
    const strip = Number(b.strip_digits);
    const prepend = String(b.prepend_digits || '').trim();
    const priority = Number(b.priority);
    const scopeType = String(b.scope_type || 'tenant');
    const agentId = String(b.agent_id || '').trim() || null;
    const groupId = String(b.user_group_id || '').trim() || null;
    const campaignId = String(b.campaign_id || '').trim() || null;

    const orderedTrunkIds = [
        b.primary_trunk_id,
        b.backup_trunk_1,
        b.backup_trunk_2,
        b.backup_trunk_3
    ].map(v => String(v || '').trim()).filter(Boolean);

    if (!/^[0-9*#+]{1,32}$/.test(digits)) {
        return res.status(400).send('Prefix must contain 1–32 digits, *, #, or +.');
    }
    if (!Number.isInteger(strip) || strip < 0 || strip > digits.length) {
        return res.status(400).send('Strip digits must be between zero and prefix length.');
    }
    if (!/^[0-9*#+]{0,32}$/.test(prepend)) {
        return res.status(400).send('Invalid prepend digits.');
    }
    if (!Number.isInteger(priority) || priority < 0 || priority > 100000) {
        return res.status(400).send('Priority must be between 0 and 100000.');
    }
    if (!['tenant', 'agent', 'group', 'campaign'].includes(scopeType)) {
        return res.status(400).send('Invalid prefix scope.');
    }
    if (scopeType === 'tenant' && (!/^\d{1,20}$/.test(digits) ||
        agentId || groupId || campaignId)) {
        return res.status(400).send('Invalid tenant-wide prefix configuration.');
    }
    if (scopeType === 'agent' && (!agentId || groupId || campaignId)) {
        return res.status(400).send('Select exactly one agent.');
    }
    if (scopeType === 'group' && (!groupId || agentId || campaignId)) {
        return res.status(400).send('Select exactly one group.');
    }
    if (scopeType === 'campaign' && (!campaignId || agentId || groupId)) {
        return res.status(400).send('Select exactly one campaign.');
    }
    if (!orderedTrunkIds.length ||
        new Set(orderedTrunkIds).size !== orderedTrunkIds.length) {
        return res.status(400).send('Choose a primary trunk and unique backup trunks.');
    }

    const targetChecks = {
        agent: ['SELECT id FROM agents WHERE id=$1 AND tenant_id=$2 AND is_active=TRUE', agentId],
        group: ['SELECT id FROM user_groups WHERE id=$1 AND tenant_id=$2 AND is_active=TRUE', groupId],
        campaign: ['SELECT id FROM campaigns WHERE id=$1 AND tenant_id=$2', campaignId]
    };

    if (scopeType !== 'tenant') {
        const [sql, targetId] = targetChecks[scopeType];
        const check = await pool.query(sql, [targetId, tenantId]);
        if (!check.rowCount) {
            return res.status(400).send('Scope target is missing, inactive, or belongs to another tenant.');
        }
    }

    const trunkCheck = await pool.query(
        `SELECT id, is_active, provisioning_status
           FROM trunks
          WHERE tenant_id=$1 AND id=ANY($2::uuid[])`,
        [tenantId, orderedTrunkIds]
    );
    if (trunkCheck.rowCount !== orderedTrunkIds.length ||
        trunkCheck.rows.some(x => !x.is_active ||
                                  x.provisioning_status !== 'provisioned')) {
        return res.status(400).send('Every selected trunk must belong to this tenant and be active/provisioned.');
    }

    const client = await pool.connect();
    try {
        await client.query('BEGIN');

        const locked = await client.query(
            `SELECT is_active FROM prefixes
              WHERE id=$1 AND tenant_id=$2 FOR UPDATE`,
            [old.id, tenantId]
        );
        if (!locked.rowCount || locked.rows[0].is_active) {
            throw new Error('Prefix became active during editing; no changes were saved.');
        }

        await client.query(
            `UPDATE prefixes
                SET trunk_id=$1, prefix_digits=$2, route_name=$3,
                    strip_digits=$4, prepend_digits=$5, priority=$6,
                    agent_id=$7, user_group_id=$8, campaign_id=$9,
                    provisioning_status = CASE
                        WHEN $12 = 'tenant' THEN 'pending'
                        ELSE 'failed'
                    END,
                    provisioning_error = CASE
                        WHEN $12 = 'tenant' THEN NULL
                        ELSE 'Scope-specific routing is not implemented; route remains inactive.'
                    END
              WHERE id=$10 AND tenant_id=$11`,
            [
                orderedTrunkIds[0], digits, routeName, strip, prepend || null,
                priority,
                scopeType === 'agent' ? agentId : null,
                scopeType === 'group' ? groupId : null,
                scopeType === 'campaign' ? campaignId : null,
                old.id, tenantId, scopeType
            ]
        );

        await client.query(
            `DELETE FROM prefix_trunks WHERE tenant_id=$1 AND prefix_id=$2`,
            [tenantId, old.id]
        );

        for (let i = 0; i < orderedTrunkIds.length; i++) {
            await client.query(
                `INSERT INTO prefix_trunks
                    (tenant_id, prefix_id, trunk_id, priority, is_active)
                 VALUES ($1,$2,$3,$4,TRUE)`,
                [tenantId, old.id, orderedTrunkIds[i], i]
            );
        }

        await client.query('COMMIT');
    } catch (err) {
        await client.query('ROLLBACK').catch(() => {});
        return res.status(409).send('Prefix edit failed: ' + err.message);
    } finally {
        client.release();
    }

    await writeAuditLog(tenantId, req.session.user.id, 'PREFIX_EDITED',
        'prefix', old.id, null, {
            prefix_digits: digits,
            route_name: routeName,
            scope_type: scopeType,
            trunk_ids: orderedTrunkIds,
            is_active: false
        });

    res.redirect('/admin/prefixes' +
        (req.query.as_tenant
            ? '?as_tenant=' + encodeURIComponent(req.query.as_tenant)
            : ''));
});


router.post('/prefixes/:id/activate', async (req, res) => {
    const t = req.effectiveTenant.id;
    const result = await pool.query(
        `SELECT p.id, p.prefix_digits, p.trunk_id, p.agent_id, p.user_group_id,
                p.campaign_id, p.is_active, tr.name AS trunk_name
           FROM prefixes p
           LEFT JOIN trunks tr
             ON tr.id = p.trunk_id AND tr.tenant_id = p.tenant_id
          WHERE p.id = $1 AND p.tenant_id = $2`,
        [req.params.id, t]
    );

    if (!result.rowCount) {
        return res.status(404).send('Prefix not found in this tenant.');
    }

    const prefix = result.rows[0];

    if (prefix.is_active) {
        return res.status(409).send('Prefix is already active.');
    }

    // Fail closed before creating or modifying any Wazo resources.
    // Scoped routes require scope-aware Wazo runtime routing, which is
    // not implemented yet. Keep this check in addition to the service guard.
    if (prefix.campaign_id || prefix.agent_id || prefix.user_group_id) {
        return res.status(409).send(
            'Scoped routing is not available yet. Campaign-, agent-, and ' +
            'group-specific Wazo runtime routing must be implemented before activation.'
        );
    }

    // Reject same-digit routes whose scopes overlap.
    // This is a safety guard, not a substitute for a runtime precedence resolver.
    const conflicts = await pool.query(
        `SELECT p.id, p.prefix_digits
           FROM prefixes p
          WHERE p.tenant_id = $1
            AND p.id <> $2
            AND p.is_active = TRUE
            AND p.prefix_digits = $3
            AND (
              -- Existing tenant-wide or unsupported campaign route.
              (p.agent_id IS NULL AND p.user_group_id IS NULL
               AND p.campaign_id IS NULL)
              OR p.campaign_id IS NOT NULL

              -- Candidate is tenant-wide: it overlaps every existing scope.
              OR ($4::uuid IS NULL AND $5::uuid IS NULL)

              -- Candidate is agent-specific.
              OR (
                $4::uuid IS NOT NULL
                AND (
                  p.agent_id = $4
                  OR EXISTS (
                    SELECT 1
                      FROM user_group_agents uga
                     WHERE uga.tenant_id = $1
                       AND uga.group_id = p.user_group_id
                       AND uga.agent_id = $4
                  )
                )
              )

              -- Candidate is group-specific.
              OR (
                $5::uuid IS NOT NULL
                AND (
                  EXISTS (
                    SELECT 1
                      FROM user_group_agents uga
                     WHERE uga.tenant_id = $1
                       AND uga.group_id = $5
                       AND uga.agent_id = p.agent_id
                  )
                  OR EXISTS (
                    SELECT 1
                      FROM user_group_agents candidate_member
                      JOIN user_group_agents existing_member
                        ON existing_member.tenant_id = candidate_member.tenant_id
                       AND existing_member.agent_id = candidate_member.agent_id
                     WHERE candidate_member.tenant_id = $1
                       AND candidate_member.group_id = $5
                       AND existing_member.group_id = p.user_group_id
                  )
                )
              )
            )
          LIMIT 1`,
        [t, prefix.id, prefix.prefix_digits, prefix.agent_id, prefix.user_group_id]
    );

    if (conflicts.rowCount) {
        return res.status(409).send(
            'An active prefix with the same digits overlaps this scope. ' +
            'Deactivate or resolve the conflicting route first.'
        );
    }

    try {
        await provisionPrefixOutboundRoute(prefix.id, t);

        await setPrefixOutboundRouteEnabled(prefix.id, t, true);
    } catch (error) {
        console.error('[prefix activation] Wazo provisioning/activation failed:', error.message);

        await pool.query(
            `UPDATE prefixes
                SET is_active = FALSE,
                    provisioning_status = 'failed',
                    provisioning_error = $3
              WHERE id = $1 AND tenant_id = $2`,
            [prefix.id, t, String(error.message || error).slice(0, 1500)]
        );

        return res.status(502).send(
            'Wazo outbound routing could not be configured and enabled: ' + error.message
        );
    }

    const activated = await pool.query(
        `UPDATE prefixes
            SET is_active = TRUE,
                provisioning_status = 'provisioned',
                provisioning_error = NULL,
                last_provisioned_at = NOW()
          WHERE id = $1
            AND tenant_id = $2
            AND is_active = FALSE
        RETURNING id`,
        [prefix.id, t]
    );

    if (!activated.rowCount) {
        try {
            await setPrefixOutboundRouteEnabled(prefix.id, t, false);
        } catch (disableError) {
            console.error(
                '[prefix activation] Could not disable outcall after DB activation failure:',
                disableError.message
            );
        }

        return res.status(409).send(
            'Prefix state changed during activation. The route was not marked active.'
        );
    }

    await writeAuditLog(t, req.session.user.id, 'PREFIX_ACTIVATED',
        'prefix', prefix.id, null, {
            prefix_digits: prefix.prefix_digits,
            trunk_id: prefix.trunk_id,
            is_active: true
        }
    );

    res.redirect('/admin/prefixes' +
        (req.query.as_tenant
            ? '?as_tenant=' + encodeURIComponent(req.query.as_tenant)
            : ''));
});

router.post('/prefixes/:id/deactivate', async (req, res) => {
    const t = req.effectiveTenant.id;

    const found = await pool.query(
        `SELECT id, prefix_digits, wazo_outcall_id,
                wazo_pattern_extension_id, provisioning_status
           FROM prefixes
          WHERE id = $1 AND tenant_id = $2`,
        [req.params.id, t]
    );

    if (!found.rowCount) {
        return res.status(404).send('Prefix not found in this tenant.');
    }

    const prefix = found.rows[0];

    // Disable any outcall owned by this prefix, including legacy routes
    // whose pattern-extension ID was never persisted. The service verifies
    // tenant ownership and refuses shared outcalls before changing Wazo.
    if (prefix.wazo_outcall_id) {
        try {
            await setPrefixOutboundRouteEnabled(prefix.id, t, false);
        } catch (error) {
            console.error('[prefix deactivation] Wazo disable failed:', error.message);
            return res.status(502).send(
                'Could not safely disable the Wazo route; the prefix remains unchanged: ' +
                error.message
            );
        }
    }

    const result = await pool.query(
        `UPDATE prefixes
            SET is_active = FALSE
          WHERE id = $1 AND tenant_id = $2
          RETURNING id, prefix_digits`,
        [prefix.id, t]
    );

    if (!result.rowCount) {
        return res.status(404).send('Prefix not found in this tenant.');
