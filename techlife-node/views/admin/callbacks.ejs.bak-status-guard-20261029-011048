<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<h1>Callback Management</h1>
<p class="tl-subtitle">Manage scheduled follow-ups, overdue callbacks, agent assignments, and outcomes.</p>

<% if (updated) { %>
<div class="tl-card" role="status">Callback updated successfully.</div>
<% } %>

<div class="tl-grid">
    <% [
        ['Total', counts.total],
        ['Scheduled', counts.scheduled],
        ['Overdue', counts.overdue],
        ['Completed', counts.completed],
        ['Cancelled', counts.cancelled],
        ['Failed', counts.failed]
    ].forEach(item => { %>
    <div class="tl-card">
        <div class="tl-kpi-value"><%= item[1] %></div>
        <div class="tl-kpi-label"><%= item[0] %></div>
    </div>
    <% }) %>
</div>

<div class="tl-card">
    <h2>Filter callbacks</h2>
    <form method="get" action="/admin/callbacks">
        <div class="tl-filters">
            <div>
                <label for="callbackStatus">Status</label>
                <select name="status" id="callbackStatus">
                    <% [
                        ['all', 'All statuses'],
                        ['scheduled', 'Scheduled'],
                        ['claimed', 'Claimed'],
                        ['dialing', 'Dialing'],
                        ['completed', 'Completed'],
                        ['cancelled', 'Cancelled'],
                        ['failed', 'Failed']
                    ].forEach(option => { %>
                    <option value="<%= option[0] %>" <%= status === option[0] ? 'selected' : '' %>>
                        <%= option[1] %>
                    </option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label for="callbackView">Due date</label>
                <select name="view" id="callbackView">
                    <option value="all" <%= view === 'all' ? 'selected' : '' %>>All due dates</option>
                    <option value="overdue" <%= view === 'overdue' ? 'selected' : '' %>>Overdue scheduled</option>
                    <option value="upcoming" <%= view === 'upcoming' ? 'selected' : '' %>>Upcoming scheduled</option>
                </select>
            </div>
            <div><button class="tl-btn" type="submit">Apply filters</button></div>
            <div><a href="/admin/callbacks">Clear filters</a></div>
        </div>
    </form>
</div>

<h2>Callback queue</h2>
<p class="tl-subtitle">Up to 500 callbacks are shown, ordered with overdue scheduled callbacks first.</p>

<div class="tl-card" style="overflow-x:auto">
<table>
    <thead>
        <tr>
            <th>Customer / Callback</th>
            <th>Assigned agent</th>
            <th>Campaign</th>
            <th>Due date</th>
            <th>Status / update</th>
            <th>Reschedule</th>
            <th>Reassign</th>
            <th>Notes</th>
        </tr>
    </thead>
    <tbody>
    <% callbacks.forEach(cb => { %>
        <tr>
            <td>
                <strong><%= cb.phone_number %></strong>
                <div class="tl-subtitle">ID: <%= cb.id %></div>
                <% if (cb.call_direction || cb.call_status) { %>
                <div class="tl-subtitle">Original call: <%= cb.call_direction || '—' %> / <%= cb.call_status || '—' %></div>
                <% } %>
                <% if (cb.lead_id) { %><div class="tl-subtitle">Lead: <%= cb.lead_id %></div><% } %>
            </td>
            <td><%= cb.agent_name %><div class="tl-subtitle">Ext. <%= cb.extension || '—' %></div></td>
            <td><%= cb.campaign_name || '—' %></td>
            <td>
                <%= new Date(cb.due_at).toLocaleString() %>
                <% if (cb.status === 'scheduled' && new Date(cb.due_at) < new Date()) { %>
                <div class="tl-subtitle">Overdue</div>
                <% } %>
            </td>
            <td>
                <form method="post" action="/admin/callbacks/<%= cb.id %>/update">
                    <input type="hidden" name="action" value="status">
                    <label>
                        <span class="tl-subtitle">Change status</span>
                        <select name="status" required>
                            <% [
                                ['scheduled', 'Scheduled'],
                                ['claimed', 'Claimed'],
                                ['dialing', 'Dialing'],
                                ['completed', 'Completed'],
                                ['cancelled', 'Cancelled'],
                                ['failed', 'Failed']
                            ].forEach(option => { %>
                            <option value="<%= option[0] %>" <%= cb.status === option[0] ? 'selected' : '' %>>
                                <%= option[1] %>
                            </option>
                            <% }) %>
                        </select>
                    </label>
                    <button class="tl-btn" type="submit">Save status</button>
                </form>
            </td>
            <td>
                <form method="post" action="/admin/callbacks/<%= cb.id %>/update" data-reschedule-form>
                    <input type="hidden" name="action" value="reschedule">
                    <input type="hidden" name="due_at">
                    <label>
                        <span class="tl-subtitle">New date and time</span>
                        <input type="datetime-local" data-local-due data-utc="<%= new Date(cb.due_at).toISOString() %>" required>
                    </label>
                    <label>
                        <span class="tl-subtitle">Updated note (optional)</span>
                        <input name="notes" maxlength="4000" value="<%= cb.notes || '' %>">
                    </label>
                    <button class="tl-btn" type="submit">Reschedule</button>
                </form>
            </td>
            <td>
                <form method="post" action="/admin/callbacks/<%= cb.id %>/update">
                    <input type="hidden" name="action" value="reassign">
                    <label>
                        <span class="tl-subtitle">Assign to agent</span>
                        <select name="agent_id" required>
                            <% agents.forEach(agent => { %>
                            <option value="<%= agent.id %>" <%= agent.id === cb.agent_id ? 'selected' : '' %>>
                                <%= agent.agent_name %> (<%= agent.extension || 'no extension' %>)
                            </option>
                            <% }) %>
                        </select>
                    </label>
                    <button class="tl-btn" type="submit">Reassign</button>
                </form>
            </td>
            <td>
                <form method="post" action="/admin/callbacks/<%= cb.id %>/update">
                    <input type="hidden" name="action" value="notes">
                    <label>
                        <span class="tl-subtitle">Callback notes</span>
                        <textarea name="notes" rows="3" maxlength="4000"><%= cb.notes || '' %></textarea>
                    </label>
                    <button class="tl-btn" type="submit">Save notes</button>
                </form>
            </td>
        </tr>
    <% }) %>
    <% if (!callbacks.length) { %>
        <tr><td colspan="8">No callbacks match these filters.</td></tr>
    <% } %>
    </tbody>
</table>
</div>

<script>
document.querySelectorAll('form[data-reschedule-form]').forEach(form => {
    const localInput = form.querySelector('[data-local-due]');
    const hiddenInput = form.querySelector('input[name="due_at"]');

    // Render the stored UTC instant as the administrator's browser-local time.
    try {
        const stored = new Date(localInput.dataset.utc);
        if (!Number.isNaN(stored.getTime())) {
            const localValue = new Date(
                stored.getTime() - stored.getTimezoneOffset() * 60000
            ).toISOString().slice(0, 16);
            localInput.value = localValue;
        }
    } catch (_) {}

    form.addEventListener('submit', event => {
        const selected = new Date(localInput.value);
        if (!localInput.value || Number.isNaN(selected.getTime())) {
            event.preventDefault();
            alert('Choose a valid callback date and time.');
            return;
        }
        hiddenInput.value = selected.toISOString();
    });
});
</script>

<%- include('../partials/foot') %>
