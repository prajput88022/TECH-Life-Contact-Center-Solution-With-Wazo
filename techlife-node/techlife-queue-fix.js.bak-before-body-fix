require('dotenv').config({ quiet: true });

const { pool } = require('./src/db');
const config = require('./config/config');
const { wazoFetch } = require('./src/wazoFetch');

async function main() {
    const r = await pool.query(`
        SELECT q.wazo_queue_id, t.wazo_tenant_uuid,
               ag.wazo_agent_id, ag.agent_number
        FROM queues q
        JOIN tenants t ON t.id=q.tenant_id
        JOIN queue_agents qa ON qa.queue_id=q.id
        JOIN agents ag ON ag.id=qa.agent_id
                     AND ag.tenant_id=q.tenant_id
        WHERE q.id=$1 AND q.tenant_id=$2
          AND q.is_active AND qa.is_active AND ag.is_active
          AND ag.provisioning_status='provisioned'
          AND ag.wazo_agent_id IS NOT NULL
    `, [
        '1301e3be-cccf-4ae9-ad11-536687f0f686',
        '00000000-0000-0000-0000-000000000001'
    ]);

    if (!r.rowCount) throw Error('No eligible queue agents found.');

    const { wazo_queue_id: qid, wazo_tenant_uuid: tenant } = r.rows[0];

    const auth = await wazoFetch(
        config.wazo.authUrl.replace(/\/$/, '') + '/token',
        {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                Authorization: 'Basic ' + Buffer.from(
                    config.wazo.authUsername + ':' +
                    config.wazo.authPassword
                ).toString('base64')
            },
            body: JSON.stringify({
                backend: 'wazo_user',
                expiration: 300
            })
        }
    );

    const authData = await auth.json();
    const token = authData?.data?.token;
    if (!auth.ok || !token) throw Error('Wazo authentication failed.');

    const base = config.wazo.confdUrl.replace(/\/$/, '');

    async function api(method, path) {
        const response = await wazoFetch(base + path, {
            method,
            headers: {
                'X-Auth-Token': token,
                'Wazo-Tenant': tenant
            }
        });
        const raw = await response.text();
        let data = {};
        try { data = raw ? JSON.parse(raw) : {}; } catch (_) {}

        if (!response.ok) {
            throw Error(method + ' ' + path + ' HTTP ' +
                response.status + ': ' + raw.slice(0, 250));
        }

        return data?.data?.data || data?.data || data;
    }

    const queueId = Number(qid);
    const queue = await api('GET', '/queues/' + queueId);

    if (Number(queue.id) !== queueId ||
        String(queue.tenant_uuid) !== String(tenant)) {
        throw Error('Queue tenant verification failed.');
    }

    for (const agent of r.rows) {
        const agentId = Number(agent.wazo_agent_id);
        const current = Array.isArray(queue.members?.agents)
            ? queue.members.agents : [];

        const exists = current.some(x =>
            Number(typeof x === 'object' ? x.id : x) === agentId
        );

        if (!exists) {
            console.log('Adding agent ' + agent.agent_number +
                ' (Wazo ID ' + agentId + ')');

            await api(
                'PUT',
                '/queues/' + queueId +
                '/members/agents/' + agentId
            );
        } else {
            console.log('Already associated: agent ' + agent.agent_number);
        }
    }

    const verified = await api('GET', '/queues/' + queueId);
    const actual = Array.isArray(verified.members?.agents)
        ? verified.members.agents : [];

    for (const agent of r.rows) {
        const found = actual.some(x =>
            Number(typeof x === 'object' ? x.id : x) ===
            Number(agent.wazo_agent_id)
        );
        console.log((found ? 'PASS: ' : 'FAIL: ') +
            'agent ' + agent.agent_number);
        if (!found) throw Error('Queue membership verification failed.');
    }

    console.log('PASS: Wazo queue association verified.');
}

main()
    .catch(e => {
        console.error('FAILED:', e.message);
        process.exitCode = 1;
    })
    .finally(() => pool.end().catch(() => {}));
