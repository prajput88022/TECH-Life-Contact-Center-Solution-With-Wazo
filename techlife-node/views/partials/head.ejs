<!DOCTYPE html>
<%
const appearance = (typeof tenantAppearance !== 'undefined' && tenantAppearance)
    ? tenantAppearance : {};
const allowedThemes = ['blue', 'purple', 'green', 'yellow', 'light', 'dark'];
const activeTheme = allowedThemes.includes(appearance.theme) ? appearance.theme : 'blue';
const safeAccent = typeof appearance.primary_color === 'string' &&
    /^#[0-9a-fA-F]{6}$/.test(appearance.primary_color)
    ? appearance.primary_color : null;
const customAccentVars = safeAccent
    ? `--acc:${safeAccent};--acc2:${appearance.accent_light || safeAccent};--acc3:${appearance.accent_dark || safeAccent};--acc-rgb:${appearance.accent_rgb || '59,130,246'};`
    : '';
%>
<html lang="en" data-tenant-theme="<%= activeTheme %>"<% if (customAccentVars) { %> style="<%= customAccentVars %>"<% } %>>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= pageTitle || 'TECH-Life Contact-Center Solution' %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons+Round">
<link rel="stylesheet" href="/assets/style.css">
</head>
<body>
<div class="tl-shell">
