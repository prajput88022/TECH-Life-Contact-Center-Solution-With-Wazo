<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<h1>DID Numbers</h1>

<form method="post" action="/admin/dids/create" class="tl-card">
  <div class="tl-filters">
    <div><label>DID Number</label><input name="did_number" required></div>
    <div><label>Description</label><input name="description"></div>
    <div><label>Destination Type</label>
      <select name="destination_type" class="did-destination" required>
        <option value="queue">Queue</option><option value="ivr">IVR</option>
        <option value="agent">Agent</option><option value="extension">Extension / DID</option>
      </select>
    </div>
    <div class="did-target" data-type="queue"><label>Queue</label>
      <select name="default_queue_id"><option value="">— Select queue —</option>
        <% queues.forEach(q => { %><option value="<%= q.id %>"><%= q.name %></option><% }) %>
      </select>
    </div>
    <div class="did-target" data-type="ivr" hidden><label>IVR Menu</label>
      <select name="default_ivr_id"><option value="">— Select IVR —</option>
        <% ivrs.forEach(i => { %><option value="<%= i.id %>"><%= i.name %></option><% }) %>
      </select>
    </div>
    <div class="did-target" data-type="agent" hidden><label>Agent</label>
      <select name="default_agent_id"><option value="">— Select agent —</option>
        <% agents.forEach(a => { %><option value="<%= a.id %>"><%= a.extension %> (<%= a.agent_number || 'Agent' %>)</option><% }) %>
      </select>
    </div>
    <div class="did-target" data-type="extension" hidden><label>Extension / DID</label>
      <select name="default_extension"><option value="">— Select extension —</option>
        <% extensions.forEach(x => { %><option value="<%= x.value %>"><%= x.label %></option><% }) %>
      </select>
    </div>
    <div><label>Campaign (optional)</label>
      <select name="campaign_id"><option value="">—</option>
        <% campaigns.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
      </select>
    </div>
  </div>
  <button class="tl-btn" type="submit">Add DID</button>
</form>

<h2>All DIDs</h2>
<table>
<tr><th>DID</th><th>Description</th><th>Destination</th><th>Campaign</th><th>Status</th><th></th></tr>
<% dids.forEach(d => { 
  const dest = d.destination_type === 'ivr' ? ('IVR: ' + (d.ivr_name || '—'))
    : d.destination_type === 'agent' ? ('Agent: ' + (d.agent_extension || '—'))
    : d.destination_type === 'extension' ? ('Extension: ' + (d.default_extension || '—'))
    : ('Queue: ' + (d.queue_name || '—'));
%>
<tr>
  <td><%= d.did_number %></td><td><%= d.description || '' %></td>
  <td><%= dest %></td><td><%= d.campaign_name || '—' %></td>
  <td><%= d.is_active ? 'Active' : 'Disabled' %></td>
  <td><a href="?edit=<%= d.id %>">Edit</a> &middot;
    <form method="post" action="/admin/dids/<%= d.id %>/delete" style="display:inline" onsubmit="return confirm('Delete this DID?');">
      <button type="submit" style="background:none;border:none;color:var(--tl-bad);cursor:pointer;text-decoration:underline;padding:0">Delete</button>
    </form>
  </td>
</tr>
<% }) %>
<% if (!dids.length) { %><tr><td colspan="6">No DIDs yet.</td></tr><% } %>
</table>

<% if (editId) { const d = dids.find(x => x.id === editId); if (d) {
  const type = d.destination_type || 'queue';
%>
<h2>Edit DID — <%= d.did_number %></h2>
<form method="post" action="/admin/dids/<%= d.id %>/edit" class="tl-card">
  <div class="tl-filters">
    <div><label>Description</label><input name="description" value="<%= d.description || '' %>"></div>
    <div><label>Destination Type</label>
      <select name="destination_type" class="did-destination" required>
        <option value="queue" <%= type === 'queue' ? 'selected' : '' %>>Queue</option>
        <option value="ivr" <%= type === 'ivr' ? 'selected' : '' %>>IVR</option>
        <option value="agent" <%= type === 'agent' ? 'selected' : '' %>>Agent</option>
        <option value="extension" <%= type === 'extension' ? 'selected' : '' %>>Extension / DID</option>
      </select>
    </div>
    <div class="did-target" data-type="queue" <%= type !== 'queue' ? 'hidden' : '' %>><label>Queue</label>
      <select name="default_queue_id"><option value="">— Select queue —</option>
        <% queues.forEach(q => { %><option value="<%= q.id %>" <%= d.default_queue_id === q.id ? 'selected' : '' %>><%= q.name %></option><% }) %>
      </select>
    </div>
    <div class="did-target" data-type="ivr" <%= type !== 'ivr' ? 'hidden' : '' %>><label>IVR Menu</label>
      <select name="default_ivr_id"><option value="">— Select IVR —</option>
        <% ivrs.forEach(i => { %><option value="<%= i.id %>" <%= d.default_ivr_id === i.id ? 'selected' : '' %>><%= i.name %></option><% }) %>
      </select>
    </div>
    <div class="did-target" data-type="agent" <%= type !== 'agent' ? 'hidden' : '' %>><label>Agent</label>
      <select name="default_agent_id"><option value="">— Select agent —</option>
        <% agents.forEach(a => { %><option value="<%= a.id %>" <%= d.default_agent_id === a.id ? 'selected' : '' %>><%= a.extension %> (<%= a.agent_number || 'Agent' %>)</option><% }) %>
      </select>
    </div>
    <div class="did-target" data-type="extension" <%= type !== 'extension' ? 'hidden' : '' %>><label>Extension / DID</label>
      <select name="default_extension"><option value="">— Select extension —</option>
        <% extensions.forEach(x => { %><option value="<%= x.value %>" <%= d.default_extension === x.value ? 'selected' : '' %>><%= x.label %></option><% }) %>
      </select>
    </div>
    <div><label>Campaign (optional)</label>
      <select name="campaign_id"><option value="">—</option>
        <% campaigns.forEach(c => { %><option value="<%= c.id %>" <%= d.campaign_id === c.id ? 'selected' : '' %>><%= c.name %></option><% }) %>
      </select>
    </div>
    <div><label>Status</label>
      <select name="is_active"><option value="1" <%= d.is_active ? 'selected' : '' %>>Active</option>
        <option value="0" <%= !d.is_active ? 'selected' : '' %>>Disabled</option>
      </select>
    </div>
  </div>
  <button class="tl-btn" type="submit">Save Changes</button>
  <a class="tl-btn secondary" href="/admin/dids">Cancel</a>
</form>
<% } } %>

<script>
document.querySelectorAll('form').forEach(form => {
  const typeSelect = form.querySelector('.did-destination');
  if (!typeSelect) return;
  function updateTargets() {
    form.querySelectorAll('.did-target').forEach(box => {
      const active = box.dataset.type === typeSelect.value;
      box.hidden = !active;
      const select = box.querySelector('select');
      if (select) {
        select.required = active;
        select.disabled = !active;
      }
    });
  }
  typeSelect.addEventListener('change', updateTargets);
  updateTargets();
});
</script>
<%- include('../partials/foot') %>
