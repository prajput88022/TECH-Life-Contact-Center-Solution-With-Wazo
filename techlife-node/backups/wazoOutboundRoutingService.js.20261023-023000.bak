'use strict';

const { pool } = require('./db');
const { wazoFetch } = require('./wazoFetch');
const config = require('../config/config');

async function getToken() {
  const response = await wazoFetch(
    `${config.wazo.authUrl.replace(/\/$/, '')}/token`,
    {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization:
          'Basic ' +
          Buffer.from(
            `${config.wazo.authUsername}:${config.wazo.authPassword}`
          ).toString('base64'),
      },
      body: JSON.stringify({ backend: 'wazo_user', expiration: 300 }),
    }
  );

  const payload = await response.json().catch(() => ({}));
  if (!response.ok || !payload?.data?.token) {
    throw new Error(`Wazo authentication failed (HTTP ${response.status})`);
  }
  return payload.data.token;
}

async function confd(method, path, token, tenantUuid, body) {
  const response = await wazoFetch(
    `${config.wazo.confdUrl.replace(/\/$/, '')}${path}`,
    {
      method,
      headers: {
        'X-Auth-Token': token,
        'Wazo-Tenant': tenantUuid,
        'Content-Type': 'application/json',
      },
      body: body === undefined ? undefined : JSON.stringify(body),
    }
  );

  const raw = await response.text().catch(() => '');
  let payload = {};
  try {
    payload = raw ? JSON.parse(raw) : {};
  } catch (_) {}

  if (!response.ok) {
    throw new Error(
      `Wazo ${method} ${path} failed (HTTP ${response.status}): ` +
      String(payload?.message || payload?.error || raw || 'no response body')
        .slice(0, 350)
    );
  }

  return payload?.data?.data || payload?.data || payload;
}

async function provisionPrefixOutboundRoute(prefixId, appTenantId) {
  /*
   * Do not guess at the database schema or select a route belonging to
   * another tenant. Require an explicitly stored Wazo outcall ID if present.
   */
  const result = await pool.query(
    `SELECT p.id AS prefix_id,
            p.prefix_digits,
            p.strip_digits,
            p.prepend_digits,
            p.route_name,
            p.is_active,
            p.trunk_id,
            tr.name AS trunk_name,
            tr.is_active AS trunk_active,
            tr.provisioning_status AS trunk_status,
            tr.wazo_trunk_id,
            tr.wazo_outcall_id,
            t.wazo_tenant_uuid
       FROM prefixes p
       JOIN trunks tr
         ON tr.id = p.trunk_id AND tr.tenant_id = p.tenant_id
       JOIN tenants t ON t.id = p.tenant_id
      WHERE p.id = $1 AND p.tenant_id = $2`,
    [prefixId, appTenantId]
  );

  if (!result.rows.length) throw new Error('Prefix or its trunk was not found for this tenant');

  const row = result.rows[0];
  if (!row.is_active) throw new Error('Prefix must be active before outbound provisioning');
  if (row.trunk_active !== true || row.trunk_status !== 'provisioned') {
    throw new Error('The selected trunk must be active and provisioned');
  }
  if (!row.wazo_tenant_uuid || !row.wazo_trunk_id) {
    throw new Error('Wazo tenant or trunk ID is missing');
  }

  /*
   * Reuse an already stored outcall ID. If there is no ID, stop rather than
   * create an untracked live route: this schema stores the ID on the trunk,
   * which cannot safely represent multiple independent prefixes on one trunk.
   */
  if (!row.wazo_outcall_id) {
    throw new Error(
      'No Wazo outcall ID is stored. Create the route and store its ID using a prefix-specific mapping before activation.'
    );
  }

  const token = await getToken();
  const outcallId = Number(row.wazo_outcall_id);
  const trunkId = Number(row.wazo_trunk_id);

  // Verify that the stored route exists in this tenant before updating it.
  await confd('GET', `/outcalls/${outcallId}`, token, row.wazo_tenant_uuid);

  // Associate the existing Wazo trunk with the route.
  await confd(
    'PUT',
    `/outcalls/${outcallId}/trunks`,
    token,
    row.wazo_tenant_uuid,
    { trunks: [{ id: trunkId }] }
  );

  // Associate only provisioned/manual TechLife agent extensions.
  const agents = await pool.query(
    `SELECT wazo_extension_id
       FROM agents
      WHERE tenant_id = $1
        AND wazo_extension_id IS NOT NULL
      ORDER BY extension`,
    [appTenantId]
  );

  if (!agents.rows.length) {
    throw new Error('No TechLife agent extensions have a Wazo extension ID');
  }

  for (const agent of agents.rows) {
    const extensionId = Number(agent.wazo_extension_id);
    if (!Number.isInteger(extensionId) || extensionId < 1) continue;

    await confd(
      'PUT',
      `/outcalls/${outcallId}/extensions/${extensionId}`,
      token,
      row.wazo_tenant_uuid,
      {
        prefix: row.prefix_digits,
        strip_digits: Number(row.strip_digits || 0),
        ...(row.prepend_digits
          ? { external_prefix: row.prepend_digits }
          : {}),
      }
    );
  }

  return {
    ok: true,
    prefix_id: row.prefix_id,
    outcall_id: outcallId,
    trunk_id: trunkId,
    associated_extensions: agents.rows.length,
  };
}

module.exports = { provisionPrefixOutboundRoute };
