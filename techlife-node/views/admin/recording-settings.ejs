<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<%
const cfg = settings.provider_config || {};
const provider = settings.storage_provider || 'local';
const providers = [
    ['local','Local filesystem'],
    ['s3','Amazon S3'],
    ['s3compatible','S3-compatible storage'],
    ['azure','Azure Blob Storage'],
    ['gcs','Google Cloud Storage'],
    ['ftp','FTP / FTPS'],
    ['sftp','SFTP']
];
const tenantContext =
    (typeof asTenant !== 'undefined' && asTenant) ? asTenant : '';
const sftpTestState =
    (typeof sftpTest !== 'undefined' && sftpTest) ? sftpTest : '';
const remoteSyncState =
    (typeof remoteSync !== 'undefined' && remoteSync) ? remoteSync : '';
const savedState =
    (typeof saved !== 'undefined' && saved) ? saved : false;

const tenantQuery = tenantContext
    ? '&as_tenant=' + encodeURIComponent(tenantContext)
    : '';
%>

<style>
.rs-page{max-width:1250px;margin:0 auto;padding:10px 0 35px}
.rs-head{display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap;margin:8px 0 22px}
.rs-head h1{font-size:25px;font-weight:800}
.rs-sub{color:var(--t1);font-size:12px;margin-top:5px}
.rs-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:15px}
.rs-card{background:var(--c2);border:1px solid var(--bd);border-radius:var(--r12);padding:18px;min-width:0}
.rs-card.full{grid-column:1/-1}
.rs-card h2{font-size:14px;font-weight:800;margin-bottom:5px}
.rs-description{font-size:11px;color:var(--t2);margin-bottom:16px;line-height:1.55}
.rs-fields{display:grid;grid-template-columns:1fr 1fr;gap:13px}
.rs-field{min-width:0}
.rs-field.full{grid-column:1/-1}
.rs-field label{display:block;font-size:11px;font-weight:700;margin-bottom:6px}
.rs-field input,.rs-field select,.rs-field textarea{width:100%;min-width:0;min-height:38px}
.rs-field textarea{min-height:100px;padding:10px;font-family:var(--fm);font-size:11px}
.rs-field small{display:block;color:var(--t2);font-size:10px;line-height:1.5;margin-top:5px}
.rs-check{display:flex;gap:9px;align-items:flex-start;font-size:11px;margin:11px 0}
.rs-check input{margin-top:2px}
.rs-note{padding:12px 14px;border:1px solid var(--bd);border-radius:9px;color:var(--t1);font-size:11px;line-height:1.6;margin:12px 0}
.rs-status{padding:12px 14px;border-radius:9px;border:1px solid var(--bd);margin-bottom:15px;font-size:12px}
.rs-status strong{display:block;margin-bottom:3px}
.rs-provider[hidden]{display:none!important}
.rs-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:17px}
.rs-pill{display:inline-block;border:1px solid var(--bd);border-radius:30px;padding:4px 10px;font-size:10px;color:var(--t1)}
.rs-warning{border-color:rgba(234,179,8,.35);background:rgba(234,179,8,.06)}
@media(max-width:760px){.rs-grid{grid-template-columns:1fr}.rs-card.full{grid-column:1}.rs-fields{grid-template-columns:1fr}.rs-field.full{grid-column:1}}
</style>

<div class="rs-page">
    <header class="rs-head">
        <div>
            <div class="q-eyebrow">Call Center / Administration</div>
            <h1>Recording Settings</h1>
            <p class="rs-sub">Tenant-specific call recording policy, local storage and remote destination configuration.</p>
        </div>
        <span class="rs-pill">Tenant isolated configuration</span>
    </header>

    <% if (remoteSyncState === 'enabled') { %>
        <div class="rs-status">
            <strong>Remote synchronization enabled.</strong>
            The SFTP worker will process this tenant's eligible queue according to its saved schedule.
        </div>
    <% } else if (remoteSyncState === 'paused') { %>
        <div class="rs-status">
            <strong>Remote synchronization paused.</strong>
            Local recordings and queued jobs are retained.
        </div>
    <% } else if (remoteSyncState === 'test-required' || remoteSyncState === 'test-expired') { %>
        <div class="rs-status rs-warning">
            <strong>SFTP test required.</strong>
            Test the saved SFTP connection again. A successful test no older than seven days is required before enabling uploads.
        </div>
    <% } else if (remoteSyncState === 'sftp-only') { %>
        <div class="rs-status rs-warning">
            <strong>SFTP adapter required.</strong>
            Remote synchronization is currently available only for SFTP. Other provider settings cannot be activated yet.
        </div>
    <% } else if (remoteSyncState === 'not-configured') { %>
        <div class="rs-status rs-warning">
            <strong>Recording settings not found for this tenant.</strong>
            Save the tenant's settings first.
        </div>
    <% } %>

    <% if (sftpTestState === 'success') { %>
        <div class="rs-status">
            <strong>SFTP connection verified.</strong>
            The pinned host key matched and the saved remote directory was listed successfully.
            No remote files were changed.
        </div>
    <% } else if (sftpTestState === 'failed') { %>
        <div class="rs-status rs-warning">
            <strong>SFTP connection test failed.</strong>
            Review the saved host, directory, credentials and SHA256 fingerprint. The error is recorded in this tenant's settings.
        </div>
    <% } else if (sftpTestState === 'provider-not-sftp') { %>
        <div class="rs-status rs-warning">
            <strong>Storage provider is not SFTP.</strong>
            Select and save SFTP before testing this connection.
        </div>
    <% } %>

    <% if (savedState) { %>
        <div class="rs-status">
            <strong>Settings saved successfully.</strong>
            Provider credentials are encrypted at rest. Remote transfers and Wazo recording-policy synchronization remain inactive until their workers and connection tests are enabled.
        </div>
    <% } %>

    <form method="post" action="/admin/recording-settings<%= tenantContext ? '?as_tenant=' + encodeURIComponent(tenantContext) : '' %>">
        <div class="rs-grid">

            <section class="rs-card full">
                <h2>1. Automatic call recording policy</h2>
                <p class="rs-description">Configure which calls should be recorded for agents belonging to this tenant. The default is disabled.</p>

                <label class="rs-check">
                    <input type="checkbox" name="recording_enabled" value="1"
                        <%= settings.recording_enabled ? 'checked' : '' %>>
                    <span><strong>Enable automatic recording for this tenant</strong><br>Recording policy will be synchronized to mapped Wazo users after the policy worker is enabled.</span>
                </label>

                <div class="rs-fields">
                    <label class="rs-check">
                        <input type="checkbox" name="record_incoming_external" value="1"
                            <%= settings.record_incoming_external ? 'checked' : '' %>>
                        <span>Incoming external calls</span>
                    </label>
                    <label class="rs-check">
                        <input type="checkbox" name="record_outgoing_external" value="1"
                            <%= settings.record_outgoing_external ? 'checked' : '' %>>
                        <span>Outgoing external calls</span>
                    </label>
                    <label class="rs-check">
                        <input type="checkbox" name="record_incoming_internal" value="1"
                            <%= settings.record_incoming_internal ? 'checked' : '' %>>
                        <span>Incoming internal calls</span>
                    </label>
                    <label class="rs-check">
                        <input type="checkbox" name="record_outgoing_internal" value="1"
                            <%= settings.record_outgoing_internal ? 'checked' : '' %>>
                        <span>Outgoing internal calls</span>
                    </label>
                </div>
                <div class="rs-note">
                    Recording must comply with applicable call-recording notice, consent and retention requirements. Saving this policy does not yet change Wazo users.
                    Policy status: <strong><%= settings.recording_policy_sync_status || 'pending' %></strong>
                </div>
            </section>

            <section class="rs-card">
                <h2>2. Storage destination</h2>
                <p class="rs-description">Choose where this tenant's recordings should be stored remotely.</p>
                <div class="rs-fields">
                    <div class="rs-field full">
                        <label for="storage-provider">Provider</label>
                        <select id="storage-provider" name="storage_provider">
                            <% providers.forEach(p => { %>
                                <option value="<%= p[0] %>" <%= provider === p[0] ? 'selected' : '' %>><%= p[1] %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="rs-field full">
                        <label for="destination-name">Bucket / Container</label>
                        <input id="destination-name" name="destination_name" maxlength="255"
                            value="<%= settings.destination_name || '' %>"
                            placeholder="Bucket or container name">
                    </div>
                    <div class="rs-field">
                        <label for="region">Region</label>
                        <input id="region" name="region" maxlength="120"
                            value="<%= settings.region || '' %>" placeholder="e.g. ap-south-1">
                    </div>
                    <div class="rs-field">
                        <label for="destination-prefix">Remote prefix</label>
                        <input id="destination-prefix" name="destination_prefix"
                            value="<%= settings.destination_prefix || 'recordings' %>" required>
                    </div>
                    <div class="rs-field full">
                        <label for="endpoint-url">Custom endpoint URL</label>
                        <input id="endpoint-url" name="endpoint_url"
                            value="<%= settings.endpoint_url || '' %>"
                            placeholder="https://storage.example.com">
                        <small>Required for many S3-compatible services; optional for standard AWS S3 and Azure.</small>
                    </div>
                </div>
            </section>

            <section class="rs-card">
                <h2>3. Provider connection details</h2>
                <p class="rs-description">Enter only the fields applicable to the selected provider. Saved passwords and keys are never shown again.</p>

                <div class="rs-fields">
                    <div class="rs-field rs-provider" data-providers="ftp sftp">
                        <label>Host / Server</label>
                        <input name="provider_host" value="<%= cfg.host || '' %>" placeholder="storage.example.com">
                    </div>
                    <div class="rs-field rs-provider" data-providers="ftp sftp">
                        <label>Port</label>
                        <input type="number" name="provider_port" min="1" max="65535"
                            value="<%= cfg.port || (provider === 'sftp' ? 22 : 21) %>">
                    </div>
                    <div class="rs-field rs-provider" data-providers="ftp sftp">
                        <label>Username</label>
                        <input name="provider_username" value="<%= cfg.username || '' %>" autocomplete="off">
                    </div>
                    <div class="rs-field rs-provider" data-providers="ftp sftp">
                        <label>Remote directory</label>
                        <input name="provider_path" value="<%= cfg.remote_path || '' %>" placeholder="/recordings">
                    </div>
                    <div class="rs-field rs-provider" data-providers="ftp">
                        <label>FTP protocol</label>
                        <select name="ftp_protocol">
                            <option value="ftps" <%= (cfg.protocol || 'ftps') === 'ftps' ? 'selected' : '' %>>FTPS (TLS)</option>
                            <option value="ftp" <%= cfg.protocol === 'ftp' ? 'selected' : '' %>>FTP (unencrypted)</option>
                        </select>
                    </div>
                    <div class="rs-field rs-provider" data-providers="azure">
                        <label>Azure storage account</label>
                        <input name="azure_account_name" value="<%= cfg.account_name || '' %>">
                    </div>
                    <div class="rs-field rs-provider" data-providers="gcs">
                        <label>Google Cloud project ID</label>
                        <input name="gcs_project_id" value="<%= cfg.project_id || '' %>">
                    </div>
                    <div class="rs-field rs-provider" data-providers="sftp">
                        <label>SSH host-key SHA256 fingerprint</label>
                        <input name="host_key_sha256" value="<%= settings.host_key_sha256 || '' %>"
                            placeholder="SHA256:...">
                        <small>Required for a secure SFTP connection test.</small>
                    </div>
                    <div class="rs-field rs-provider full" data-providers="ftp">
                        <label class="rs-check">
                            <input type="checkbox" name="ftp_passive" value="1" <%= cfg.passive_mode !== false ? 'checked' : '' %>>
                            <span>Use passive FTP mode</span>
                        </label>
                    </div>

                    <div class="rs-field rs-provider" data-providers="s3 s3compatible">
                        <label>Access key ID</label>
                        <input name="access_key_id" autocomplete="off" placeholder="Leave blank to keep saved key">
                    </div>
                    <div class="rs-field rs-provider" data-providers="s3 s3compatible">
                        <label>Secret access key</label>
                        <input type="password" name="secret_access_key" autocomplete="new-password" placeholder="Leave blank to keep saved secret">
                    </div>
                    <div class="rs-field rs-provider" data-providers="azure">
                        <label>Azure account key</label>
                        <input type="password" name="azure_account_key" autocomplete="new-password" placeholder="Leave blank to keep saved key">
                    </div>
                    <div class="rs-field rs-provider full" data-providers="azure">
                        <label>Or Azure connection string</label>
                        <textarea name="azure_connection_string" autocomplete="off" placeholder="Leave blank to keep saved connection string"></textarea>
                    </div>
                    <div class="rs-field rs-provider full" data-providers="gcs">
                        <label>Google service-account JSON</label>
                        <textarea name="gcs_service_account_json" autocomplete="off" placeholder="Paste service-account JSON; leave blank to keep saved credentials"></textarea>
                    </div>
                    <div class="rs-field rs-provider" data-providers="ftp">
                        <label>FTP password</label>
                        <input type="password" name="ftp_password" autocomplete="new-password" placeholder="Leave blank to keep saved password">
                    </div>
                    <div class="rs-field rs-provider" data-providers="sftp">
                        <label>SFTP password (optional)</label>
                        <input type="password" name="sftp_password" autocomplete="new-password" placeholder="Leave blank to keep saved password">
                    </div>
                    <div class="rs-field rs-provider full" data-providers="sftp">
                        <label>SFTP private key (optional)</label>
                        <textarea name="sftp_private_key" autocomplete="off" placeholder="Paste private key only when using key authentication"></textarea>
                    </div>
                    <div class="rs-field rs-provider full" data-providers="sftp">
                        <label>Private-key passphrase (optional)</label>
                        <input type="password" name="sftp_passphrase" autocomplete="new-password">
                    </div>
                </div>

                <div class="rs-note">
                    Credentials configured for this provider:
                    <strong><%= settings.credentials_configured ? 'Yes — encrypted' : 'Not yet configured' %></strong>
                </div>
                <label class="rs-check">
                    <input type="checkbox" name="clear_provider_credentials" value="1">
                    <span>Clear saved credentials for this provider</span>
                </label>
            </section>

            <section class="rs-card">
                <h2>4. Local recording storage</h2>
                <p class="rs-description">The local copy remains enabled to protect recordings if a remote service is unavailable.</p>
                <div class="rs-fields">
                    <div class="rs-field full">
                        <label>Local recording directory</label>
                        <input name="local_base_path" required value="<%= settings.local_base_path || '/var/lib/techlife/recordings' %>">
                    </div>
                    <div class="rs-field full">
                        <label>Folder template</label>
                        <input name="folder_template" required value="<%= settings.folder_template || '{yyyy}/{mm}/{dd}' %>">
                    </div>
                    <div class="rs-field full">
                        <label>Filename template</label>
                        <input name="filename_template" required value="<%= settings.filename_template || '{timestamp}_{call_id}_{recording_id}' %>">
                        <small>The template must include {recording_id}.</small>
                    </div>
                    <div class="rs-field">
                        <label>Audio format</label>
                        <select name="audio_format">
                            <% ['wav','mp3','ogg','flac'].forEach(f => { %>
                                <option value="<%= f %>" <%= settings.audio_format === f ? 'selected' : '' %>><%= f.toUpperCase() %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="rs-field">
                        <label>MP3 bitrate (kbps)</label>
                        <select name="mp3_bitrate_kbps">
                            <% [64,96,128,160,192,256,320].forEach(n => { %>
                                <option value="<%= n %>" <%= Number(settings.mp3_bitrate_kbps) === n ? 'selected' : '' %>><%= n %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="rs-field full">
                        <label>Retention days (blank = no automatic retention limit)</label>
                        <input type="number" min="1" max="36500" name="retention_days" value="<%= settings.retention_days || '' %>">
                    </div>
                </div>
                <p class="rs-note">Local copies are always retained by this configuration. The demo-recordings directory is excluded from production ingestion.</p>
            </section>

            <section class="rs-card">
                <h2>5. Upload schedule</h2>
                <p class="rs-description">Preferences for the scheduled transfer worker.</p>
                <div class="rs-fields">
                    <div class="rs-field">
                        <label>Upload interval (minutes)</label>
                        <input type="number" min="1" max="1440" name="upload_interval_minutes"
                            value="<%= settings.upload_interval_minutes || 5 %>" required>
                    </div>
                    <div class="rs-field">
                        <label>Batch size</label>
                        <input type="number" min="1" max="100" name="upload_batch_size"
                            value="<%= settings.upload_batch_size || 20 %>" required>
                    </div>
                </div>
                <label class="rs-check">
                    <input type="checkbox" name="auto_upload_existing" value="1"
                        <%= settings.auto_upload_existing !== false ? 'checked' : '' %>>
                    <span>Include eligible historical recordings in scheduled synchronization</span>
                </label>
                <label class="rs-check">
                    <input type="checkbox" name="download_enabled" value="1"
                        <%= settings.download_enabled ? 'checked' : '' %>>
                    <span>Allow authorized users to download local recordings</span>
                </label>
                <div class="rs-note rs-warning">
                    <strong>Remote upload is currently OFF.</strong>
                    Saving these preferences does not start transfers. Provider connection testing, the recording-ingestion service and the scheduled transfer worker must be installed and verified first.
                </div>
            </section>

            <section class="rs-card full">
                <h2>6. Automatic recording ingestion</h2>
                <p class="rs-description">
                    Control how often TECH-Life scans this tenant's Wazo CDRs and imports new recording audio.
                    Schedule timezone: <strong><%= tenantTimezone || 'UTC' %></strong>.
                </p>

                <label class="rs-check">
                    <input type="checkbox" name="recording_ingestion_enabled" value="1"
                        <%= settings.recording_ingestion_enabled ? 'checked' : '' %>>
                    <span><strong>Enable automatic recording ingestion</strong><br>
                    TECH-Life will scan Wazo and save eligible recordings to this tenant's local recording directory.</span>
                </label>

                <div class="rs-fields">
                    <div class="rs-field">
                        <label>Scan interval (minutes)</label>
                        <input type="number" name="recording_ingestion_interval_minutes"
                            min="1" max="1440"
                            value="<%= settings.recording_ingestion_interval_minutes || 5 %>" required>
                        <small>Allowed range: 1–1440 minutes.</small>
                    </div>
                    <div class="rs-field">
                        <label>Initial historical lookback (days)</label>
                        <input type="number" name="recording_ingestion_history_days"
                            min="1" max="3650"
                            value="<%= settings.recording_ingestion_history_days || 7 %>" required>
                        <small>Used on the first scan. Later scans use a short overlap to catch late CDRs.</small>
                    </div>
                    <div class="rs-field">
                        <label>Ingestion status</label>
                        <div class="rs-pill"><%= settings.recording_ingestion_status || 'paused' %></div>
                    </div>
                    <div class="rs-field">
                        <label>Last ingestion scan</label>
                        <div><%= settings.recording_ingestion_last_scan_at || 'Not started' %></div>
                    </div>
                    <div class="rs-field full">
                        <label>Last ingestion error</label>
                        <div><%= settings.recording_ingestion_last_error || 'None' %></div>
                    </div>
                </div>
                <div class="rs-note">
                    Pausing ingestion does not delete existing recordings or change the Wazo recording policy.
                    Recording policy and ingestion scheduling are independent controls.
                </div>
            </section>

            <section class="rs-card full">
                <h2>7. Remote synchronization schedule</h2>
                <p class="rs-description">
                    Choose an interval or a daily run time for this tenant's future remote-storage synchronization.
                    Daily time uses the tenant timezone shown above.
                </p>
                <div class="rs-fields">
                    <div class="rs-field">
                        <label>Schedule type</label>
                        <select name="upload_schedule_mode">
                            <option value="interval" <%= (settings.upload_schedule_mode || 'interval') === 'interval' ? 'selected' : '' %>>Repeat by interval</option>
                            <option value="daily" <%= settings.upload_schedule_mode === 'daily' ? 'selected' : '' %>>Once per day</option>
                        </select>
                    </div>
                    <div class="rs-field">
                        <label>Daily run time (tenant local time)</label>
                        <input type="time" name="upload_schedule_time"
                            value="<%= String(settings.upload_schedule_time || '02:00').slice(0,5) %>">
                    </div>
                </div>
                <div class="rs-note rs-warning">
                    Schedule preferences are saved, but remote synchronization remains OFF until a provider connection
                    is tested and the secure upload worker is installed and enabled.
                </div>
            </section>

            <section class="rs-card full">
                <h2>8. Synchronization status</h2>
                <div class="rs-fields">
                    <div class="rs-field">
                        <label>Remote upload</label>
                        <div class="rs-pill"><%= settings.remote_upload_enabled ? 'Enabled' : 'Disabled' %></div>
                    </div>
                    <div class="rs-field">
                        <label>Last connection test</label>
                        <div><%= settings.connection_tested_at || 'Not tested' %></div>
                    </div>
                    <div class="rs-field">
                        <label>Last upload scan</label>
                        <div><%= settings.last_upload_scan_at || 'Not started' %></div>
                    </div>
                    <div class="rs-field">
                        <label>Recording policy synchronization</label>
                        <div><%= settings.recording_policy_sync_status || 'pending' %></div>
                    </div>
                </div>
            </section>
        </div>

        <div class="rs-actions">
            <button type="submit" class="tl-btn">Save Tenant Recording Settings</button>
            <% if (provider === 'sftp') { %>
                <button type="submit" class="tl-btn secondary"
                    formaction="/admin/recording-settings/test-sftp<%= tenantContext ? '?as_tenant=' + encodeURIComponent(tenantContext) : '' %>"
                    formmethod="post">
                    Test Saved SFTP Connection
                </button>
            <% } %>
            <a href="/admin/recording-settings<%= tenantContext ? '?as_tenant=' + encodeURIComponent(tenantContext) : '' %>" class="tl-btn secondary">Cancel</a>
        </div>
    </form>

    <section class="rs-card full" style="margin-top:16px">
        <h2>9. Remote synchronization controls</h2>
        <p class="rs-description">
            This control affects remote SFTP transfers only. Pausing it does not stop Wazo recording
            or local ingestion, and does not delete local files or queued jobs.
        </p>
        <div class="rs-fields">
            <div class="rs-field">
                <label>Current remote sync state</label>
                <div class="rs-pill">
                    <%= settings.remote_upload_enabled ? 'Enabled' : 'Paused' %>
                </div>
            </div>
            <div class="rs-field">
                <label>Provider connection test</label>
                <div class="rs-pill">
                    <%= settings.connection_tested_at && !settings.connection_test_error
                        ? 'Test passed — ' + settings.connection_tested_at
                        : 'Not verified' %>
                </div>
            </div>
            <div class="rs-field full">
                <label>Last remote transfer error</label>
                <div><%= settings.upload_last_error || 'None' %></div>
            </div>
        </div>
        <form method="post"
              action="/admin/recording-settings/remote-sync<%= tenantContext ? '?as_tenant=' + encodeURIComponent(tenantContext) : '' %>"
              class="rs-actions">
            <button type="submit" name="action" value="enable" class="tl-btn"
                <%= settings.remote_upload_enabled ? 'disabled' : '' %>>
                Enable Remote Sync
            </button>
            <button type="submit" name="action" value="pause" class="tl-btn secondary"
                <%= !settings.remote_upload_enabled ? 'disabled' : '' %>>
                Pause Remote Sync
            </button>
        </form>
        <p class="rs-note">
            Enabling requires a successful, recent SFTP connection test with the same saved host,
            credentials and host-key fingerprint. If historical synchronization is selected,
            eligible real local recordings are queued. Demo recordings are excluded.
        </p>
    </section>
</div>

<script>
(function () {
    const provider = document.getElementById('storage-provider');
    const fields = Array.from(document.querySelectorAll('.rs-provider'));

    function updateProviderFields() {
        const selected = provider.value;
        fields.forEach(field => {
            const allowed = (field.dataset.providers || '').split(/\s+/);
            field.hidden = !allowed.includes(selected);
        });

        const destination = document.getElementById('destination-name');
        if (destination) {
            destination.required = selected !== 'local';
        }
    }

    provider.addEventListener('change', updateProviderFields);
    updateProviderFields();
})();
</script>

<%- include('../partials/foot') %>
