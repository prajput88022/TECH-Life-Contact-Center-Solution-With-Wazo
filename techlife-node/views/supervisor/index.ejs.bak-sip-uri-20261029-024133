</div>

<div class="tl-grid" id="tiles"></div>

<h2>Active Calls</h2>
<table id="callsTable"><tr><th>Call</th><th>Agent</th><th>Queue</th><th>Campaign</th><th>Direction</th><th>Status</th><th>Since</th><th>Monitor</th></tr></table>

<h2>Agents</h2>
<table id="agentTable"><tr><th>Agent</th><th>Status</th><th>Queue</th><th>Skills</th><th>Since</th></tr></table>

<h2>Queues</h2>
<table id="queueTable"><tr><th>Queue</th><th>Calls Waiting</th><th>Longest Wait</th></tr></table>

<h2 id="callbacks">Callbacks</h2>
<p class="tl-subtitle">Scheduled callbacks for your assigned agents.</p>
<table>
    <tr><th>Phone</th><th>Agent</th><th>Due</th><th>Status</th><th>Notes</th><th>Action</th></tr>
    <% (callbacks || []).forEach(cb => { %>
    <tr>
        <td><%= cb.phone_number %></td><td><%= cb.agent_name %></td>
        <td><%= new Date(cb.due_at).toLocaleString() %></td><td><%= cb.status %></td><td><%= cb.notes || '' %></td>
