// ---- Outbound DNC preflight ----
router.post('/dnd/check', async (req, res) => {
    const u = req.session.user;
    const raw = typeof req.body?.phone_number === 'string'
        ? req.body.phone_number.trim()
        : '';

    if (!raw || !/^[+0-9().\-\s]+$/.test(raw)) {
        return res.status(400).json({ error: 'invalid_phone_number' });
    }

    const phone = raw.replace(/\D/g, '');
    if (!phone) {
        return res.status(400).json({ error: 'invalid_phone_number' });
    }

    const rawCampaignId = req.body?.campaign_id;
    let campaignId = null;

    if (rawCampaignId !== undefined &&
        rawCampaignId !== null &&
        rawCampaignId !== '') {
        if (typeof rawCampaignId !== 'string' ||
            !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(rawCampaignId)) {
            return res.status(400).json({ error: 'invalid_campaign_id' });
        }
        campaignId = rawCampaignId;
    }

    try {
        if (campaignId) {
            const campaign = await pool.query(
                `SELECT 1 FROM campaigns
                 WHERE tenant_id = $1 AND id = $2
                 LIMIT 1`,
                [u.tenantId, campaignId]
            );

            if (!campaign.rowCount) {
                return res.status(400).json({ error: 'invalid_campaign_id' });
            }
        }

        const result = await pool.query(
            `SELECT d.id
               FROM do_not_call_entries d
              WHERE d.tenant_id = $1
                AND regexp_replace(d.phone_number, '[^0-9]', '', 'g') = $2
                AND (
                    d.campaign_id IS NULL
                    OR ($3::uuid IS NOT NULL AND d.campaign_id = $3::uuid)
                )
              LIMIT 1`,
            [u.tenantId, phone, campaignId]
        );

        if (result.rowCount) {
            return res.status(403).json({
                allowed: false,
                error: 'do_not_call',
                message: 'This number is on the applicable Do Not Call list.'
            });
        }

        return res.json({ allowed: true });
    } catch (err) {
        console.error('DNC preflight failed:', err.message);
        return res.status(503).json({
            allowed: false,
            error: 'dnc_check_unavailable'
        });
    }
});

function dateRange(req) {
    const from = req.query.from || new Date().toISOString().slice(0, 10) + ' 00:00:00';
    const to = req.query.to || new Date().toISOString().slice(0, 10) + ' 23:59:59';
    return [from, to];
}

// ---- SIP credentials for the WebRTC workspace ----
router.get('/agents/:id/sip-credentials', async (req, res) => {
    res.set('Cache-Control', 'no-store');
    const u = req.session.user;
    let isSelf = u.agentId === req.params.id;
    if (!isSelf) {
        const ownProfile = await pool.query(
            `SELECT 1 FROM agents
              WHERE id = $1 AND tenant_id = $2 AND user_id = $3
              LIMIT 1`,
            [req.params.id, u.tenantId, u.id]
        );
        isSelf = ownProfile.rowCount > 0;
    }
    // Never expose another user's SIP credentials to a supervisor.
    if (!isSelf && !hasAdminAccess(u)) {
        return res.status(403).json({ error: 'forbidden' });
    }

    const result = await pool.query(
        `SELECT ag.extension, ag.sip_username, ag.sip_password, ag.provisioning_status,
                ag.wazo_line_id, t.wazo_tenant_uuid,
                COALESCE(NULLIF(t.sip_domain, ''), NULLIF($3, ''), NULLIF(ag.sip_domain, '')) AS sip_domain
         FROM agents ag JOIN tenants t ON t.id = ag.tenant_id
         WHERE ag.tenant_id = $1 AND ag.id = $2`,
        [u.tenantId, req.params.id, config.wazo.sipDomain]
    );
    const row = result.rows[0];
    if (!row) return res.status(404).json({ error: 'agent_not_found' });
    if (row.provisioning_status !== 'provisioned' && row.provisioning_status !== 'manual') {
        return res.status(409).json({ error: 'not_provisioned', status: row.provisioning_status });
    }
    // The Wazo line name is the configured AOR identity. It is
    // intentionally separate from the SIP digest-authentication username.
    let sipUriUser;
    try {
        if (!row.wazo_line_id || !row.wazo_tenant_uuid) {
            throw new Error('Agent Wazo line or tenant UUID is missing');
        }

        const authResponse = await wazoFetch(
            `${config.wazo.authUrl.replace(/\/$/, '')}/token`,
            {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    Authorization: 'Basic ' + Buffer.from(
                        `${config.wazo.authUsername}:${config.wazo.authPassword}`
                    ).toString('base64'),
                },
                body: JSON.stringify({ backend: 'wazo_user', expiration: 300 }),
            }
        );

        const authPayload = await authResponse.json().catch(() => ({}));
        const wazoToken = authPayload?.data?.token;
        if (!authResponse.ok || !wazoToken) {
            throw new Error(`Wazo authentication failed (HTTP ${authResponse.status})`);
        }

        const lineResponse = await wazoFetch(
            `${config.wazo.confdUrl.replace(/\/$/, '')}/lines/${encodeURIComponent(row.wazo_line_id)}`,
            {
                headers: {
                    'X-Auth-Token': wazoToken,
                    'Wazo-Tenant': row.wazo_tenant_uuid,
                    Accept: 'application/json',
                },
            }
        );

        const linePayload = await lineResponse.json().catch(() => ({}));
        if (!lineResponse.ok) {
            throw new Error(`Wazo line lookup failed (HTTP ${lineResponse.status})`);
        }

        const line = linePayload?.data?.data ?? linePayload?.data ?? linePayload;
        if (
            Number(line?.id) !== Number(row.wazo_line_id) ||
            String(line?.tenant_uuid || '').toLowerCase() !==
                String(row.wazo_tenant_uuid).toLowerCase()
        ) {
            throw new Error('Wazo line identity or tenant verification failed');
        }

        sipUriUser = String(line?.name || '').trim();
        if (!sipUriUser || /[\s@;]/.test(sipUriUser)) {
            throw new Error('Wazo line has no valid SIP URI identity');
        }
    } catch (err) {
        console.error(
            'Agent SIP line lookup failed:',
            String(err.message || err).slice(0, 250)
        );
        return res.status(503).json({ error: 'sip_configuration_unavailable' });
    }

    res.json({
        extension: row.extension,
        sip_username: row.sip_username,
        sip_uri_user: sipUriUser,
        sip_password: row.sip_password,
        sip_domain: row.sip_domain,
        ws_uri: config.wazo.sipWsUri,
    });
});


// ---- Completed calls available to the agent disposition panel ----
router.get('/agents/:id/completed-calls', async (req, res) => {
    const u = req.session.user;
    const agentId = req.params.id;
    if (u.agentId !== agentId && !hasAdminAccess(u) &&
        !(isScopedSupervisor(u) && await canAccessAgent(u.tenantId, u, agentId))) {
        return res.status(403).json({ error: 'forbidden' });
    }

    if (!agentId) {
        return res.status(400).json({ error: 'agent_id_required' });
    }

    try {
        const result = await pool.query(
            `SELECT c.id, c.direction::text AS direction,
                    CASE WHEN c.direction::text = 'outbound'
                         THEN c.to_number ELSE c.from_number END AS phone_number,
                    c.start_time, c.end_time, c.campaign_id,
                    d.code AS disposition_code
             FROM calls c
             LEFT JOIN dispositions d ON d.id = c.disposition_id
             WHERE c.tenant_id = $1
               AND c.agent_id = $2
               AND c.status::text = 'completed'
               AND c.end_time IS NOT NULL
             ORDER BY c.end_time DESC
             LIMIT 20`,
            [u.tenantId, agentId]
        );

        return res.json({ results: result.rows });
    } catch (err) {
        console.error('Completed calls lookup failed:', err.message);
        return res.status(500).json({ error: 'completed_calls_lookup_failed' });
    }
});

// ---- Real-agent call disposition, DNC and callback scheduling ----
router.post('/agents/:id/disposition', async (req, res) => {
    const u = req.session.user;
    const agentId = req.params.id;
    const callId = typeof req.body?.call_id === 'string' ? req.body.call_id.trim() : '';
    const code = typeof req.body?.code === 'string' ? req.body.code.trim().toUpperCase() : '';
    const notes = typeof req.body?.notes === 'string' ? req.body.notes.trim().slice(0, 4000) : '';
    const callbackAt = req.body?.callback_at;
    const dncScope = req.body?.dnc_scope === 'campaign' ? 'campaign' : 'tenant';

    // Disposition writes are limited to the owning agent or an admin.
    // Supervisors have read/monitor access only and cannot impersonate agents.
    if (u.agentId !== agentId && !hasAdminAccess(u)) {
        return res.status(403).json({ error: 'forbidden' });
    }

    if (!callId || !/^[0-9a-f-]{36}$/i.test(callId)) {
        return res.status(400).json({ error: 'valid_call_id_required' });
    }
    if (!['DND', 'FOLLOW_UP', 'TRANSFER', 'NORMAL', 'OTHERS', 'SALEDONE'].includes(code)) {
        return res.status(422).json({ error: 'invalid_disposition' });
    }

    let parsedCallback = null;
    if (code === 'FOLLOW_UP') {
        parsedCallback = typeof callbackAt === 'string' ? new Date(callbackAt) : null;
        if (!parsedCallback || Number.isNaN(parsedCallback.getTime()) || parsedCallback <= new Date()) {
            return res.status(422).json({ error: 'valid_future_callback_at_required' });
        }
    }

    const client = await pool.connect();
    try {
        await client.query('BEGIN');

        const callResult = await client.query(
            `SELECT c.id, c.agent_id, c.campaign_id, c.contact_id,
                    c.status::text AS status,
                    CASE WHEN c.direction::text = 'outbound'
                         THEN c.to_number ELSE c.from_number END AS phone_number
             FROM calls c
             WHERE c.tenant_id = $1 AND c.id = $2
             FOR UPDATE`,
            [u.tenantId, callId]
        );

        const call = callResult.rows[0];
        if (!call || call.agent_id !== agentId) {
            await client.query('ROLLBACK');
            return res.status(404).json({ error: 'call_not_found_for_agent' });
        }

        if (call.status !== 'completed') {
            await client.query('ROLLBACK');
            return res.status(409).json({ error: 'call_not_completed' });
        }

        const dispResult = await client.query(
            `SELECT id FROM dispositions
             WHERE tenant_id = $1 AND code = $2 AND channel::text = 'voice'
               AND is_active = TRUE
             LIMIT 1`,
            [u.tenantId, code]
        );
        if (!dispResult.rowCount) {
            await client.query('ROLLBACK');
            return res.status(422).json({ error: 'disposition_not_configured' });
        }

        await client.query(
            `UPDATE calls
             SET disposition_id = $3
             WHERE tenant_id = $1 AND id = $2`,
            [u.tenantId, callId, dispResult.rows[0].id]
        );

        if (code === 'DND') {
            const rawPhone = String(call.phone_number || '').trim();
            const phone = rawPhone.replace(/\D/g, '');
            if (phone.length < 7 || phone.length > 15) {
                await client.query('ROLLBACK');
                return res.status(422).json({ error: 'call_has_no_valid_phone_number' });
            }

            const campaignId = dncScope === 'campaign' ? call.campaign_id : null;
            if (dncScope === 'campaign' && !campaignId) {
                await client.query('ROLLBACK');
                return res.status(422).json({ error: 'call_has_no_campaign_for_campaign_dnc' });
            }

            await client.query(
                `INSERT INTO do_not_call_entries
                    (tenant_id, phone_number, campaign_id, reason, created_by)
                 VALUES ($1,$2,$3,$4,$5)
                 ON CONFLICT DO NOTHING`,
                [u.tenantId, phone, campaignId, notes || 'Agent marked Do Not Call', u.id]
            );
        }

        if (code === 'FOLLOW_UP') {
            const rawPhone = String(call.phone_number || '').trim();
            const phone = rawPhone.replace(/\D/g, '');
            if (phone.length < 7 || phone.length > 15) {
                await client.query('ROLLBACK');
                return res.status(422).json({ error: 'call_has_no_valid_phone_number' });
            }

            await client.query(
                `INSERT INTO agent_callbacks
                    (tenant_id, agent_id, call_id, campaign_id, phone_number,
                     due_at, status, notes)
                 VALUES ($1,$2,$3,$4,$5,$6,'scheduled',$7)`,
                [u.tenantId, agentId, callId, call.campaign_id, phone, parsedCallback.toISOString(), notes || null]
            );
        }

        await client.query(
            `INSERT INTO call_events (tenant_id, call_id, event_type, event_time, agent_id, payload_json)
             VALUES ($1,$2,$3,now(),$4,$5::jsonb)`,
            [u.tenantId, callId, 'DISPOSITION_SET', agentId,
             JSON.stringify({ code, notes, dnc_scope: code === 'DND' ? dncScope : null })]
        );

        await client.query('COMMIT');
        return res.json({ ok: true, code });
    } catch (err) {
        await client.query('ROLLBACK').catch(() => {});
        console.error('Disposition save failed:', err.message);
        return res.status(500).json({ error: 'disposition_save_failed' });
    } finally {
        client.release();
    }
});

