<%
const navGroups = {
    superadmin: [
        { label: 'Overview', items: [
            { label: 'Dashboard', href: '/superadmin', icon: 'dashboard' },
            { label: 'Tenants', href: '/superadmin/tenants', icon: 'corporate_fare' },
        ]},
    ],
    admin: [
        { label: 'Overview', items: [
            { label: 'Dashboard', href: '/admin', icon: 'dashboard' },
            { label: 'Appearance', href: '/admin/appearance', icon: 'palette' },
        ]},
        { label: 'Tenant Management', items: (typeof isReseller !== 'undefined' && isReseller) ? [
            { label: 'Sub-Tenants', href: '/admin/sub-tenants', icon: 'account_tree' },
        ] : []},
        { label: 'Users', items: [
            { label: 'Users', href: '/admin/users', icon: 'group' },
        ]},
        { label: 'Call Center', items: [
            { label: 'Queues', href: '/admin/queues', icon: 'queue' },
            { label: 'Skills', href: '/admin/skills', icon: 'checklist' },
            { label: 'Dispositions', href: '/admin/dispositions', icon: 'checklist' },
  { label: 'User Groups', href: '/admin/user-groups', icon: 'users' },
  { label: 'Pause Codes', href: '/admin/pause-codes', icon: 'pause' },
            { label: 'Skill Routing', href: '/admin/skill-routing', icon: 'route' },
            { label: 'Campaigns', href: '/admin/campaigns', icon: 'campaign' },
            { label: 'Robo-Agents', href: '/admin/robo-agents', icon: 'bot' },
            { label: 'List Management', href: '/admin/lists', icon: 'list-checks' },
            { label: 'Callback Management', href: '/admin/callbacks', icon: 'calendar-clock' },
            { label: 'Media Assets', href: '/admin/media-assets', icon: 'graphic_eq' },
            { label: 'Recording Settings', href: '/admin/recording-settings', icon: 'settings' },
            { label: 'IVR Menus', href: '/admin/ivr', icon: 'dialpad' },
            { label: 'Inbound Groups', href: '/admin/inbound-groups', icon: 'call' },
            { label: 'DIDs', href: '/admin/dids', icon: 'dialpad' },
            { label: 'SIP Trunks', href: '/admin/trunks', icon: 'cable' },
            { label: 'Caller ID / CLI', href: '/admin/cli-settings', icon: 'phone' },
            { label: 'Outbound Prefixes', href: '/admin/prefixes', icon: 'route' },
        ]},
        { label: 'Compliance & Integrations', items: [
            { label: 'Audit Logs', href: '/admin/audit-logs', icon: 'history' },
            { label: 'DNC Management', href: '/admin/dnc', icon: 'shield-ban' },
            { label: 'Privacy & Masking', href: '/admin/privacy-settings', icon: 'shield' },
            { label: 'CRM Integration', href: '/admin/crm-integration', icon: 'handshake' },
            { label: 'Webchat & Chatbot', href: '/admin/chat-widget', icon: 'forum' },
            { label: 'Mattermost Bridge', href: '/admin/mattermost', icon: 'chat' },
            { label: 'Staff Chat', href: '/admin/staff-chat', icon: 'forum' },
        ]},
    ],
    supervisor: [
        { label: 'Overview', items: [
            { label: 'Live Dashboard', href: '/supervisor', icon: 'sensors' },
        ]},
        { label: 'Reports', items: [
            { label: 'Call Records', href: '/supervisor/calls', icon: 'receipt_long' },
            { label: 'Chat Monitor', href: '/supervisor/chat', icon: 'forum' },
            { label: 'Staff Chat', href: '/supervisor/staff-chat', icon: 'forum' },
        ]},
    ],
    agent: [
        { label: 'Workspace', items: [
            { label: 'Phone', href: '/agent', icon: 'support_agent' },
            { label: 'Chat Inbox', href: '/agent/chat', icon: 'forum' },
            { label: 'Staff Chat', href: '/agent/staff-chat', icon: 'forum' },
            { label: 'My Calls', href: '/agent/calls', icon: 'receipt_long' },
        ]},
    ],
    mis_agent: [
        { label: 'Overview', items: [
            { label: 'Reports', href: '/mis', icon: 'analytics' },
        ]},
        { label: 'Reports', items: [
            { label: 'Agent Hourly', href: '/mis/agent-hourly', icon: 'schedule' },
            { label: 'Agent Performance (APR)', href: '/mis/agent-performance', icon: 'analytics' },
            { label: 'Agent Login/Logout', href: '/mis/login-activity', icon: 'login' },
            { label: 'Queue Report', href: '/mis/queue-report', icon: 'queue' },
            { label: 'Campaign Report', href: '/mis/campaign-report', icon: 'campaign' },
            { label: 'List-wise Report', href: '/mis/list-report', icon: 'list' },
            { label: 'Disposition Report', href: '/mis/disposition-report', icon: 'clipboard-check' },
            { label: 'Omnichannel Report', href: '/mis/omnichannel-report', icon: 'messages-square' },
            { label: 'Callback Report', href: '/mis/callback-report', icon: 'calendar-clock' },
            { label: 'DID Report', href: '/mis/did-report', icon: 'dialpad' },
            { label: 'IVR Journey', href: '/mis/ivr-journey', icon: 'account_tree' },
            { label: 'Recordings', href: '/mis/recordings', icon: 'graphic_eq' },
            { label: 'Custom Report Builder', href: '/mis/custom-reports', icon: 'file-spreadsheet' },
            { label: 'AI Analysis', href: '/mis/ai-analysis', icon: 'brain' },
        ]},
    ],
};
const roleLabels = { superadmin: 'Superadmin', admin: 'Admin', supervisor: 'Supervisor', agent: 'Agent', mis_agent: 'MIS Agent' };
const primaryRole = (currentUser && currentUser.roles && currentUser.roles[0]) || 'agent';
const tenantFeatureFlags =
    (typeof tenantFeatures !== 'undefined' && tenantFeatures)
        ? tenantFeatures : {};

const navFeatureRequirements = {
    '/admin/queues': ['queues'],
    '/admin/skills': ['skills'],
    '/admin/dispositions': ['dispositions'],
    '/admin/user-groups': ['user_groups'],
    '/admin/pause-codes': ['pause_codes'],
    '/admin/skill-routing': ['skill_routing'],
    '/admin/campaigns': ['campaigns'],
    '/admin/robo-agents': ['campaigns', 'robo_agents'],
    '/admin/lists': ['list_management'],
    '/admin/callbacks': ['callback_management'],
    '/admin/media-assets': ['media_assets'],
    '/admin/recording-settings': ['call_recording'],
    '/admin/ivr': ['ivr'],
    '/admin/inbound-groups': ['inbound'],
    '/admin/dids': ['inbound'],
    '/admin/trunks': ['sip_trunks'],
    '/admin/cli-settings': ['caller_id'],
    '/admin/prefixes': ['outbound'],
    '/admin/audit-logs': ['audit_logs'],
    '/admin/dnc': ['dnc_management'],
    '/admin/privacy-settings': ['privacy_masking'],
    '/admin/crm-integration': ['crm_integration'],
    '/admin/chat-widget': ['webchat'],
    '/admin/mattermost': ['mattermost'],
    '/admin/staff-chat': ['staff_chat'],

    '/supervisor': ['voice', 'callback_management', 'dnc_management'],
    '/supervisor/calls': ['voice'],
    '/supervisor/chat': ['omnichannel'],
    '/supervisor/staff-chat': ['staff_chat'],

    '/agent': ['voice'],
    '/agent/chat': ['omnichannel'],
    '/agent/staff-chat': ['staff_chat'],
    '/agent/calls': ['voice'],

    '/mis': ['mis_reports'],
    '/mis/agent-hourly': ['mis_reports', 'voice'],
    '/mis/agent-performance': ['mis_reports', 'voice'],
    '/mis/callback-report': ['mis_reports', 'callback_management'],
    '/mis/login-activity': ['mis_reports', 'voice'],
    '/mis/queue-report': ['mis_reports', 'queues'],
    '/mis/campaign-report': ['mis_reports', 'campaigns'],
    '/mis/list-report': ['mis_reports', 'list_management'],
    '/mis/disposition-report': ['mis_reports', 'voice', 'dispositions'],
    '/mis/omnichannel-report': ['mis_reports', 'omnichannel'],
    '/mis/custom-reports': ['mis_reports'],
    '/mis/ai-analysis': ['mis_reports'],
    '/mis/did-report': ['mis_reports', 'inbound'],
    '/mis/ivr-journey': ['mis_reports', 'ivr'],
    '/mis/recordings': ['mis_reports', 'call_recording']
};

const groups = (navGroups[primaryRole] || [])
    .map(group => ({
        label: group.label,
        items: group.items.filter(item => {
            const required = navFeatureRequirements[item.href];
            if (primaryRole === 'superadmin' || !required) return true;
            return required.every(key => tenantFeatureFlags[key] === true);
        })
    }))
    .filter(group => group.items.length > 0);
const curPath = typeof currentPath !== 'undefined' ? currentPath : '';
const initials = currentUser && (currentUser.fullName || currentUser.username)
    ? (currentUser.fullName || currentUser.username).split(' ').map(w => w[0]).slice(0,2).join('').toUpperCase()
    : '?';
const mTenants = typeof manageableTenants !== 'undefined' ? manageableTenants : [];
const effTenant = typeof effectiveTenant !== 'undefined' ? effectiveTenant : null;
%>
<aside class="tl-sidebar">
    <div class="tl-brand">
        <%
        const brandAppearance = (typeof tenantAppearance !== 'undefined' && tenantAppearance)
            ? tenantAppearance : {};
        const brandName = typeof brandAppearance.portal_name === 'string' &&
            brandAppearance.portal_name.trim()
            ? brandAppearance.portal_name.trim() : 'TECH-Life Contact-Center Solution';
        const brandLogo = typeof brandAppearance.logo_path === 'string' &&
            /^\/uploads\/branding\/[A-Za-z0-9_-]+\.(?:png|jpe?g|webp)$/i.test(brandAppearance.logo_path)
            ? brandAppearance.logo_path : null;
        %>
        <% if (brandLogo) { %>
            <div class="tl-brand-mark tl-brand-image"><img src="<%= brandLogo %>" alt=""></div>
        <% } else { %>
            <div class="tl-brand-mark">TL</div>
        <% } %>
        <div class="tl-brand-text"><%= brandName %><span>Contact-Center Solution</span></div>
    </div>

    <% if (effTenant && mTenants.length > 1) { %>
    <div class="tl-tenant-switcher">
        <div class="tl-tenant-switcher-label">Managing</div>
        <form method="get" action="/admin/switch-tenant">
            <select name="as_tenant" onchange="this.form.submit()">
                <% mTenants.forEach(mt => { %>
                    <option value="<%= mt.id %>" <%= mt.id === effTenant.id ? 'selected' : '' %>>
                        <%= mt.name %><%= mt.parent_tenant_id ? '' : ' (own)' %>
                    </option>
                <% }) %>
            </select>
        </form>
    </div>
    <% } else if (effTenant) { %>
    <div class="tl-tenant-switcher tl-tenant-switcher-static">
        <div class="tl-tenant-switcher-label">Tenant</div>
        <div class="tl-tenant-switcher-name"><%= effTenant.name %></div>
    </div>
    <% } %>

    <nav class="tl-nav">
        <% groups.forEach(group => { if (!group.items.length) return; %>
            <span class="ngl"><%= group.label %></span>
            <% group.items.forEach(item => {
                const active = curPath === item.href || (item.href !== '/' && curPath.startsWith(item.href));
            %>
                <a href="<%= item.href %>" class="tl-nav-link<%= active ? ' active' : '' %>">
                    <span class="material-icons-round tl-nav-icon"><%= item.icon %></span>
                    <span><%= item.label %></span>
                </a>
            <% }) %>
        <% }) %>
    </nav>

    <% if (primaryRole === 'agent' && curPath === '/agent' && (primaryRole === 'superadmin' || tenantFeatureFlags.internal_calling === true)) { %>
    <details class="tl-sidebar-directory">
        <summary><span>Contacts & Agents</span><span class="tl-sidebar-dir-arrow">＋</span></summary>
        <div class="tl-sidebar-dir-body">
            <select id="agentDirectoryQueue" aria-label="Filter by queue">
                <option value="">All tenant contacts and agents</option>
            </select>
            <input id="agentDirectorySearch" type="search" placeholder="Search contacts or agents">
            <button type="button" class="tl-btn secondary" onclick="loadAgentDialDirectory()">Refresh</button>
            <h4>Customer Contacts</h4>
            <div id="agentDirectoryContacts">Loading contacts…</div>
            <h4>Internal Agents</h4>
            <div id="agentDirectoryAgents">Loading agents…</div>
            <p id="agentDirectoryMessage" class="tl-sidebar-dir-message" aria-live="polite"></p>
        </div>
    </details>
    <% } else if (primaryRole === 'supervisor' && curPath === '/supervisor' && (primaryRole === 'superadmin' || tenantFeatureFlags.internal_calling === true)) { %>
    <details class="tl-sidebar-directory">
        <summary><span>Contacts & Agents</span><span class="tl-sidebar-dir-arrow">＋</span></summary>
        <div class="tl-sidebar-dir-body">
            <select id="supervisorDirectoryQueue" aria-label="Filter by queue">
                <option value="">All accessible contacts and agents</option>
            </select>
            <input id="supervisorDirectorySearch" type="search" placeholder="Search contacts or agents">
            <button type="button" class="tl-btn secondary" onclick="loadSupervisorDialDirectory()">Refresh</button>
            <h4>Customer Contacts</h4>
            <div id="supervisorDirectoryContacts">Loading contacts…</div>
            <h4>Internal Agents</h4>
            <div id="supervisorDirectoryAgents">Loading agents…</div>
            <p id="supervisorDirectoryMessage" class="tl-sidebar-dir-message" aria-live="polite"></p>
        </div>
    </details>
    <% } %>

    <style>
    .tl-sidebar-directory {
        margin: 12px;
        border: 1px solid var(--bd);
        border-radius: 10px;
        background: var(--c2);
        overflow: hidden;
    }
    .tl-sidebar-directory summary {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px;
        cursor: pointer;
        font-size: 12px;
        font-weight: 700;
        list-style: none;
    }
    .tl-sidebar-directory summary::-webkit-details-marker { display: none; }
    .tl-sidebar-directory[open] .tl-sidebar-dir-arrow { transform: rotate(45deg); }
    .tl-sidebar-dir-body {
        padding: 10px;
        max-height: 48vh;
        overflow-y: auto;
        border-top: 1px solid var(--bd);
    }
    .tl-sidebar-dir-body select,
    .tl-sidebar-dir-body input {
        box-sizing: border-box;
        width: 100%;
        min-width: 0;
        margin: 5px 0;
    }
    .tl-sidebar-dir-body button.tl-btn { width: 100%; margin: 5px 0; }
    .tl-sidebar-dir-body h4 {
        margin: 13px 0 6px;
        font-size: 11px;
        color: var(--acc2);
    }
    .tl-sidebar-directory [data-directory-row] {
        flex-direction: column !important;
        align-items: stretch !important;
        gap: 5px !important;
        padding: 8px !important;
    }
    .tl-sidebar-directory [data-directory-row] button { width: 100%; }
    .tl-sidebar-directory [data-directory-row] > div { width: 100%; }
    .tl-sidebar-dir-message { font-size: 10px; color: var(--t2); }
    </style>

    <% if (currentUser) { %>
    <div class="tl-sidebar-user">
        <div class="tl-avatar"><%= initials %></div>
        <div class="tl-sidebar-user-info">
            <div class="tl-sidebar-user-name"><%= currentUser.fullName || currentUser.username %></div>
            <div class="tl-sidebar-user-role"><%= roleLabels[primaryRole] || primaryRole %></div>
        </div>
        <a href="/logout" class="tl-logout-btn" title="Logout">
            <span class="material-icons-round" style="font-size:18px">logout</span>
        </a>
    </div>
    <% } %>
</aside>
<div class="tl-content-wrap">
    <main class="tl-main">
