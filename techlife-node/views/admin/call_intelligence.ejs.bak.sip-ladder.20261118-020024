}
.ci-sip-sequence {
    color:#86a6c2;
    font-weight:700;
    margin-right:5px;
}

.ci-sip-raw pre {
    white-space:pre-wrap;
    overflow-wrap:anywhere;
    max-height:420px;
    overflow:auto;
    padding:12px;
    background:var(--tl-panel,#f5f6f8);
    border-radius:8px;
    font-size:11px;
}
.ci-media-record {
    padding:10px;
    border:1px solid var(--tl-border,#ddd);
    border-radius:8px;
    overflow-wrap:anywhere;
}


/* TECH-Life compact multi-endpoint signalling diagram */
.ci-sequence-board {
    background:#071321;
    color:#e8f2fc;
    border:1px solid #20394e;
    border-radius:9px;
    overflow:hidden;
}
.ci-sequence-summary {
    display:flex;
    align-items:center;
    flex-wrap:wrap;
    gap:12px;
    padding:9px 12px;
