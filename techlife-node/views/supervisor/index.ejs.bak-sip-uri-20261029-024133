</table>

<h2 id="dnc">Do Not Call (DNC)</h2>
<p class="tl-subtitle">Adding a number here blocks it from future outbound dialing according to the DNC preflight rules.</p>
<form method="post" action="/supervisor/dnc" class="tl-card">
    <div class="tl-filters">
        <div><label>Phone number</label><input name="phone_number" required maxlength="30" placeholder="Enter phone number"></div>
        <div><label>Scope</label><select name="campaign_id"><option value="">Tenant-wide DNC</option><% campaigns.forEach(c => { %><option value="<%= c.id %>"><%= c.name %> only</option><% }); %></select></div>
        <div><label>Reason</label><input name="reason" maxlength="100" placeholder="Optional reason"></div>
    </div>
    <button class="tl-btn" type="submit">Add to DNC</button>
</form>
<table>
    <tr><th>Phone</th><th>Scope</th><th>Reason</th><th>Added</th></tr>
    <% (dncEntries || []).forEach(d => { %>
    <tr><td><%= d.phone_number %></td><td><%= d.campaign_id ? (d.campaign_name || 'Campaign') : 'Tenant-wide' %></td><td><%= d.reason || '' %></td><td><%= new Date(d.created_at).toLocaleString() %></td></tr>
    <% }); %>
    <% if (!(dncEntries || []).length) { %><tr><td colspan="4">No DNC entries found.</td></tr><% } %>
</table>

<script src="/vendor/sip.js"></script>
<script>
const SUPERVISOR_AGENT_ID = <%- JSON.stringify(sipAgentId) %>;
const SUPERVISOR_NAME = <%- JSON.stringify(supervisorDisplayName) %>;
let supervisorUserAgent = null;
let supervisorRegisterer = null;
let supervisorIncomingSession = null;
let supervisorOutgoingSession = null;
let supervisorSipCredentials = null;
let supervisorExtraLines = { 2: null, 3: null };
let supervisorActiveLine = 1;
let supervisorToneContext = null;
let supervisorRingbackTimer = null;
let supervisorRingbackSecond = null;
let supervisorRingbackNodes = [];
let supervisorRingbackAudio = false;
let allAgents = [];

function setSupervisorSipStatus(text, cssClass) {
    const el = document.getElementById('supervisorSipStatus');
    el.textContent = text;
    el.className = 'tl-status-pill ' + cssClass;
}

async function initSupervisorSip() {
    if (!SUPERVISOR_AGENT_ID) {
        setSupervisorSipStatus('SIP profile not configured', 'status-offline');
        document.getElementById('supervisorCallState').textContent =
            'Ask an administrator to provision a SIP line for this supervisor.';
        return;
    }

    setSupervisorSipStatus('fetching credentials…', 'status-break');
    let creds;
    try {
        const res = await fetch(
            `/api/v1/agents/${encodeURIComponent(SUPERVISOR_AGENT_ID)}/sip-credentials`
        );
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
            setSupervisorSipStatus(
                data.error === 'not_provisioned'
                    ? `line ${data.status || 'not provisioned'}`
                    : 'credential request failed',
                'status-offline'
            );
            return;
        }
        creds = data;
    } catch (e) {
        console.error('Supervisor SIP credentials request failed', e);
        setSupervisorSipStatus('server unavailable', 'status-offline');
        return;
    }

    if (!window.SIP || !SIP.UserAgent || !SIP.Registerer) {
        setSupervisorSipStatus('SIP.js unavailable', 'status-offline');
        return;
    }

    const uri = SIP.UserAgent.makeURI(
        `sip:${creds.sip_username}@${creds.sip_domain}`
    );
    if (!uri) {
        setSupervisorSipStatus('invalid SIP address', 'status-offline');
        return;
    }

    supervisorSipCredentials = creds;

    supervisorUserAgent = new SIP.UserAgent({
        uri,
        transportOptions: { server: creds.ws_uri },
        authorizationUsername: creds.sip_username,
        authorizationPassword: creds.sip_password,
        displayName: SUPERVISOR_NAME
    });

    supervisorUserAgent.delegate = {
        onInvite: (invitation) => {
            // Only one monitoring leg is presented at a time.
            if (supervisorIncomingSession) {
                invitation.reject().catch(() => {});
                return;
            }

            supervisorIncomingSession = invitation;
            document.getElementById('supervisorCallState').textContent =
                'Incoming call — answer to hear the monitoring audio.';
            document.getElementById('supervisorIncomingControls').style.display = 'block';

            invitation.stateChange.addListener((state) => {
                if (state === SIP.SessionState.Established) {
                    document.getElementById('supervisorCallState').textContent =
                        'Monitoring call connected';
                    document.getElementById('supervisorIncomingControls').style.display = 'none';

                    const pc = invitation.sessionDescriptionHandler &&
                        invitation.sessionDescriptionHandler.peerConnection;
                    if (pc) {
                        const stream = new MediaStream();
                        pc.getReceivers().forEach((receiver) => {
                            if (receiver.track) stream.addTrack(receiver.track);
                        });
                        const audio = document.getElementById('supervisorRemoteAudio');
                        audio.srcObject = stream;
                        audio.play().catch((err) => {
                            console.warn('Click the page to enable monitoring audio', err);
                        });
                    }
                } else if (state === SIP.SessionState.Terminated) {
                    supervisorIncomingSession = null;
                    document.getElementById('supervisorRemoteAudio').srcObject = null;
                    document.getElementById('supervisorCallState').textContent =
                        'Monitoring call ended';
                    document.getElementById('supervisorIncomingControls').style.display = 'none';
                }
            });
        }
    };

    try {
        await supervisorUserAgent.start();
        supervisorRegisterer = new SIP.Registerer(supervisorUserAgent);
        await supervisorRegisterer.register();
        setSupervisorSipStatus(`registered (${creds.extension})`, 'status-available');
        document.getElementById('supervisorCallState').textContent =
            'Phone ready. Listen/Whisper/Barge calls can ring this browser.';
    } catch (e) {
        console.error('Supervisor SIP registration failed', e);
        setSupervisorSipStatus('registration failed', 'status-offline');
    }
}

async function answerSupervisorCall() {
    if (!supervisorIncomingSession) return;
    try {
        await supervisorIncomingSession.accept({
            sessionDescriptionHandlerOptions: {
                constraints: { audio: true, video: false }
            }
        });
        document.getElementById('supervisorIncomingControls').style.display = 'none';
    } catch (e) {
        console.error('Could not answer supervisor monitoring call', e);
        document.getElementById('supervisorCallState').textContent = 'Could not answer call';
    }
}

async function rejectSupervisorCall() {
    if (!supervisorIncomingSession) return;
    try {
        await supervisorIncomingSession.reject();
    } catch (e) {
        console.error('Could not reject incoming call', e);
    }
}


function supervisorPlayTone(key) {
    try {
        if (!supervisorToneContext) {
            supervisorToneContext = new (window.AudioContext || window.webkitAudioContext)();
        }
        const ctx = supervisorToneContext;
        if (ctx.state === 'suspended') ctx.resume();

        const pairs = {
            '1':[697,1209], '2':[697,1336], '3':[697,1477],
            '4':[770,1209], '5':[770,1336], '6':[770,1477],
            '7':[852,1209], '8':[852,1336], '9':[852,1477],
            '*':[941,1209], '0':[941,1336], '#':[941,1477]
        };
        if (!pairs[key]) return;
        const gain = ctx.createGain();
        gain.gain.setValueAtTime(0.0001, ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.12, ctx.currentTime + 0.015);
        gain.gain.setValueAtTime(0.12, ctx.currentTime + 0.10);
        gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.17);
        gain.connect(ctx.destination);
        pairs[key].forEach(frequency => {
            const osc = ctx.createOscillator();
            osc.frequency.value = frequency;
            osc.connect(gain);
            osc.start();
            osc.stop(ctx.currentTime + 0.18);
        });
        setTimeout(() => { try { gain.disconnect(); } catch (_) {} }, 250);
    } catch (e) {
        console.warn('Local keypad tone unavailable', e);
    }
}

function supervisorRingbackBurst() {
    if (supervisorRingbackAudio) return;
    try {
        if (!supervisorToneContext) {
            supervisorToneContext = new (window.AudioContext || window.webkitAudioContext)();
        }
        const ctx = supervisorToneContext;
        if (ctx.state === 'suspended') ctx.resume();
        const gain = ctx.createGain();
        gain.gain.value = 0.055;
        gain.connect(ctx.destination);
        supervisorRingbackNodes.push(gain);
        [400, 450].forEach(f => {
            const osc = ctx.createOscillator();
            osc.frequency.value = f;
            osc.connect(gain);
            osc.start();
            osc.stop(ctx.currentTime + 0.38);
            supervisorRingbackNodes.push(osc);
        });
        setTimeout(() => {
            try { gain.disconnect(); } catch (_) {}
            supervisorRingbackNodes = supervisorRingbackNodes.filter(n => n !== gain);
        }, 500);
    } catch (e) {
        console.warn('Local ringback unavailable', e);
    }
}

function supervisorStartRingback() {
    supervisorStopRingback();
    supervisorRingbackAudio = false;
    supervisorRingbackBurst();
    supervisorRingbackSecond = setTimeout(supervisorRingbackBurst, 600);
    supervisorRingbackTimer = setInterval(() => {
        supervisorRingbackBurst();
        supervisorRingbackSecond = setTimeout(supervisorRingbackBurst, 600);
    }, 3000);
}

function supervisorStopRingback() {
    if (supervisorRingbackTimer !== null) clearInterval(supervisorRingbackTimer);
    if (supervisorRingbackSecond !== null) clearTimeout(supervisorRingbackSecond);
    supervisorRingbackTimer = null;
    supervisorRingbackSecond = null;
    supervisorRingbackNodes.forEach(n => {
        try { n.stop(); } catch (_) {}
        try { n.disconnect(); } catch (_) {}
    });
    supervisorRingbackNodes = [];
}

function supervisorAttachRemoteAudio(session) {
    const audio = document.getElementById('supervisorRemoteAudio');
    const sdh = session && session.sessionDescriptionHandler;
    const pc = sdh && sdh.peerConnection;
    if (!pc || audio.dataset.sessionAttached === String(session.id || 'active')) return;
    audio.dataset.sessionAttached = String(session.id || 'active');

    const stream = new MediaStream();
    pc.getReceivers().forEach(r => { if (r.track) stream.addTrack(r.track); });
    pc.addEventListener('track', event => {
        supervisorRingbackAudio = true;
        supervisorStopRingback();
        if (event.track && !stream.getTracks().includes(event.track)) {
            stream.addTrack(event.track);
        }
        audio.srcObject = stream;
        audio.play().catch(() => {
            document.getElementById('supervisorCallState').textContent =
                'Remote audio available. Tap the page to enable playback.';
        });
    });
    audio.srcObject = stream;
    audio.onplaying = () => {
        supervisorRingbackAudio = true;
        supervisorStopRingback();
    };
    audio.play().catch(() => {});
}

function supervisorLineInfo(line) {
    if (line === 1) {
        return supervisorUserAgent && supervisorRegisterer && supervisorSipCredentials
            ? { userAgent: supervisorUserAgent, registerer: supervisorRegisterer,
                creds: supervisorSipCredentials }
            : null;
    }
    return supervisorExtraLines[line];
}

function selectSupervisorLine(line) {
    if (![1, 2, 3].includes(line)) return;
    supervisorActiveLine = line;
    [1, 2, 3].forEach(n => {
        document.getElementById('supervisorLineBtn' + n)
            .classList.toggle('active', n === line);
    });
    const info = supervisorLineInfo(line);
    document.getElementById('supervisorActiveLineLabel').textContent =
        'LINE ' + line + (line === 1 ? ' · TECH-LIFE' : ' · EXTRA SIP');
    document.getElementById('supervisorPhoneHint').textContent = info
        ? 'Registered · ready to dial'
        : (line === 1 ? 'Waiting for automatic registration' : 'Configure and register this line below');
}

async function registerSupervisorExtraLine(line) {
    const message = document.getElementById('supervisorExtraMsg' + line);
    const username = document.getElementById('supervisorSipUser' + line).value.trim();
    const password = document.getElementById('supervisorSipPass' + line).value;
    const domain = document.getElementById('supervisorSipDomain' + line).value.trim();
    const wsUri = document.getElementById('supervisorSipWs' + line).value.trim();

    if (!username || !password || !domain || !wsUri) {
        message.textContent = 'Fill in all four fields.';
        return;
    }
    if (!/^wss:\/\/[^ ]+$/i.test(wsUri)) {
        message.textContent = 'Use a secure wss:// WebSocket URI.';
        return;
    }
    if (supervisorExtraLines[line]) {
        message.textContent = 'This line is already registered. Reload the page to replace it.';
        return;
    }
    if (!window.SIP || !SIP.UserAgent || !SIP.Registerer) {
        message.textContent = 'SIP.js is unavailable.';
        return;
    }

    message.textContent = 'Registering…';
    let ua;
    try {
        const uri = SIP.UserAgent.makeURI('sip:' + username + '@' + domain);
        if (!uri) throw new Error('Invalid SIP domain or username');
        ua = new SIP.UserAgent({
            uri,
            transportOptions: { server: wsUri },
            authorizationUsername: username,
            authorizationPassword: password,
            displayName: SUPERVISOR_NAME + ' Line ' + line
        });
        ua.delegate = {
            onInvite: invitation => {
                invitation.reject().catch(() => {});
                message.textContent = 'Incoming calls on extra lines are not enabled in this version.';
            }
        };
        await ua.start();
        const registerer = new SIP.Registerer(ua);
        await registerer.register();
        supervisorExtraLines[line] = {
            userAgent: ua, registerer,
            creds: { sip_username: username, sip_password: password,
                     sip_domain: domain, ws_uri: wsUri }
        };
        document.getElementById('supervisorLineState' + line).textContent = 'Registered';
        message.textContent = 'Registered. Credentials remain in this page memory.';
        selectSupervisorLine(line);
    } catch (e) {
        console.error('Extra SIP line registration failed', line, e);
        if (ua) {
            try { await ua.stop(); } catch (_) {}
        }
        message.textContent = 'Registration failed: ' + (e.message || 'check SIP details');
    }
}

function supervisorDialKey(key) {
    supervisorPlayTone(key);
    const input = document.getElementById('supervisorDialInput');
    if (supervisorOutgoingSession &&
        supervisorOutgoingSession.state === SIP.SessionState.Established) {
        try {
            const sdh = supervisorOutgoingSession.sessionDescriptionHandler;
            const sent = sdh && typeof sdh.sendDtmf === 'function'
                ? sdh.sendDtmf(key) : false;
            if (!sent) console.warn('SIP DTMF was not accepted for key', key);
        } catch (e) {
            console.warn('Could not send SIP DTMF', e);
        }
        return;
    }
    input.value += key;
    input.focus();
}

function supervisorDeleteDigit() {
    const input = document.getElementById('supervisorDialInput');
    input.value = input.value.slice(0, -1);
    input.focus();
}

async function placeSupervisorCall() {
    const input = document.getElementById('supervisorDialInput');
    const number = input.value.trim();

    const selectedLine = supervisorLineInfo(supervisorActiveLine);
    if (!selectedLine) {
        document.getElementById('supervisorCallState').textContent =
            'Selected line is not registered. Select Line 1 or register the extra line.';
        return;
    }
    if (supervisorOutgoingSession || supervisorIncomingSession) {
        document.getElementById('supervisorCallState').textContent =
            'End the current call before starting another call.';
        return;
    }
    if (!number || !/^[+*#0-9().\-\s]+$/.test(number)) {
        document.getElementById('supervisorCallState').textContent =
            'Enter a valid phone number or extension.';
        input.focus();
        return;
    }

    // Fail closed if the Do Not Call check cannot be completed.
    try {
        const response = await fetch('/api/v1/dnd/check', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ phone_number: number })
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || result.allowed !== true) {
            document.getElementById('supervisorCallState').textContent =
                result.message || 'Call blocked: unable to verify Do Not Call status.';
            return;
        }
    } catch (e) {
        console.error('Supervisor DND preflight failed', e);
        document.getElementById('supervisorCallState').textContent =
            'Call blocked: Do Not Call verification is unavailable.';
        return;
    }

    const domain = selectedLine.creds.sip_domain;
    const target = SIP.UserAgent.makeURI(`sip:${number}@${domain}`);
    if (!target) {
        document.getElementById('supervisorCallState').textContent =
            'Invalid destination.';
        return;
    }

    try {
        const inviter = new SIP.Inviter(selectedLine.userAgent, target, {
            sessionDescriptionHandlerOptions: {
                constraints: { audio: true, video: false }
            }
        });
        supervisorOutgoingSession = inviter;
        document.getElementById('supervisorCallState').textContent =
            'Calling ' + number + ' via Line ' + supervisorActiveLine + '…';
        document.getElementById('supervisorPhoneHint').textContent = 'Calling…';
        document.getElementById('supervisorCallBtn').style.display = 'none';
        document.getElementById('supervisorHangupBtn').style.display = 'block';

        inviter.stateChange.addListener((state) => {
            if (state === SIP.SessionState.Established) {
                supervisorStopRingback();
                supervisorRingbackAudio = true;
                document.getElementById('supervisorCallState').textContent =
                    'Call connected: ' + number;
                supervisorAttachRemoteAudio(inviter);
                supervisorUpdateCallControls();
            } else if (state === SIP.SessionState.Terminated) {
                supervisorStopRingback();
                if (supervisorOutgoingSession === inviter) {
                    supervisorOutgoingSession = null;
                }
                document.getElementById('supervisorCallBtn').style.display = 'block';
                document.getElementById('supervisorHangupBtn').style.display = 'none';
                document.getElementById('supervisorRemoteAudio').srcObject = null;
                document.getElementById('supervisorCallState').textContent =
                    'Call ended. Phone ready.';
                document.getElementById('supervisorPhoneHint').textContent =
                    'Ready when registered';
                document.getElementById('supervisorRemoteAudio').dataset.sessionAttached = '';
                supervisorMicMuted = false;
                supervisorCallHeld = false;
                supervisorUpdateCallControls();
            }
        });

        await inviter.invite();
        // Attach early media as soon as SIP.js has created the peer connection.
        supervisorAttachRemoteAudio(inviter);
        supervisorStartRingback();
    } catch (e) {
        console.error('Supervisor outbound call failed', e);
        supervisorOutgoingSession = null;
        document.getElementById('supervisorCallBtn').style.display = 'block';
        document.getElementById('supervisorHangupBtn').style.display = 'none';
        document.getElementById('supervisorCallState').textContent =
            'Call failed: ' + (e.message || 'check SIP and dialplan configuration');
    }
}


let supervisorMicMuted = false;
let supervisorCallHeld = false;

function supervisorCurrentSession() {
    const established = typeof SIP !== 'undefined' && SIP.SessionState
        ? SIP.SessionState.Established : 'Established';
    for (const session of [supervisorOutgoingSession, supervisorIncomingSession]) {
        if (session && session.state === established) return session;
    }
    return null;
}

function supervisorUpdateCallControls() {
    const session = supervisorCurrentSession();
    const active = !!session;
    ['supervisorMuteBtn', 'supervisorHoldBtn', 'supervisorTransferBtn']
        .forEach(id => {
            const el = document.getElementById(id);
            if (el) el.disabled = !active;
        });
    const conf = document.getElementById('supervisorConferenceBtn');
    if (conf) conf.disabled = true;
    const mute = document.getElementById('supervisorMuteBtn');
    const hold = document.getElementById('supervisorHoldBtn');
    if (mute) mute.textContent = supervisorMicMuted ? 'Unmute' : 'Mute';
    if (hold) hold.textContent = supervisorCallHeld ? 'Resume' : 'Hold';
}

function setSupervisorVolume(value) {
    const volume = Math.max(0, Math.min(1, Number(value) / 100));
    const audio = document.getElementById('supervisorRemoteAudio');
    if (audio) audio.volume = volume;
    const label = document.getElementById('supervisorVolumeValue');
    if (label) label.textContent = Math.round(volume * 100) + '%';
}

async function toggleSupervisorMute() {
    const session = supervisorCurrentSession();
    if (!session) return;
    const pc = session.sessionDescriptionHandler &&
        session.sessionDescriptionHandler.peerConnection;
    if (!pc) {
        alert('The call audio connection is not ready.');
        return;
    }
    const senders = pc.getSenders ? pc.getSenders() : [];
    const tracks = senders.map(sender => sender.track)
        .filter(track => track && track.kind === 'audio');
    if (!tracks.length) {
        alert('No outgoing microphone track is available.');
        return;
    }
    supervisorMicMuted = !supervisorMicMuted;
    tracks.forEach(track => { track.enabled = !supervisorMicMuted; });
    supervisorUpdateCallControls();
    document.getElementById('supervisorCallState').textContent =
        supervisorMicMuted ? 'Microphone muted.' : 'Microphone unmuted.';
}

async function toggleSupervisorHold() {
    const session = supervisorCurrentSession();
    if (!session) return;
    try {
        if (!supervisorCallHeld) {
            if (typeof session.hold !== 'function') {
                alert('Hold is not supported by this SIP.js session.');
                return;
            }
            await session.hold();
            supervisorCallHeld = true;
        } else {
            if (typeof session.unhold !== 'function') {
                alert('Resume is not supported by this SIP.js session.');
                return;
            }
            await session.unhold();
            supervisorCallHeld = false;
        }
        supervisorUpdateCallControls();
        document.getElementById('supervisorCallState').textContent =
            supervisorCallHeld ? 'Call on hold.' : 'Call resumed.';
    } catch (e) {
        console.error('Supervisor hold/resume failed', e);
        alert('Hold/resume failed: ' + (e.message || 'SIP request failed'));
    }
}

async function transferSupervisorCall() {
    const session = supervisorCurrentSession();
    if (!session) return;
    if (typeof session.refer !== 'function') {
        alert('Transfer is not supported by this SIP.js session.');
        return;
    }
    const number = prompt('Transfer this call to which extension or phone number?');
    if (!number || !number.trim()) return;
    const selectedLine = supervisorLineInfo(supervisorActiveLine);
    if (!selectedLine || !selectedLine.creds || !selectedLine.creds.sip_domain) {
        alert('The selected SIP line has no SIP domain configured.');
        return;
    }
    const target = SIP.UserAgent.makeURI(
        'sip:' + number.trim() + '@' + selectedLine.creds.sip_domain
    );
    if (!target) {
        alert('Invalid transfer destination.');
        return;
    }
    try {
        await session.refer(target);
        document.getElementById('supervisorCallState').textContent =
            'Transfer request sent to ' + number.trim() + '.';
    } catch (e) {
        console.error('Supervisor transfer failed', e);
        alert('Transfer failed: ' + (e.message || 'SIP REFER request failed'));
    }
}

async function conferenceSupervisorCall() {
    alert('Conference is not enabled: this phone does not yet have a verified conference-bridge implementation.');
}

async function hangupSupervisorCall() {
    const session = supervisorOutgoingSession;
    if (!session) return;
    supervisorStopRingback();
    try {
        if (session.state === SIP.SessionState.Established) await session.bye();
        else if (session.state === SIP.SessionState.Establishing) await session.cancel();
        else if (session.state === SIP.SessionState.Initial) await session.cancel();
    } catch (e) {
        console.warn('Supervisor hangup request failed', e);
    }
}


setSupervisorVolume(document.getElementById('supervisorVolume')?.value || 100);
supervisorUpdateCallControls();

document.getElementById('supervisorRemoteAudio').addEventListener('playing', () => {
    supervisorRingbackAudio = true;
    supervisorStopRingback();
});

initSupervisorSip();

function fillSkillFilter() {
    const skills = new Set();
    allAgents.forEach(a => (a.skills_json || []).forEach(s => skills.add(s)));
    const sel = document.getElementById('filterSkill');
    const current = sel.value;
    sel.innerHTML = '<option value="">All Skills</option>' + [...skills].map(s => `<option value="${s}">${s}</option>`).join('');
    sel.value = current;
}

async function monitorCall(callId, mode) {
    const res = await fetch(`/api/v1/calls/${callId}/monitor`, {
        method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({ mode })
    });
    const data = await res.json();
    if (!res.ok) {
        alert('Could not start monitoring: ' + (data.error || 'unknown error') +
            '\\n\\nThis requires your Wazo platform to have the supervisor-monitor dialplan context configured -- see INSTALL.md.');
    } else {
        alert(`${mode} started (session ${data.monitoringSessionId}). Your phone should be ringing now.`);
    }
}


function renderSupervisorWallboard(agents, queuesLive, callsLive) {
    const list = value => Array.isArray(value) ? value : [];
    agents = list(agents);
    queuesLive = list(queuesLive);
    callsLive = list(callsLive);

    const esc = value => String(value == null ? '' : value).replace(/[&<>"']/g, ch => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
    }[ch]));
    const statusOf = a => String(a.status || a.agent_status || 'offline').toLowerCase();
    const offline = new Set(['offline', 'logout', 'logged_out']);
    const onCallStates = new Set(['on_call', 'on-call', 'incall', 'in_call', 'busy']);
    const online = agents.filter(a => !offline.has(statusOf(a))).length;
    const available = agents.filter(a => statusOf(a) === 'available').length;
    const onCall = agents.filter(a => onCallStates.has(statusOf(a))).length;
    const waiting = queuesLive.reduce((total, q) => total + (Number(q.calls_waiting) || 0), 0);

    const kpis = document.getElementById('supervisorWallboardKpis');
    const callsBox = document.getElementById('supervisorWallboardCalls');
    const agentsBox = document.getElementById('supervisorWallboardAgents');
    if (!kpis || !callsBox || !agentsBox) return;

    kpis.innerHTML = [
        [online, 'Online Agents'],
        [available, 'Available'],
        [onCall, 'On Call'],
        [waiting, 'Calls Waiting']
    ].map(([value, label]) =>
        `<div class="tl-card"><div class="tl-kpi-value">${value}</div><div class="tl-kpi-label">${label}</div></div>`
    ).join('');

    callsBox.innerHTML = callsLive.length ? callsLive.map(c => {
        const id = String(c.id || '');
        const start = c.start_time ? new Date(c.start_time) : null;
        const seconds = start && !Number.isNaN(start.getTime())
            ? Math.max(0, Math.floor((Date.now() - start.getTime()) / 1000)) : null;
        const duration = seconds === null ? 'Duration unavailable'
            : `${Math.floor(seconds / 60)}m ${String(seconds % 60).padStart(2, '0')}s`;
        return `<div class="supervisor-wallboard-item">
            <div style="min-width:0;overflow-wrap:anywhere">
                <strong>${esc(c.agent_name || 'Unassigned call')}</strong>
                <small>${esc(c.from_number || '—')} → ${esc(c.to_number || '—')}</small>
                <small>${esc(c.queue_name || 'No queue')} · ${esc(c.direction || '—')} · ${esc(duration)}</small>
            </div>
            <button type="button" class="tl-btn secondary"
                onclick="monitorCall('${esc(id)}','listen')">Listen</button>
        </div>`;
    }).join('') : '<p>No active calls right now.</p>';

    agentsBox.innerHTML = agents.length ? agents.map(a => {
        const status = statusOf(a);
        const name = a.full_name || a.name || a.username || 'Unnamed agent';
        const skills = list(a.skills_json).join(', ');
        return `<div class="supervisor-wallboard-item">
            <div style="min-width:0;overflow-wrap:anywhere">
                <strong>${esc(name)}</strong>
                <small>${esc(a.queue_name || 'No queue')} · ${esc(skills || 'No skills listed')}</small>
            </div>
            <span class="tl-status-pill status-${esc(status)}">${esc(status.replace(/_/g, ' '))}</span>
        </div>`;
    }).join('') : '<p>No agent data returned.</p>';

    const updated = document.getElementById('supervisorWallboardUpdated');
    if (updated) updated.textContent = 'Last updated: ' + new Date().toLocaleTimeString();
}

async function refresh() {
    const queueId = document.getElementById('filterQueue').value;
    const campaignId = document.getElementById('filterCampaign').value;
    const skill = document.getElementById('filterSkill').value;

    const callsQs = new URLSearchParams();
    if (queueId) callsQs.set('queue_id', queueId);
    if (campaignId) callsQs.set('campaign_id', campaignId);

    const [agents, queuesLive, callsLive] = await Promise.all([
        fetch('/api/v1/reports/agents/live').then(r => r.json()),
        fetch('/api/v1/reports/queues/live').then(r => r.json()),
        fetch('/api/v1/reports/calls/live?' + callsQs.toString()).then(r => r.json()),
    ]);
    allAgents = agents;
    renderSupervisorWallboard(agents, queuesLive, callsLive);
    fillSkillFilter();

    const filteredAgents = skill ? agents.filter(a => (a.skills_json || []).includes(skill)) : agents;

    const counts = { available: 0, on_call: 0, break: 0, offline: 0 };
    filteredAgents.forEach(a => {
        const s = a.status || 'offline';
        if (s === 'available') counts.available++;
        else if (['break','lunch','tea','training','meeting','personal_break'].includes(s)) counts.break++;
        else if (s === 'offline' || s === 'logout') counts.offline++;
        else counts.on_call++;
    });

    document.getElementById('tiles').innerHTML = `
        <div class="tl-card"><div class="tl-kpi-value">${filteredAgents.length}</div><div class="tl-kpi-label">Logged-in Agents</div></div>
        <div class="tl-card"><div class="tl-kpi-value">${counts.available}</div><div class="tl-kpi-label">Available</div></div>
        <div class="tl-card"><div class="tl-kpi-value">${counts.on_call}</div><div class="tl-kpi-label">On Call / Chat</div></div>
        <div class="tl-card"><div class="tl-kpi-value">${counts.break}</div><div class="tl-kpi-label">On Break</div></div>
        <div class="tl-card"><div class="tl-kpi-value">${callsLive.length}</div><div class="tl-kpi-label">Active Calls</div></div>
    `;

    document.getElementById('callsTable').innerHTML = '<tr><th>Call</th><th>Agent</th><th>Queue</th><th>Campaign</th><th>Direction</th><th>Status</th><th>Since</th><th>Monitor</th></tr>' +
        callsLive.map(c => `<tr>
            <td><code>${c.id.slice(0,8)}</code></td>
            <td>${c.agent_name || '—'}</td><td>${c.queue_name || '—'}</td><td>${c.campaign_name || '—'}</td>
            <td>${c.direction}</td><td><span class="tl-status-pill status-on_call">${c.status}</span></td>
            <td>${new Date(c.start_time).toLocaleTimeString()}</td>
            <td>
                <button class="tl-btn secondary" style="padding:4px 8px;font-size:11px" onclick="monitorCall('${c.id}','listen')">Listen</button>
                <button class="tl-btn secondary" style="padding:4px 8px;font-size:11px" onclick="monitorCall('${c.id}','whisper')">Whisper</button>
                <button class="tl-btn warn" style="padding:4px 8px;font-size:11px" onclick="monitorCall('${c.id}','barge')">Barge</button>
            </td>
        </tr>`).join('') || '<tr><td colspan="8">No active calls right now.</td></tr>';

    document.getElementById('agentTable').innerHTML = '<tr><th>Agent</th><th>Status</th><th>Queue</th><th>Skills</th><th>Since</th></tr>' +
        filteredAgents.map(a => `<tr><td>${a.full_name}</td><td><span class="tl-status-pill status-${a.status || 'offline'}">${a.status || 'offline'}</span></td><td>${a.queue_name || '—'}</td><td>${(a.skills_json||[]).join(', ') || '—'}</td><td>${a.started_at ? new Date(a.started_at).toLocaleTimeString() : '—'}</td></tr>`).join('');

    document.getElementById('queueTable').innerHTML = '<tr><th>Queue</th><th>Calls Waiting</th><th>Longest Wait</th></tr>' +
        queuesLive.map(q => `<tr><td>${q.name}</td><td>${q.calls_waiting}</td><td>${q.longest_wait_seconds ? q.longest_wait_seconds + 's' : '—'}</td></tr>`).join('');
}

document.getElementById('filterQueue').addEventListener('change', refresh);
document.getElementById('filterCampaign').addEventListener('change', refresh);
document.getElementById('filterSkill').addEventListener('change', refresh);
refresh();
setInterval(refresh, 10000);
</script>
