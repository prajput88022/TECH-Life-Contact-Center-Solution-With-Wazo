<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main class="tl-page">
  <h1>Pause Codes</h1>
  <p>Manage pause and break reasons for agents in this tenant.</p>

  <% if (errorMessage) { %>
    <div class="tl-card" role="alert">
      <% if (errorMessage === 'duplicate') { %>
        This code already exists for your tenant.
      <% } else { %>
        Invalid input. Check the code, label, duration, and sort order.
      <% } %>
    </div>
  <% } %>

  <section class="tl-card">
    <h2><%= editing ? 'Edit Pause Code' : 'Create Pause Code' %></h2>

    <form method="post"
      action="<%= editing ? '/admin/pause-codes/' + editing.id + '/edit' : '/admin/pause-codes/create' %>">

      <p>
        <label for="code">Code</label>
        <input id="code" name="code" maxlength="40" required
          pattern="[A-Za-z0-9][A-Za-z0-9_-]{0,39}"
          value="<%= editing ? editing.code : '' %>"
          placeholder="LUNCH">
      </p>

      <p>
        <label for="label">Label</label>
        <input id="label" name="label" maxlength="120" required
          value="<%= editing ? editing.label : '' %>"
          placeholder="Lunch Break">
      </p>

      <p>
        <label for="description">Description</label>
        <textarea id="description" name="description" maxlength="500"><%= editing ? (editing.description || '') : '' %></textarea>
      </p>

      <p>
        <label for="duration">Maximum duration (seconds, optional)</label>
        <input id="duration" type="number" name="max_duration_seconds"
          min="1" max="86400"
          value="<%= editing && editing.max_duration_seconds != null ? editing.max_duration_seconds : '' %>">
      </p>

      <p>
        <label for="sort_order">Sort order</label>
        <input id="sort_order" type="number" name="sort_order"
          min="0" max="1000000" required
          value="<%= editing ? editing.sort_order : 0 %>">
      </p>

      <p>
        <label>
          <input type="checkbox" name="is_paid"
            <%= !editing || editing.is_paid ? 'checked' : '' %>>
          Paid pause
        </label>
      </p>

      <p>
        <label>
          <input type="checkbox" name="counts_toward_productivity"
            <%= editing && editing.counts_toward_productivity ? 'checked' : '' %>>
          Counts toward productivity
        </label>
      </p>

      <button class="tl-btn" type="submit">
        <%= editing ? 'Save Changes' : 'Create Pause Code' %>
      </button>

      <% if (editing) { %>
        <a class="tl-btn" href="/admin/pause-codes">Cancel</a>
      <% } %>
    </form>
  </section>

  <section class="tl-card">
    <h2>Existing Pause Codes</h2>

    <% if (!codes.length) { %>
      <p>No pause codes have been created yet.</p>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Code</th>
            <th>Label</th>
            <th>Paid</th>
            <th>Productivity</th>
            <th>Max duration</th>
            <th>Order</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% codes.forEach(function(code) { %>
            <tr>
              <td><%= code.code %></td>
              <td><%= code.label %></td>
              <td><%= code.is_paid ? 'Yes' : 'No' %></td>
              <td><%= code.counts_toward_productivity ? 'Yes' : 'No' %></td>
              <td><%= code.max_duration_seconds == null ? 'No limit' : code.max_duration_seconds + ' sec' %></td>
              <td><%= code.sort_order %></td>
              <td><%= code.is_active ? 'Active' : 'Inactive' %></td>
              <td>
                <a class="tl-btn" href="/admin/pause-codes?edit=<%= code.id %>">Edit</a>
                <form method="post"
                  action="/admin/pause-codes/<%= code.id %>/toggle"
                  style="display:inline">
                  <button class="tl-btn" type="submit">
                    <%= code.is_active ? 'Deactivate' : 'Activate' %>
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </section>
</main>

<%- include('../partials/foot') %>
