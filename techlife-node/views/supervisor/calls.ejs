<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<h1>Call Records (CDR)</h1>
<p class="tl-subtitle">
    Call UUID and Wazo identifiers help trace calls across reports and recordings.
    <% if (isMasked) { %><span class="tl-status-pill status-break">Number masking is ON for this screen</span>
    <% } else { %><span class="tl-status-pill status-available">Number masking is OFF for this screen</span><% } %>
    Change this in <a href="/admin/privacy-settings">Admin → Privacy &amp; Number Masking</a>.
</p>

<form method="get" class="tl-filters">
    <div><label>From</label><input type="datetime-local" name="from" value="<%= from.replace(' ','T').slice(0,16) %>"></div>
    <div><label>To</label><input type="datetime-local" name="to" value="<%= to.replace(' ','T').slice(0,16) %>"></div>
    <div><button class="tl-btn" type="submit">Run</button></div>
    <div><a class="tl-btn secondary" href="/export/calls?format=csv&amp;context=supervisor&amp;from=<%= encodeURIComponent(from) %>&amp;to=<%= encodeURIComponent(to) %>">Download CDR (CSV)</a></div>
    <div><a class="tl-btn secondary" href="/export/calls?format=xlsx&amp;context=supervisor&amp;from=<%= encodeURIComponent(from) %>&amp;to=<%= encodeURIComponent(to) %>">Download CDR (Excel)</a></div>
</form>

<div style="overflow-x:auto">
<table>
<thead><tr>
    <th>Call UUID</th><th>Wazo Call ID</th><th>Wazo CDR ID</th><th>Tenant</th>
    <th>Start</th><th>Agent</th><th>Extension</th><th>Queue</th><th>Campaign</th>
    <th>From</th><th>To</th><th>Direction</th><th>Status</th>
    <th>Ring time</th><th>Answer time</th><th>End time</th>
    <th>Setup (s)</th><th>Queue wait (s)</th><th>Ring (s)</th><th>Talk (s)</th>
    <th>Hold (s)</th><th>ACW (s)</th><th>Hangup cause</th><th>Hangup by</th>
    <th>Disposition</th><th>Recording</th>
</tr></thead>
<tbody>
<% rows.forEach(r => { %>
<tr>
    <td><code title="<%= r.call_uuid %>"><%= r.short_id %></code><br><small><%= r.call_uuid %></small></td>
    <td><%= r.wazo_call_id || '—' %></td>
    <td><%= r.wazo_cdr_id ?? '—' %></td>
    <td><%= r.tenant_name || '—' %></td>
    <td><%= r.start_time || '—' %></td>
    <td><%= r.agent_name || '—' %></td>
    <td><%= r.agent_extension || '—' %></td>
    <td><%= r.queue_name || '—' %></td>
    <td><%= r.campaign_name || '—' %></td>
    <td><%= r.from_number || '—' %></td>
    <td><%= r.to_number || '—' %></td>
    <td><%= r.direction || '—' %></td>
    <td><%= r.status || '—' %></td>
    <td><%= r.ring_time || '—' %></td>
    <td><%= r.answer_time || '—' %></td>
    <td><%= r.end_time || '—' %></td>
    <td><%= r.setup_seconds ?? '—' %></td>
    <td><%= r.wait_seconds ?? '—' %></td>
    <td><%= r.ring_seconds ?? '—' %></td>
    <td><%= r.talk_seconds ?? '—' %></td>
    <td><%= r.hold_seconds ?? '—' %></td>
    <td><%= r.acw_seconds ?? '—' %></td>
    <td><%= r.hangup_cause || '—' %></td>
    <td><%= r.hangup_by || '—' %></td>
    <td><%= r.disposition_label || '—' %></td>
    <td>
        <% if (r.recording_id) { %>
            <code><%= r.recording_id %></code>
            <br><%= r.recording_downloadable ? 'Downloadable' : 'Stored' %>
            <% if (r.recording_duration_seconds != null) { %>
                <br><small><%= r.recording_duration_seconds %> s</small>
            <% } %>
        <% } else { %>—<% } %>
    </td>
</tr>
<% }) %>
<% if (rows.length === 0) { %><tr><td colspan="26">No calls in this range.</td></tr><% } %>
</tbody>
</table>
</div>
<%- include('../partials/foot') %>
