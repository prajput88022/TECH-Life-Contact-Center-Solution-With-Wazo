<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<h1>SIP Trunks</h1>
<p class="tl-subtitle">Trunks belong to whichever tenant you're currently managing (see the tenant switcher in the sidebar if you're a reseller) — they're never visible to any other tenant.</p>

<form method="post" action="/admin/trunks/create<%= typeof effectiveTenant !== 'undefined' && effectiveTenant.id !== currentUser.tenantId ? '?as_tenant=' + effectiveTenant.id : '' %>" class="tl-card">
    <div class="tl-filters">
        <div><label>Name</label><input name="name" required placeholder="Primary SIP Trunk"></div>
        <div><label>SIP Server</label><input name="sip_server" required placeholder="sip.provider.com:5060"></div>
        <div><label>Authentication</label><select name="auth_mode"><option value="ip">IP authentication</option><option value="credentials">Username/password</option></select></div>
        <div><label>SIP Username</label><input name="sip_username" autocomplete="off"></div>
        <div><label>SIP Password</label><input type="password" name="sip_password" autocomplete="new-password"></div>
        <div><label>Transport</label>
            <select name="transport"><option value="udp">UDP</option><option value="tcp">TCP</option><option value="tls">TLS</option></select>
        </div>
        <div><label>Codec</label><input name="codec" placeholder="ulaw,alaw,g729"></div>
        <div><label>Max Calls</label><input type="number" name="max_calls" placeholder="unlimited"></div>
        <div><label>Trunk Caller ID / CLI</label><input name="caller_id" maxlength="80" placeholder="e.g. your approved outbound number"></div>
    </div>
    <button class="tl-btn" type="submit">Add Trunk</button>
</form>

<h2>All Trunks</h2>
<table>
<tr>
    <th>Name</th><th>SIP Server</th><th>Transport</th>
    <th>Max Calls</th><th>Status</th><th>Wazo Provisioning</th><th>Actions</th>
</tr>
<% trunks.forEach(tr => {
    const provisionStatus = tr.provisioning_status || 'pending';
    const statusLabel = {
        pending: 'Not provisioned',
        provisioning: 'Provisioning…',
        provisioned: 'PBX trunk created',
        failed: 'Failed'
    }[provisionStatus] || provisionStatus;
%>
<tr>
    <td><%= tr.name %></td>
    <td><%= tr.sip_server || '—' %></td>
    <td><%= tr.transport %></td>
    <td><%= tr.max_calls || 'Unlimited' %></td>
    <td><%= tr.is_active ? 'Active' : 'Disabled' %></td>
    <td>
        <strong><%= statusLabel %></strong>
        <% if (tr.provisioning_error) { %>
            <div style="color:var(--tl-bad);max-width:420px;white-space:normal;overflow-wrap:anywhere">
                <%= tr.provisioning_error %>
            </div>
        <% } %>
        <% if (tr.wazo_trunk_id) { %>
            <small>Wazo trunk ID: <%= tr.wazo_trunk_id %></small>
        <% } %>
        <% if (tr.wazo_endpoint_uuid) { %>
            <br><small>Endpoint: <%= tr.wazo_endpoint_uuid %></small>
        <% } %>
        <% if (tr.wazo_outcall_id) { %>
            <br><small>Outcall ID: <%= tr.wazo_outcall_id %></small>
        <% } %>
    </td>
    <td>
        <a href="/admin/trunks?edit=<%= encodeURIComponent(tr.id) %><%= typeof effectiveTenant !== 'undefined' && effectiveTenant.id !== currentUser.tenantId ? '&as_tenant=' + encodeURIComponent(effectiveTenant.id) : '' %>">Edit</a>
        &middot;
        <form method="post"
              action="/admin/trunks/<%= encodeURIComponent(tr.id) %>/provision<%= typeof effectiveTenant !== 'undefined' && effectiveTenant.id !== currentUser.tenantId ? '?as_tenant=' + encodeURIComponent(effectiveTenant.id) : '' %>"
              style="display:inline"
              onsubmit="return confirm('Provision this trunk in the currently selected tenant’s Wazo PBX?');">
            <button type="submit"
                    class="tl-btn"
                    <%= (!tr.is_active || provisionStatus === 'provisioning') ? 'disabled' : '' %>>
                <%= provisionStatus === 'provisioned' ? 'Retry Provisioning' : 'Provision / Retry' %>
            </button>
        </form>
        &middot;
        <form method="post"
              action="/admin/trunks/<%= encodeURIComponent(tr.id) %>/delete<%= typeof effectiveTenant !== 'undefined' && effectiveTenant.id !== currentUser.tenantId ? '?as_tenant=' + encodeURIComponent(effectiveTenant.id) : '' %>"
              style="display:inline"
              onsubmit="return confirm('Delete this trunk?');">
            <button type="submit"
                    style="background:none;border:none;color:var(--tl-bad);cursor:pointer;text-decoration:underline;padding:0">Delete</button>
        </form>
    </td>
</tr>
<% }) %>
<% if (trunks.length === 0) { %>
<tr><td colspan="7">No trunks configured yet.</td></tr>
<% } %>
</table>

<% if (typeof editId !== 'undefined' && editId) {
    const tr = trunks.find(x => x.id === editId);
    if (tr) { %>
<h2>Edit Trunk — <%= tr.name %></h2>
<form method="post" action="/admin/trunks/<%= tr.id %>/edit" class="tl-card">
    <div class="tl-filters">
        <div><label>Name</label><input name="name" value="<%= tr.name %>" required></div>
        <div><label>SIP Server</label><input name="sip_server" value="<%= tr.sip_server || '' %>" required></div>
        <div><label>Authentication</label>
            <select name="auth_mode">
                <option value="ip" <%= (tr.auth_mode || 'ip') === 'ip' ? 'selected' : '' %>>IP authentication</option>
                <option value="credentials" <%= tr.auth_mode === 'credentials' ? 'selected' : '' %>>Username/password</option>
            </select>
        </div>
        <div><label>SIP Username</label><input name="sip_username" value="<%= tr.sip_username || '' %>" autocomplete="off"></div>
        <div><label>New SIP Password (leave blank to keep current)</label><input type="password" name="sip_password" autocomplete="new-password"></div>
        <div><label>Transport</label>
            <select name="transport">
                <% ['udp','tcp','tls'].forEach(tp => { %><option value="<%= tp %>" <%= tr.transport === tp ? 'selected' : '' %>><%= tp.toUpperCase() %></option><% }) %>
            </select>
        </div>
        <div><label>Codec</label><input name="codec" value="<%= tr.codec || '' %>"></div>
        <div><label>Max Calls</label><input type="number" name="max_calls" value="<%= tr.max_calls || '' %>"></div>
        <div><label>Trunk Caller ID / CLI</label><input name="caller_id" maxlength="80" value="<%= tr.caller_id || '' %>" placeholder="Approved outbound number"></div>
        <div><label>Status</label>
            <select name="is_active"><option value="1" <%= tr.is_active ? 'selected' : '' %>>Active</option><option value="0" <%= !tr.is_active ? 'selected' : '' %>>Disabled</option></select>
        </div>
    </div>
    <button class="tl-btn" type="submit">Save Changes</button>
    <a class="tl-btn secondary" href="/admin/trunks">Cancel</a>
</form>
<% } } %>
<%- include('../partials/foot') %>
