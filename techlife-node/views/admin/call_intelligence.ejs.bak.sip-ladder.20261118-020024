<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<style>
.ci-wrap { display:grid; gap:16px; }
.ci-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(155px,1fr)); gap:10px; }
.ci-stat { padding:14px; border:1px solid var(--tl-border,#ddd); border-radius:10px; min-width:0; }
.ci-stat strong { display:block; font-size:18px; margin-top:5px; overflow-wrap:anywhere; }
.ci-muted { color:var(--tl-muted,#777); font-size:13px; }
.ci-table { overflow-x:auto; }
.ci-table table { min-width:850px; }
.ci-warning { border-left:4px solid #c58b27; padding:12px 14px; }
.ci-success { border-left:4px solid #27834c; padding:12px 14px; }
.ci-error { border-left:4px solid #b83d3d; padding:12px 14px; }
.ci-form-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:14px; }
.ci-field { display:flex; flex-direction:column; gap:6px; }
.ci-field[hidden] { display:none !important; }
.ci-field label { font-weight:600; }
.ci-field input,.ci-field select { width:100%; min-height:40px; }
.ci-actions { display:flex; align-items:center; flex-wrap:wrap; gap:8px; }
.ci-actions form { display:inline-flex; margin:0; }
.ci-status { display:inline-block; padding:4px 9px; border-radius:20px; background:var(--tl-panel,#eee); font-size:12px; }
.ci-status.active { background:#d8f3df; color:#14592a; }
.ci-status.failed { background:#f8dede; color:#8b2222; }
.ci-status.stopping,.ci-status.starting { background:#fff0cb; color:#79520a; }
.ci-status.completed { background:#dceafa; color:#174f87; }
.ci-timeline { position:relative; margin:18px 0 8px 8px; padding-left:25px; border-left:2px solid var(--tl-border,#ccd); }
.ci-event { position:relative; padding:0 0 18px 12px; }
.ci-event:before { content:''; position:absolute; left:-33px; top:4px; width:12px; height:12px; border-radius:50%; background:var(--tl-blue,#3978c6); border:2px solid var(--tl-card,#fff); }
.ci-event h3 { margin:0 0 5px; font-size:15px; }
.ci-event pre { white-space:pre-wrap; overflow-wrap:anywhere; max-width:900px; padding:10px; border-radius:7px; background:var(--tl-panel,#f5f6f8); }
.ci-ladder { display:grid; gap:8px; }
.ci-ladder-row { display:grid; grid-template-columns:minmax(125px,1fr) minmax(70px,.5fr) minmax(125px,1fr) minmax(180px,1.5fr); align-items:center; gap:9px; padding:10px; border:1px solid var(--tl-border,#ddd); border-radius:8px; }
.ci-endpoint { overflow-wrap:anywhere; font-size:12px; }
.ci-arrow { text-align:center; white-space:nowrap; font-weight:700; color:var(--tl-blue,#3978c6); }
.ci-message { overflow-wrap:anywhere; font-size:13px; }
.ci-scroll { overflow-x:auto; }
.ci-pill-row { display:flex; flex-wrap:wrap; gap:7px; margin:8px 0; }
.ci-pill { border:1px solid var(--tl-border,#ddd); border-radius:20px; padding:5px 9px; font-size:12px; }
.ci-section { display:grid; gap:12px; }
.ci-details { display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); gap:9px; }
.ci-details div { padding:9px; background:var(--tl-panel,#f5f6f8); border-radius:7px; min-width:0; overflow-wrap:anywhere; }
.ci-details small { display:block; color:var(--tl-muted,#777); }
.ci-details strong { overflow-wrap:anywhere; }

.ci-flow {
    display:flex;
    align-items:stretch;
    gap:9px;
    overflow-x:auto;
    padding:8px 2px 14px;
}
.ci-flow-card {
    flex:0 0 220px;
    min-width:0;
    padding:13px;
    border:1px solid var(--tl-border,#ccd);
    border-radius:10px;
    background:var(--tl-card,#fff);
    overflow-wrap:anywhere;
}
.ci-flow-card.core {
    border:2px solid var(--tl-blue,#3978c6);
    background:var(--tl-panel,#f5f6f8);
}
.ci-flow-card.destination {
    border:1px dashed var(--tl-border,#999);
}
.ci-flow-card.missing {
    border:1px dashed #c58b27;
}
.ci-flow-kind {
    font-size:11px;
    color:var(--tl-muted,#777);
    text-transform:uppercase;
    letter-spacing:.04em;
    margin-bottom:8px;
}
.ci-flow-title {
    display:block;
    font-size:15px;
    margin-bottom:7px;
    overflow-wrap:anywhere;
}
.ci-flow-detail {
    font-size:12px;
    color:var(--tl-muted,#777);
    overflow-wrap:anywhere;
}
.ci-flow-meta {
    font-size:12px;
    margin-top:9px;
    overflow-wrap:anywhere;
}
.ci-flow-arrow {
    flex:0 0 28px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:23px;
    color:var(--tl-blue,#3978c6);
}
.ci-cel-event {
    border-left:3px solid var(--tl-blue,#3978c6);
    padding:0 0 16px 13px;
    margin-left:7px;
}
.ci-cel-event h3 {
    font-size:14px;
    margin:0 0 5px;
}
.ci-cel-event pre {
    white-space:pre-wrap;
    overflow-wrap:anywhere;
    max-width:1100px;
    padding:9px;
    border-radius:7px;
    background:var(--tl-panel,#f5f6f8);
}
.ci-cel-event details {
    margin-top:7px;
    font-size:12px;
}
.ci-cel-event summary {
    cursor:pointer;
    color:var(--tl-muted,#777);
}
.ci-cel-events {
    display:grid;
    gap:3px;
}
.ci-trace-note {
    padding:11px 13px;
    background:var(--tl-panel,#f5f6f8);
    border-radius:8px;
    color:var(--tl-muted,#777);
    font-size:13px;
}

.ci-sip-scroll {
    width:100%;
    overflow-x:auto;
    border:1px solid var(--tl-border,#ddd);
    border-radius:10px;
    background:var(--tl-card,#fff);
}
.ci-sip-ladder {
    position:relative;
    padding:12px;
}
.ci-sip-participants {
    display:grid;
    gap:8px;
    padding-bottom:14px;
}
.ci-sip-participant {
    min-width:0;
    padding:12px 8px;
    border:1px solid var(--tl-border,#ddd);
    border-radius:8px;
    background:var(--tl-panel,#f5f6f8);
    text-align:center;
    overflow-wrap:anywhere;
}
.ci-sip-participant small {
    display:block;
    color:var(--tl-muted,#777);
    font-size:11px;
    margin-bottom:5px;
}
.ci-sip-participant strong {
    font-size:13px;
}
.ci-sip-rows-wrap {
    position:relative;
}
.ci-sip-lifelines {
    position:absolute;
    inset:0;
    display:grid;
    pointer-events:none;
}
.ci-sip-lifelines span {
    justify-self:center;
    height:100%;
    border-left:1px dashed var(--tl-border,#b9bdc5);
}
.ci-sip-messages {
    position:relative;
}
.ci-sip-message-row {
    position:relative;
    padding:10px 5px 13px;
    min-height:106px;
    border-bottom:1px solid var(--tl-border,#ddd);
}
.ci-sip-message-time {
    display:flex;
    flex-wrap:wrap;
    justify-content:space-between;
    gap:8px;
    color:var(--tl-muted,#777);
    font-size:12px;
    margin-bottom:5px;
}
.ci-sip-arrow-area {
    height:47px;
    position:relative;
}
.ci-sip-arrow-area svg {
    position:absolute;
    inset:0;
    width:100%;
    height:47px;
    overflow:visible;
}
.ci-sip-arrow-label {
    position:absolute;
    top:0;
    transform:translateX(-50%);
    max-width:42%;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
    font-size:12px;
    font-weight:700;
    padding:2px 7px;
    border-radius:5px;
    background:var(--tl-card,#fff);
    border:1px solid var(--tl-border,#ddd);
}
.ci-sip-endpoints {
    display:flex;
    justify-content:space-between;
    gap:12px;
    font-size:11px;
    color:var(--tl-muted,#777);
    overflow-wrap:anywhere;
}
.ci-sip-meta {
    display:flex;
    flex-wrap:wrap;
    gap:7px 15px;
    margin-top:7px;
    font-size:12px;
    overflow-wrap:anywhere;
}
.ci-sip-raw {
    margin-top:9px;
}
.ci-sip-raw summary {
    cursor:pointer;
    color:var(--tl-blue,#3978c6);
    font-size:12px;
}

/* Dark signalling canvas matching the supplied call-flow reference. */
.ci-sip-scroll {
    background:#071321;
    border-color:#20384d;
    color:#e5f1fc;
}
.ci-sip-ladder {
    background:#071321;
    color:#e5f1fc;
}
.ci-sip-participant {
