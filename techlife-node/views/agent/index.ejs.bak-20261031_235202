<!-- CRM screen-pop panel: only shown/used when the tenant has an active
     integration with popup_mode = 'iframe_panel'. Otherwise a screen-pop
     opens a new tab/window instead, and this stays empty. -->
<div id="crmPanelWrap" style="display:none;margin-top:20px">
    <h2>Customer Record</h2>
    <iframe id="crmPanel" style="width:100%;height:600px;border:1px solid var(--tl-border);border-radius:8px" title="CRM"></iframe>
</div>

<script src="/vendor/sip.js"></script>
<script>
const AGENT_ID = <%- JSON.stringify(agentId) %>;
const AUTO_ANSWER_ENABLED = <%- JSON.stringify(inboundAutoAnswerEnabled === true) %>;
let userAgent = null;
let registerer = null;
let currentSession = null;
let isMuted = false;
let isHeld = false;
let crmConfig = null;

let inboundAlertContext = null;
let inboundAlertTimer = null;

function stopInboundRinging() {
    if (inboundAlertTimer) clearInterval(inboundAlertTimer);
    inboundAlertTimer = null;
}

function startInboundRinging() {
    stopInboundRinging();
    function ringOnce() {
        try {
            const AC = window.AudioContext || window.webkitAudioContext;
            if (!AC) return;
            if (!inboundAlertContext) inboundAlertContext = new AC();
            const c = inboundAlertContext;
            if (c.state === 'suspended') c.resume().catch(() => {});
            const o = c.createOscillator();
            const g = c.createGain();
            o.frequency.value = 440;
            g.gain.setValueAtTime(0.06, c.currentTime);
            g.gain.exponentialRampToValueAtTime(0.001, c.currentTime + 0.3);
            o.connect(g); g.connect(c.destination);
            o.start(); o.stop(c.currentTime + 0.31);
        } catch (e) { console.warn('Ring audio unavailable', e); }
    }
    ringOnce();
    inboundAlertTimer = setInterval(ringOnce, 1400);
}


// ---------------- Agent status ----------------
async function loadStatus() {
    const res = await fetch(`/api/v1/agents/${AGENT_ID}/status`).then(r => r.json());
    const el = document.getElementById('currentStatus');
    el.textContent = res.status || 'offline';
    el.className = 'tl-status-pill status-' + (res.status || 'offline');
    document.querySelectorAll('#statusButtons button').forEach(b => b.classList.toggle('active', b.dataset.status === res.status));
}
async function setStatus(status) {
    const pauseStatuses = [
        'break','lunch','tea','training','meeting',
        'system_issue','personal_break','custom'
    ];
    const reason_code = pauseStatuses.includes(status)
        ? document.getElementById('pauseReason').value
        : null;

    if (pauseStatuses.includes(status) && !reason_code) {
        alert('Select an active pause reason configured by your administrator.');
        return;
    }

    try {
        const response = await fetch(`/api/v1/agents/${AGENT_ID}/status`, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ status, reason_code })
        });
        const result = await response.json().catch(() => ({}));

        if (!response.ok) {
            alert(result.message || result.error || 'Unable to change agent status.');
            return;
        }

        await loadStatus();
    } catch (error) {
        console.error('Agent status update failed:', error);
        alert('Unable to update agent status. Please retry.');
    }
}
loadStatus();

// ---------------- CRM Screen-Pop / CTI ----------------
async function loadCrmConfig() {
    try {
        const res = await fetch('/api/v1/crm/config');
        if (res.ok) crmConfig = await res.json();
    } catch (e) { console.warn('CRM config unavailable', e); }
}
loadCrmConfig();

let customerLookupToken = 0;

function setCustomerText(id, value) {
    const el = document.getElementById(id);
    if (el) el.textContent =
        value === null || value === undefined || String(value).trim() === ''
            ? '—' : String(value);
}

function clearCustomerProfile() {
    [
        'customerProfileId', 'customerProfileName', 'customerProfilePhone',
        'customerProfileAltPhone', 'customerProfileEmail',
        'customerProfileAddress', 'customerProfileComments'
    ].forEach(id => setCustomerText(id, '—'));

    const body = document.getElementById('customerHistoryBody');
    body.replaceChildren();
    const row = document.createElement('tr');
    const cell = document.createElement('td');
    cell.colSpan = 6;
    cell.textContent = 'Loading conversation history…';
    row.appendChild(cell);
    body.appendChild(row);
}

function renderCustomerProfile(data) {
    const contact = data.contact || {};
    setCustomerText('customerProfileId', contact.external_customer_id || contact.id);
    setCustomerText('customerProfileName', contact.full_name);
    setCustomerText('customerProfilePhone', contact.primary_phone);
    setCustomerText('customerProfileAltPhone', contact.alt_phone);
    setCustomerText('customerProfileEmail', contact.email);

    const address = [
        contact.address_line1, contact.address_line2, contact.city,
        contact.state, contact.postal_code, contact.country
    ].filter(Boolean).join(', ');
    setCustomerText('customerProfileAddress', address);
    setCustomerText('customerProfileComments', contact.comments);
    setCustomerText('customerProfileStatus', 'Customer record matched.');

    const body = document.getElementById('customerHistoryBody');
    body.replaceChildren();

    const history = Array.isArray(data.history) ? data.history : [];
    if (!history.length) {
        const row = document.createElement('tr');
        const cell = document.createElement('td');
        cell.colSpan = 6;
        cell.textContent = 'No previous conversations found.';
        row.appendChild(cell);
        body.appendChild(row);
        return;
    }

    history.forEach(call => {
        const row = document.createElement('tr');
        const time = call.start_time ? new Date(call.start_time).toLocaleString() : '—';
        const values = [
            time,
            call.direction,
            call.campaign_name,
            call.queue_name,
            call.status,
            call.talk_seconds
        ];

        values.forEach(value => {
            const cell = document.createElement('td');
            cell.textContent = value === null || value === undefined || value === ''
                ? '—' : String(value);
            row.appendChild(cell);
        });
        body.appendChild(row);
    });
}

async function loadCustomerProfile(phone) {
    const token = ++customerLookupToken;
    const wrap = document.getElementById('customerProfileWrap');
    const status = document.getElementById('customerProfileStatus');

    wrap.style.display = 'block';
    clearCustomerProfile();

    if (!phone) {
        status.textContent = 'Caller number is unavailable.';
        return;
    }

    status.textContent = 'Looking up customer…';

    for (let attempt = 0; attempt < 3; attempt++) {
        if (token !== customerLookupToken) return;

        try {
            const query = new URLSearchParams({ phone: String(phone) });
            const response = await fetch('/api/v1/contacts/lookup?' + query.toString(), {
                headers: { 'Accept': 'application/json' }
            });
            const result = await response.json().catch(() => ({}));

            if (token !== customerLookupToken) return;

            if (!response.ok) {
                status.textContent = result.error === 'forbidden'
                    ? 'Customer lookup is not permitted for this account.'
                    : 'Customer lookup is temporarily unavailable.';
                return;
            }

            if (result.found && result.contact) {
                renderCustomerProfile(result);
                return;
            }

            if (attempt < 2) {
                await new Promise(resolve => window.setTimeout(resolve, 500));
            }
        } catch (err) {
            if (token !== customerLookupToken) return;
            if (attempt === 2) {
                status.textContent = 'Customer lookup is temporarily unavailable.';
                console.warn('Customer profile lookup failed:', err);
                return;
            }
            await new Promise(resolve => window.setTimeout(resolve, 500));
        }
    }

    if (token === customerLookupToken) {
        status.textContent =
            'No matching customer record found yet. A new inbound contact may not have been stored.';
        const body = document.getElementById('customerHistoryBody');
        body.replaceChildren();
        const row = document.createElement('tr');
        const cell = document.createElement('td');
        cell.colSpan = 6;
        cell.textContent = 'No history available.';
        row.appendChild(cell);
        body.appendChild(row);
    }
}

function buildCrmUrl(template, callData) {
    return template
        .replace('{customer_number}', encodeURIComponent(callData.customer_number || ''))
        .replace('{call_id}', encodeURIComponent(callData.call_id || ''))
        .replace('{agent_extension}', encodeURIComponent(callData.agent_extension || ''))
        .replace('{direction}', encodeURIComponent(callData.direction || ''))
        .replace('{queue_name}', encodeURIComponent(callData.queue_name || ''))
        .replace('{campaign_name}', encodeURIComponent(callData.campaign_name || ''))
        .replace('{disposition_code}', encodeURIComponent(callData.disposition_code || ''));
}

function fireCrmScreenPop(callData) {
    if (!crmConfig || !crmConfig.popup_enabled || !crmConfig.url_template) return;
    const url = buildCrmUrl(crmConfig.url_template, callData);

    switch (crmConfig.popup_mode) {
        case 'new_tab':
            window.open(url, '_blank');
            break;
        case 'popup_window':
            window.open(url, 'crm_popup', 'width=900,height=700,noopener');
            break;
        case 'iframe_panel':
            document.getElementById('crmPanelWrap').style.display = 'block';
            document.getElementById('crmPanel').src = url;
            break;
        case 'postmessage':
            // For when this agent screen is itself embedded inside the
            // CRM's own frame -- let the CRM (parent) handle the pop.
            if (window.parent) {
                window.parent.postMessage({ type: 'techlife_screen_pop', url, callData }, '*');
            }
            break;
    }
}

// ---------------- SIP.js WebRTC registration ----------------
function setRegStatus(text, statusClass) {
    const el = document.getElementById('sipRegStatus');
    el.textContent = text;
    el.className = 'tl-status-pill ' + statusClass;
}

async function initSip() {
    setRegStatus('fetching credentials…', 'status-break');
    let creds;
    try {
        const res = await fetch(`/api/v1/agents/${AGENT_ID}/sip-credentials`);
        if (!res.ok) {
            const err = await res.json();
            setRegStatus(err.error === 'not_provisioned' ? 'line not provisioned' : 'error', 'status-offline');
            return;
        }
        creds = await res.json();
    } catch (e) {
        setRegStatus('cannot reach server', 'status-offline');
        return;
    }

    const { UserAgent, Registerer } = SIP;

    if (!creds.sip_uri_user) {
        setRegStatus('SIP line identity missing', 'status-offline');
        return;
    }

    const uri = UserAgent.makeURI(`sip:${creds.sip_uri_user}@${creds.sip_domain}`);
    if (!uri) {
        setRegStatus('Invalid SIP line URI', 'status-offline');
        return;
    }

    userAgent = new UserAgent({
        uri,
        transportOptions: { server: creds.ws_uri },
        authorizationUsername: creds.sip_username,
        authorizationPassword: creds.sip_password,
        displayName: <%- JSON.stringify(fullName) %>,
    });

    userAgent.delegate = {
        onInvite: (invitation) => {
            if (currentSession && currentSession.state !== SIP.SessionState.Terminated) {
                invitation.reject().catch(() => {});
                return;
            }

            currentSession = invitation;
            wireSessionEvents(invitation);

            const callerNumber = invitation.remoteIdentity && invitation.remoteIdentity.uri
                ? invitation.remoteIdentity.uri.user : null;

            document.getElementById('incomingCallFrom').textContent = callerNumber || 'Unknown caller';
            document.getElementById('incomingCallPanel').style.display = 'block';
            document.getElementById('callState').textContent = AUTO_ANSWER_ENABLED
                ? 'Auto-answer enabled — connecting…'
                : 'Incoming call — please answer.';

            loadCustomerProfile(callerNumber);

            if (crmConfig && crmConfig.trigger_event === 'ringing') {
                fireCrmScreenPop({ customer_number: callerNumber, direction: 'inbound', agent_extension: creds.extension });
            }

            startInboundRinging();
            if (AUTO_ANSWER_ENABLED) answerIncomingCall();
        },
    };

    try {
        await userAgent.start();
        registerer = new Registerer(userAgent);
        await registerer.register();
        setRegStatus(`registered as ${creds.extension}`, 'status-available');
    } catch (e) {
        console.error(e);
        setRegStatus('registration failed', 'status-offline');
    }
}

async function answerIncomingCall() {
    const invitation = currentSession;
    if (!invitation) return;

    stopInboundRinging();
    document.getElementById('incomingCallPanel').style.display = 'none';
    document.getElementById('callState').textContent = 'Answering…';

    try {
        await invitation.accept({
            sessionDescriptionHandlerOptions: {
                constraints: { audio: true, video: false }
            }
        });
        showInCallUI();
    } catch (err) {
        console.error('Could not answer incoming Agent call:', err);
        document.getElementById('callState').textContent = 'Could not answer call';
    }
}

async function rejectIncomingCall() {
    const invitation = currentSession;
    if (!invitation) return;

    stopInboundRinging();
    document.getElementById('incomingCallPanel').style.display = 'none';

    try {
        await invitation.reject();
    } catch (err) {
        console.warn('Could not reject incoming Agent call:', err);
    }
}

function wireSessionEvents(session) {
    const { SessionState } = SIP;
    session.stateChange.addListener((state) => {
        if (state === SessionState.Established) {
            stopRingback();
            document.getElementById('callState').textContent = 'In call';
            attachRemoteAudio(session);
            showInCallUI();

            const remoteNumber = session.remoteIdentity && session.remoteIdentity.uri ? session.remoteIdentity.uri.user : null;
            document.getElementById('callStatusCard').style.display = 'block';
            document.getElementById('callStatusState').textContent = 'In Call';
            document.getElementById('callStatusWho').textContent = remoteNumber || 'Unknown';
            document.getElementById('callStatusNum').textContent = remoteNumber || '';

            // 'answered'-mode CRM screen-pop fires once the call actually connects.
            if (crmConfig && crmConfig.trigger_event === 'answered') {
                fireCrmScreenPop({ customer_number: remoteNumber, direction: 'unknown' });
            }
        } else if (state === SessionState.Terminated) {
            stopRingback();
            document.getElementById('callState').textContent = 'Idle';
            document.getElementById('callStatusCard').style.display = 'none';
            currentSession = null;
            showIdleUI();
        }
    });
}

function attachRemoteAudio(session) {
    const remoteStream = new MediaStream();
    const pc = session.sessionDescriptionHandler.peerConnection;
    pc.getReceivers().forEach((receiver) => { if (receiver.track) remoteStream.addTrack(receiver.track); });
    document.getElementById('remoteAudio').srcObject = remoteStream;
}

function showInCallUI() {
    document.getElementById('callBtn').style.display = 'none';
    document.getElementById('hangupBtn').style.display = 'block';
}
function showIdleUI() {
    document.getElementById('callBtn').style.display = 'block';
    document.getElementById('hangupBtn').style.display = 'none';
    document.getElementById('callStatusCard').style.display = 'none';
    isMuted = false; isHeld = false;
    document.getElementById('muteBtn').classList.remove('active');
    document.getElementById('holdBtn').classList.remove('active');
}

// Local audible keypad feedback; SIP DTMF is still sent separately via RTP.
function playLocalKeyTone(key) {
    try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();

        const frequencies = {
            '1':[697,1209], '2':[697,1336], '3':[697,1477],
            '4':[770,1209], '5':[770,1336], '6':[770,1477],
            '7':[852,1209], '8':[852,1336], '9':[852,1477],
            '*':[941,1209], '0':[941,1336], '#':[941,1477]
        };
        const pair = frequencies[key];
        if (!pair) return;

        const gain = audioCtx.createGain();
        gain.gain.setValueAtTime(0.0001, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.12, audioCtx.currentTime + 0.015);
        gain.gain.setValueAtTime(0.12, audioCtx.currentTime + 0.10);
        gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.16);
        gain.connect(audioCtx.destination);

        pair.forEach((frequency) => {
            const oscillator = audioCtx.createOscillator();
            oscillator.frequency.value = frequency;
            oscillator.connect(gain);
            oscillator.start();
            oscillator.stop(audioCtx.currentTime + 0.17);
        });
        setTimeout(() => { try { gain.disconnect(); } catch (_) {} }, 250);
    } catch (e) {
        console.warn('Local keypad tone unavailable:', e);
    }
}

let ringbackTimer = null;
let ringbackSecondBurst = null;
let ringbackNodes = [];

function ringbackBurst() {
    try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();

        const gain = audioCtx.createGain();
        gain.gain.value = 0.07;
        gain.connect(audioCtx.destination);
        ringbackNodes.push(gain);

        [400, 450].forEach((frequency) => {
            const oscillator = audioCtx.createOscillator();
            oscillator.frequency.value = frequency;
            oscillator.connect(gain);
            oscillator.start();
            oscillator.stop(audioCtx.currentTime + 0.38);
            ringbackNodes.push(oscillator);
        });
        setTimeout(() => {
            try { gain.disconnect(); } catch (_) {}
            ringbackNodes = ringbackNodes.filter((node) => node !== gain);
        }, 500);
    } catch (e) {
        console.warn('Local ringback unavailable:', e);
    }
}

function startRingback() {
    stopRingback();
    ringbackBurst();
    ringbackSecondBurst = setTimeout(ringbackBurst, 600);
    ringbackTimer = setInterval(() => {
        ringbackBurst();
        ringbackSecondBurst = setTimeout(ringbackBurst, 600);
    }, 3000);
}

function stopRingback() {
    if (ringbackTimer !== null) clearInterval(ringbackTimer);
    if (ringbackSecondBurst !== null) clearTimeout(ringbackSecondBurst);
    ringbackTimer = null;
    ringbackSecondBurst = null;
    ringbackNodes.forEach((node) => {
        try { node.stop(); } catch (_) {}
        try { node.disconnect(); } catch (_) {}
    });
    ringbackNodes = [];
}

function dtmfOrDial(key) {
    playLocalKeyTone(key);

    if (currentSession && currentSession.state === SIP.SessionState.Established) {
        const sent = currentSession.sessionDescriptionHandler.sendDtmf(key);
        if (!sent) console.warn('RTP DTMF could not be sent for key:', key);
    } else {
        document.getElementById('dialInput').value += key;
    }
}

async function placeCall() {
    if (!userAgent) {
        alert('Phone is not registered yet.');
        return;
    }

    const number = document.getElementById('dialInput').value.trim();
    if (!number) return;

    try {
        const response = await fetch('/api/v1/dnd/check', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ phone_number: number })
        });

        const result = await response.json().catch(() => ({}));

        if (!response.ok || result.allowed !== true) {
            alert(result.message ||
                (result.error === 'do_not_call'
                    ? 'This number is on the Do Not Call list.'
                    : 'Unable to verify the Do Not Call list. Call blocked.'));
            return;
        }
    } catch (err) {
        console.error('DND preflight failed:', err);
        alert('Unable to verify the Do Not Call list. Call blocked.');
        return;
    }

    const cfgDomain = userAgent.configuration.uri.host;
    const target = SIP.UserAgent.makeURI(`sip:${number}@${cfgDomain}`);

    if (!target) {
        alert('Invalid destination number.');
        return;
    }

    const inviter = new SIP.Inviter(userAgent, target, {
        sessionDescriptionHandlerOptions: {
            constraints: { audio: true, video: false }
        }
    });

    currentSession = inviter;
    wireSessionEvents(inviter);
    document.getElementById('callState').textContent = 'Calling ' + number + '…';
    showInCallUI();
    startRingback();

    try {
        await inviter.invite();
    } catch (e) {
        stopRingback();
        console.error(e);
        document.getElementById('callState').textContent = 'Call failed';
        showIdleUI();
    }
}

function hangupCall() {
    stopRingback();
    if (!currentSession) return;
    const { SessionState } = SIP;
    if (currentSession.state === SessionState.Established) currentSession.bye();
    else if (currentSession.state === SessionState.Establishing) currentSession.cancel();
    else currentSession.reject && currentSession.reject();
    showIdleUI();
}

// ---------------- Transfer (blind + attended) ----------------
// Uses SIP.js's documented Session.refer() -- sends a real SIP REFER.
// Blind transfer: refer() with just a target URI.
// Attended transfer: dial the transfer target as a second session, and
// once it's answered, refer() the ORIGINAL session's call to that
// second SESSION (not just its URI) -- SIP.js sends this as a REFER
// with a Replaces header, which is the standard mechanism a PBX (Wazo/
// Asterisk) uses to complete an attended transfer.
let transferMode = null;
let secondSession = null;

function showTransferBox(mode) {
    if (!currentSession || currentSession.state !== SIP.SessionState.Established) {
        alert('You need an active call to transfer.');
        return;
    }
    transferMode = mode;
    document.getElementById('transferBox').style.display = 'block';
    document.getElementById('transferBoxLabel').textContent = mode === 'blind' ? 'Blind transfer to' : 'Attended transfer to';
    document.getElementById('transferGoBtn').textContent = mode === 'blind' ? 'Transfer' : 'Call Target';
}

function cancelTransfer() {
    if (secondSession) {
        try { secondSession.bye ? secondSession.bye() : secondSession.cancel(); } catch (e) { /* already ended */ }
        secondSession = null;
    }
    document.getElementById('transferBox').style.display = 'none';
    document.getElementById('attendedTransferState').style.display = 'none';
    document.getElementById('transferTarget').value = '';
    document.getElementById('transferGoBtn').textContent = transferMode === 'blind' ? 'Transfer' : 'Call Target';
}

async function doTransfer() {
    const target = document.getElementById('transferTarget').value.trim();
    if (!target) return;
    const domain = userAgent.configuration.uri.host;
    const targetUri = SIP.UserAgent.makeURI(`sip:${target}@${domain}`);

    if (transferMode === 'blind') {
        try {
            await currentSession.refer(targetUri);
            document.getElementById('callState').textContent = 'Transferred — call will end shortly';
        } catch (e) {
            alert('Blind transfer failed: ' + e.message);
        }
        cancelTransfer();
        return;
    }

    // Attended: first click dials the target; second click (button now
    // reads "Complete Transfer") merges the two.
    if (!secondSession) {
        const inviter = new SIP.Inviter(userAgent, targetUri, {
            sessionDescriptionHandlerOptions: { constraints: { audio: true, video: false } },
        });
        secondSession = inviter;
        secondSession.stateChange.addListener((state) => {
            if (state === SIP.SessionState.Established) {
                document.getElementById('attendedTransferState').style.display = 'block';
                document.getElementById('attendedTransferState').textContent = 'Connected to transfer target — click Complete Transfer to connect them with the caller.';
                document.getElementById('transferGoBtn').textContent = 'Complete Transfer';
            } else if (state === SIP.SessionState.Terminated) {
                secondSession = null;
                cancelTransfer();
            }
        });
        document.getElementById('attendedTransferState').style.display = 'block';
        document.getElementById('attendedTransferState').textContent = 'Calling transfer target…';
        try { await inviter.invite(); } catch (e) { alert('Could not reach transfer target: ' + e.message); secondSession = null; }
        return;
    }

    // Second click: complete the attended transfer.
    try {
        await currentSession.refer(secondSession);
        document.getElementById('callState').textContent = 'Attended transfer complete — call will end shortly';
    } catch (e) {
        alert('Completing transfer failed: ' + e.message);
    }
    cancelTransfer();
}

// ---------------- Conference (client-side audio mix) ----------------
// NOTE: this is a best-effort BROWSER-SIDE mix using the Web Audio API
// -- it works for a basic 3-way call, but for production call quality
// at scale, a server-side conference bridge (Asterisk ConfBridge, which
// Wazo can expose via its meeting/conference APIs) is the correct
// approach. This client-side version has not been tested against real
// audio hardware/network conditions from this sandbox.
let audioCtx = null;
async function addToConference() {
    const target = prompt('Extension or number to add to the conference:');
    if (!target || !currentSession || currentSession.state !== SIP.SessionState.Established) return;

    const domain = userAgent.configuration.uri.host;
    const targetUri = SIP.UserAgent.makeURI(`sip:${target}@${domain}`);
    const inviter = new SIP.Inviter(userAgent, targetUri, {
        sessionDescriptionHandlerOptions: { constraints: { audio: true, video: false } },
    });

    inviter.stateChange.addListener((state) => {
        if (state !== SIP.SessionState.Established) return;
        mixConference(currentSession, inviter);
    });
    document.getElementById('callState').textContent = 'Adding to conference…';
    try { await inviter.invite(); } catch (e) { alert('Could not add to conference: ' + e.message); }
}

function remoteStreamOf(session) {
    const stream = new MediaStream();
    session.sessionDescriptionHandler.peerConnection.getReceivers().forEach((r) => { if (r.track) stream.addTrack(r.track); });
    return stream;
}

async function mixConference(sessionA, sessionB) {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    const micStream = await navigator.mediaDevices.getUserMedia({ audio: true });

    const remoteA = remoteStreamOf(sessionA);
    const remoteB = remoteStreamOf(sessionB);
    const srcMic = audioCtx.createMediaStreamSource(micStream);
    const srcA = audioCtx.createMediaStreamSource(remoteA);
    const srcB = audioCtx.createMediaStreamSource(remoteB);

    // What THIS agent hears: mic is not looped back to self, just A + B.
    const localMix = audioCtx.createMediaStreamDestination();
    srcA.connect(localMix); srcB.connect(localMix);
    document.getElementById('remoteAudio').srcObject = localMix.stream;

    // What A hears: mic + B (not A's own voice).
    const mixToA = audioCtx.createMediaStreamDestination();
    srcMic.connect(mixToA); srcB.connect(mixToA);
    const senderA = sessionA.sessionDescriptionHandler.peerConnection.getSenders().find((s) => s.track && s.track.kind === 'audio');
    if (senderA) senderA.replaceTrack(mixToA.stream.getAudioTracks()[0]);

    // What B hears: mic + A (not B's own voice).
    const mixToB = audioCtx.createMediaStreamDestination();
    srcMic.connect(mixToB); srcA.connect(mixToB);
    const senderB = sessionB.sessionDescriptionHandler.peerConnection.getSenders().find((s) => s.track && s.track.kind === 'audio');
    if (senderB) senderB.replaceTrack(mixToB.stream.getAudioTracks()[0]);

    secondSession = sessionB;
    document.getElementById('callState').textContent = '3-way conference active (beta)';
}

function toggleMute() {
    if (!currentSession) return;
    const pc = currentSession.sessionDescriptionHandler.peerConnection;
    isMuted = !isMuted;
    pc.getSenders().forEach((sender) => { if (sender.track) sender.track.enabled = !isMuted; });
    document.getElementById('muteBtn').classList.toggle('active', isMuted);
}

async function toggleHold() {
    if (!currentSession) return;
    isHeld = !isHeld;
    try {
        await currentSession.invite({ sessionDescriptionHandlerOptions: { hold: isHeld } });
        document.getElementById('holdBtn').classList.toggle('active', isHeld);
        document.getElementById('callState').textContent = isHeld ? 'On hold' : 'In call';
    } catch (e) { console.error('hold toggle failed', e); }
}


// ---------------- Completed calls and disposition ----------------
let completedDispositionCalls = [];

function dispositionPhoneIsValid(call) {
    const digits = String(call && call.phone_number || '').replace(/\D/g, '');
    return digits.length >= 7 && digits.length <= 15;
}

function selectedDispositionCall() {
    const id = document.getElementById('dispositionCall').value;
    return completedDispositionCalls.find(call => call.id === id) || null;
}

function updateDispositionFields() {
    const code = document.getElementById('dispositionCode').value;
    const call = selectedDispositionCall();
    const validPhone = dispositionPhoneIsValid(call);

    document.getElementById('callbackAtRow').style.display =
        code === 'FOLLOW_UP' ? 'block' : 'none';
    document.getElementById('dndScopeRow').style.display =
        code === 'DND' ? 'block' : 'none';

    const callback = document.getElementById('callbackAt');
    callback.required = code === 'FOLLOW_UP';

    for (const option of document.getElementById('dispositionCode').options) {
        if (option.value === 'DND' || option.value === 'FOLLOW_UP') {
            option.disabled = !!call && !validPhone;
        }
    }

    const info = document.getElementById('dispositionCallInfo');
    if (!call) {
        info.textContent = 'Select a completed call to continue.';
    } else {
        const when = call.end_time ? new Date(call.end_time).toLocaleString() : 'time unavailable';
        const phone = String(call.phone_number || 'Unknown number');
        info.textContent = `${call.direction || 'Call'} · ${phone} · Ended ${when}` +
            (call.disposition_code ? ` · Current: ${call.disposition_code}` : '') +
            (!validPhone
                ? ' · This record has no valid phone number; DND and callback are unavailable.'
                : '');
    }
}

async function loadCompletedDispositionCalls() {
    const select = document.getElementById('dispositionCall');
    const previousId = select.value;
    const message = document.getElementById('dispositionMessage');

    try {
        const response = await fetch(`/api/v1/agents/${encodeURIComponent(AGENT_ID)}/completed-calls`,
            { headers: { 'Accept': 'application/json' } });
        const data = await response.json();

        if (!response.ok) {
            throw new Error(data.error || 'Could not load completed calls.');
        }

        completedDispositionCalls = Array.isArray(data.results) ? data.results : [];
        select.replaceChildren();

        if (!completedDispositionCalls.length) {
            const option = document.createElement('option');
            option.value = '';
            option.textContent = 'No completed calls found';
            select.appendChild(option);
        } else {
            for (const call of completedDispositionCalls) {
                const option = document.createElement('option');
                option.value = call.id;
                const when = call.end_time ? new Date(call.end_time).toLocaleString() : 'time unavailable';
                option.textContent =
                    `${call.direction || 'Call'} · ${call.phone_number || 'Unknown number'} · ${when}` +
                    (call.disposition_code ? ` · ${call.disposition_code}` : '');
                select.appendChild(option);
            }
            if (completedDispositionCalls.some(call => call.id === previousId)) {
                select.value = previousId;
            }
        }

        updateDispositionFields();
    } catch (err) {
        console.error('Completed-call list failed:', err);
        message.textContent = err.message || 'Could not load completed calls.';
    }
}

document.getElementById('dispositionCall').addEventListener('change', updateDispositionFields);
document.getElementById('dispositionCode').addEventListener('change', updateDispositionFields);
document.getElementById('refreshDispositionCalls').addEventListener('click', loadCompletedDispositionCalls);

document.getElementById('dispositionForm').addEventListener('submit', async (event) => {
    event.preventDefault();

    const call = selectedDispositionCall();
    const code = document.getElementById('dispositionCode').value;
    const message = document.getElementById('dispositionMessage');
    const button = document.getElementById('saveDispositionBtn');

    if (!call) {
        message.textContent = 'Select a completed call first.';
        return;
    }
    if (!code) {
        message.textContent = 'Select a disposition.';
        return;
    }
    if ((code === 'DND' || code === 'FOLLOW_UP') && !dispositionPhoneIsValid(call)) {
        message.textContent = 'This call has no valid phone number.';
        return;
    }

    let callbackAt = null;
    if (code === 'FOLLOW_UP') {
        const value = document.getElementById('callbackAt').value;
        callbackAt = value ? new Date(value) : null;
        if (!callbackAt || Number.isNaN(callbackAt.getTime()) || callbackAt <= new Date()) {
            message.textContent = 'Choose a future callback date and time.';
            return;
        }
    }

    button.disabled = true;
    message.textContent = 'Saving…';

    try {
        const response = await fetch(`/api/v1/agents/${encodeURIComponent(AGENT_ID)}/disposition`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({
                call_id: call.id,
                code,
                notes: document.getElementById('dispositionNotes').value,
                callback_at: callbackAt ? callbackAt.toISOString() : null,
                dnc_scope: document.getElementById('dndScope').value
            })
        });

        const result = await response.json();
        if (!response.ok) {
            const messages = {
                call_not_completed: 'This call is not completed yet. Refresh and try again.',
                call_has_no_valid_phone_number: 'This call has no valid phone number.',
                call_has_no_campaign_for_campaign_dnc: 'This call has no campaign for campaign-only DND.',
                disposition_not_configured: 'This disposition is not configured for this tenant.',
                valid_future_callback_at_required: 'Choose a valid future callback time.',
                forbidden: 'You are not allowed to disposition this call.'
            };
            throw new Error(messages[result.error] || result.error || 'Could not save disposition.');
        }

        message.textContent = `Saved: ${result.code}`;
        document.getElementById('dispositionNotes').value = '';
        document.getElementById('callbackAt').value = '';
        await loadCompletedDispositionCalls();
    } catch (err) {
        message.textContent = err.message || 'Could not save disposition.';
    } finally {
        button.disabled = false;
    }
});

loadCompletedDispositionCalls();
// Collector updates can lag behind the browser hang-up event; periodically refresh.
setInterval(loadCompletedDispositionCalls, 10000);

initSip();
</script>
