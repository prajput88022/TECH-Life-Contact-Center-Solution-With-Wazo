<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<h1>Caller ID / CLI Settings</h1>
<p class="tl-subtitle">
    Set the default outbound caller ID for this tenant. Use only a number
    authorized by your telephony provider.
</p>

<form method="post"
      action="/admin/cli-settings<%= typeof effectiveTenant !== 'undefined' && effectiveTenant.id !== currentUser.tenantId ? '?as_tenant=' + encodeURIComponent(effectiveTenant.id) : '' %>"
      class="tl-card">
    <div class="tl-filters">
        <div>
            <label>Tenant Default Caller ID / CLI</label>
            <input name="default_caller_id"
                   maxlength="30"
                   value="<%= settings.default_caller_id || '' %>"
                   placeholder="e.g. +911234567890">
            <small>Leave blank to clear the tenant default.</small>
        </div>
    </div>
    <button class="tl-btn" type="submit">Save CLI Settings</button>
</form>

<%- include('../partials/foot') %>
