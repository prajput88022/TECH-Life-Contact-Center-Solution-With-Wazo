        if (!result.rowCount) return res.status(404).send('Agent not found for this tenant.');

        await writeAuditLog(
            t, req.session.user.id, 'AGENT_SKILLS_UPDATED',
            'agent', req.params.id, null, { skills },
            req.ip || null
        );

        return res.redirect(skillRoutingRedirect(req));
