// ---- Calls list (JSON) ----
router.get('/calls', async (req, res) => {
    const u = req.session.user;
    const [from, to] = dateRange(req);
    const page = Math.max(1, parseInt(req.query.page || '1', 10));
    const perPage = 50;
    const offset = (page - 1) * perPage;

    const where = ['c.tenant_id = $1', 'c.start_time BETWEEN $2 AND $3'];
    const params = [u.tenantId, from, to];
    let idx = 4;
    if (isScopedSupervisor(u)) {
        params.push(u.id);
        where.push(`EXISTS (SELECT 1 FROM agents scope_ag WHERE scope_ag.id = c.agent_id AND ${agentAccessPredicate('scope_ag', '$1', '$4')})`);
        idx = 5;
    }
    for (const f of ['agent_id', 'queue_id', 'campaign_id', 'did_id', 'status', 'direction']) {
        if (req.query[f]) { where.push(`c.${f} = $${idx++}`); params.push(req.query[f]); }
    }
    const result = await pool.query(
        `SELECT c.id, c.agent_id, c.queue_id, c.campaign_id, c.did_id, c.direction, c.status,
                c.start_time, c.answer_time, c.end_time, c.talk_seconds, c.wait_seconds, c.hangup_cause
         FROM calls c WHERE ${where.join(' AND ')} ORDER BY c.start_time DESC LIMIT ${perPage} OFFSET ${offset}`,
        params
    );
    res.json({ page, results: result.rows });
});

