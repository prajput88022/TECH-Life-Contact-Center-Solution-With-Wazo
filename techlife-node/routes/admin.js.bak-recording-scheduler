                    d.is_active, d.parent_id, d.hierarchy_level, d.sort_order,
                    p.code AS parent_code, p.label AS parent_label
               FROM dispositions d
               LEFT JOIN dispositions p
                 ON p.id = d.parent_id AND p.tenant_id = d.tenant_id
