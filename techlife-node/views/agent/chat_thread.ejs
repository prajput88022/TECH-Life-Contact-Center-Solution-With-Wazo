<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<h1>Chat with <%= conversation.contact_name || 'Website visitor' %></h1>
<p class="tl-subtitle"><a href="/agent/chat">← Back to Chat Inbox</a></p>

<div class="tl-card" id="thread" style="max-width:600px;min-height:300px;display:flex;flex-direction:column;gap:8px"></div>

<div style="max-width:600px;margin-top:10px">
    <% if (!conversation.agent_id) { %>
    <form method="post" action="/agent/chat/<%= conversation.id %>/claim">
        <button class="tl-btn" type="submit">Claim This Chat</button>
    </form>
    <% } else { %>
    <form method="post" action="/agent/chat/<%= conversation.id %>/reply" style="display:flex;gap:8px">
        <input type="text" name="body" placeholder="Type a reply…" style="flex:1;padding:9px" required>
        <button class="tl-btn" type="submit">Send</button>
    </form>
    <form method="post" action="/agent/chat/<%= conversation.id %>/close" style="margin-top:8px">
        <button class="tl-btn secondary" type="submit">Close Conversation</button>
    </form>
    <% } %>
</div>

<script>
const CONV_ID = <%- JSON.stringify(conversation.id) %>;
function renderMessages(messages) {
    const thread = document.getElementById('thread');
    thread.replaceChildren();

    messages.forEach(m => {
        const isAgent = m.sender_type === 'agent';
        const isCustomer = m.sender_type === 'customer';

        const bubble = document.createElement('div');
        bubble.style.alignSelf = isAgent ? 'flex-end' : 'flex-start';
        bubble.style.maxWidth = '75%';
        bubble.style.background = isCustomer ? '#f0f2f7' : (isAgent ? '#2563eb' : '#fef3d6');
        bubble.style.color = isAgent ? '#fff' : '#1a2233';
        bubble.style.padding = '8px 12px';
        bubble.style.borderRadius = '10px';
        bubble.style.fontSize = '13px';

        const body = document.createElement('div');
        body.textContent = m.body || '';
        bubble.appendChild(body);

        const meta = document.createElement('div');
        meta.style.fontSize = '10px';
        meta.style.opacity = '.7';
        meta.style.marginTop = '2px';
        meta.textContent = (m.sender_type || 'message') + ' · ' +
            (m.sent_at ? new Date(m.sent_at).toLocaleTimeString() : '');
        bubble.appendChild(meta);

        thread.appendChild(bubble);
    });
}
async function poll() {
    const res = await fetch(`/agent/chat/${CONV_ID}/messages.json`);
    const data = await res.json();
    if (data.messages) renderMessages(data.messages);
}
poll();
setInterval(poll, 4000);
</script>
<%- include('./digital_presence') %>
<%- include('../partials/foot') %>
