.ci-mode-switch {
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:10px;
}
.ci-mode-button {
    display:flex;
    justify-content:center;
    align-items:center;
    gap:9px;
    min-height:48px;
    padding:10px 14px;
    border:1px solid var(--tl-border,#ccd);
    border-radius:9px;
    background:var(--tl-panel,#f5f6f8);
    color:var(--tl-text,inherit);
    font-weight:700;
    cursor:pointer;
}
.ci-mode-button.active {
    border:2px solid var(--tl-blue,#3978c6);
    background:var(--tl-card,#fff);
    box-shadow:inset 0 0 0 1px var(--tl-blue,#3978c6);
}
.ci-mode-dot {
    width:9px;
    height:9px;
    border-radius:50%;
    background:#9ca3af;
}
.ci-mode-button.active[data-capture-mode="live"] .ci-mode-dot {
    background:#16a34a;
    box-shadow:0 0 0 4px rgba(22,163,74,.13);
}
.ci-mode-button.active[data-capture-mode="scheduled"] .ci-mode-dot {
    background:#3978c6;
    box-shadow:0 0 0 4px rgba(57,120,198,.13);
}

@media(max-width:700px) {
    .ci-ladder-row { grid-template-columns:1fr; gap:5px; }
    .ci-arrow { text-align:left; }
}
</style>

<div class="ci-wrap">
    <header>
        <h1>Call Intelligence</h1>
        <p class="tl-subtitle">
            Capture control, SIP signalling investigation and observed Asterisk call-leg diagnostics.
        </p>
    </header>

    <% if (notice) { %>
        <div class="tl-card <%= notice.type === 'error' ? 'ci-error' : 'ci-success' %>">
            <strong><%= notice.type === 'error' ? 'Action not completed' : 'Status' %></strong>
            <p><%= notice.message %></p>
        </div>
    <% } %>

    <% if (selectedSession) { %>
    <%- include('../partials/call_intelligence_live_dashboard', { selectedSession, csrfToken }) %>
    <% } else if (selectedCall) { %>
        <div>
            <a class="tl-btn secondary" href="/admin/call-intelligence">← Back to call search</a>
        </div>

        <section class="tl-card ci-section">
            <h2>Call overview</h2>
            <div class="ci-grid">
                <div class="ci-stat"><span class="ci-muted">Wazo Call ID</span><strong><%= selectedCall.wazo_call_id || '—' %></strong></div>
                <div class="ci-stat"><span class="ci-muted">Direction</span><strong><%= celTrace && celTrace.available && celTrace.direction !== 'unknown' ? celTrace.direction : (selectedCall.direction || '—') %></strong></div>
                <div class="ci-stat"><span class="ci-muted">Status</span><strong><%= selectedCall.status || '—' %></strong></div>
                <div class="ci-stat"><span class="ci-muted">Agent</span><strong><%= selectedCall.agent_name %></strong></div>
                <div class="ci-stat"><span class="ci-muted">From</span><strong><%= selectedCall.from_number || '—' %></strong></div>
                <div class="ci-stat"><span class="ci-muted">To</span><strong><%= selectedCall.to_number || '—' %></strong></div>
            </div>
            <p class="ci-muted">Call record: <code><%= selectedCall.id %></code></p>
        </section>


        <section class="tl-card ci-section">
            <div>
                <h2>End-to-end call flow</h2>
                <p class="ci-muted">
                    Correlated from Asterisk CEL using Uniqueid and Linkedid.
                    PJSIP channels are displayed only after tenant identity verification.
                </p>
            </div>

            <% if (celTrace && celTrace.available) { %>
                <div class="ci-pill-row">
                    <span class="ci-pill">Source: Asterisk CEL</span>
                    <span class="ci-pill">Direction: <%= celTrace.direction %></span>
                    <span class="ci-pill">Linkedid: <code><%= celTrace.linkedId %></code></span>
                    <span class="ci-pill">Verified legs: <%= celTrace.legCount %></span>
                    <span class="ci-pill">CEL events: <%= celTrace.eventCount %></span>
                </div>

                <% if (celTrace.omittedEventCount > 0) { %>
                    <div class="ci-trace-note">
                        <%= celTrace.omittedEventCount %> related CEL records were
                        omitted because their channels could not be verified for this tenant.
                    </div>
                <% } %>

                <div class="ci-flow">
                    <% celTrace.flowNodes.forEach((node, index) => { %>
                        <% if (index > 0) { %>
                            <div class="ci-flow-arrow" aria-hidden="true">→</div>
                        <% } %>
                        <div class="ci-flow-card <%= node.kind %>">
                            <div class="ci-flow-kind"><%= node.kindLabel %></div>
                            <strong class="ci-flow-title"><%= node.title %></strong>
                            <div class="ci-flow-detail"><%= node.detail || '—' %></div>
                            <% if (node.uniqueId) { %>
                                <div class="ci-flow-meta">
                                    Uniqueid: <code><%= node.uniqueId %></code>
                                </div>
                            <% } %>
                            <div class="ci-flow-meta"><%= node.meta || '' %></div>
                        </div>
                    <% }) %>
                </div>

                <% if (celTrace.direction === 'outbound') { %>
                    <div class="ci-trace-note">
                        The dialled number is shown as the recorded target.
                        A separate carrier or remote destination leg is shown only
                        when Asterisk records and verifies that channel.
                    </div>
                <% } %>

            <% } else { %>
                <div class="ci-trace-note">
                    Historical Asterisk CEL trace is not available for this call.
                    Existing TECH-Life events and any associated capture-session data
                    remain available below.
                    <% if (celTrace && celTrace.reason === 'tenant_identity_not_verified') { %>
                        The call's PJSIP endpoint identity could not be verified for this tenant.
                    <% } else if (celTrace && celTrace.reason === 'cel_call_not_found') { %>
                        No matching Asterisk CEL Uniqueid or Linkedid was found.
                    <% } else if (celTrace && celTrace.reason === 'ambiguous_cel_linkedid') { %>
                        More than one Linkedid matched this call ID; the trace was withheld
                        rather than combining potentially unrelated calls.
                    <% } %>
                </div>
            <% } %>
        </section>

        <section class="tl-card ci-section">
            <div>
                <h2>Graphical SIP signalling ladder</h2>
                <p class="ci-muted">
                    Actual HEP SIP packets arranged by timestamp and network direction.
                    Each vertical lifeline represents an observed IP address and port.
                    Arrow direction is derived from the packet source and destination.
                </p>
            </div>

            <% const callSipCount = sipLadder ? sipLadder.messages.length : 0; %>
            <% const callRtcpPackets = capturePackets.filter(p => p.record_type === 'rtcp'); %>
            <% const callDtmfEvents = captureAmiEvents.filter(e =>
                e.digit != null ||
                ['DTMFBegin', 'DTMFEnd'].includes(e.event_type)
            ); %>

            <% if (callSipCount > 0) { %>
                <div class="ci-sip-scroll">
                <div class="ci-sequence-board"
                     style="min-width:<%= Math.max(950, sipLadder.participants.length * 190 + 92) %>px">
                    <div class="ci-sequence-summary">
                        <strong><%= callSipCount %> SIP messages</strong>
                        <span><%= sipLadder.participants.length %> signalling endpoints</span>
                        <span>
                            <%= sipLadder.firstPacketTime
                                ? new Date(sipLadder.firstPacketTime).toLocaleString()
                                : 'Time unavailable' %>
                            —
                            <%= sipLadder.lastPacketTime
                                ? new Date(sipLadder.lastPacketTime).toLocaleString()
                                : 'Time unavailable' %>
                        </span>
                        <% if (celTrace && celTrace.available) { %>
                            <span><%= celTrace.legCount %> verified call legs</span>
                        <% } %>
                    </div>

                    <div class="ci-sequence-header">
                        <div class="ci-sequence-gutter"></div>
                        <div class="ci-sequence-participants"
                             style="grid-template-columns:repeat(<%= sipLadder.participants.length %>,minmax(0,1fr))">
                            <% sipLadder.participants.forEach((participant, index) => { %>
                                <div class="ci-sequence-participant">
                                    <strong><%= participant.ip %></strong>
                                    <small>Port <%= participant.port %></small>
                                </div>
                            <% }) %>
                        </div>
                    </div>

                    <% sipLadder.messages.forEach((message, index) => { %>
                        <div class="ci-sequence-row">
                            <div class="ci-sequence-time">
                                <strong>
                                    <%= message.packetTime
                                        ? new Date(message.packetTime).toLocaleTimeString()
                                        : 'Time unavailable' %>
                                </strong>
                                <span>#<%= index + 1 %></span>
                            </div>

                            <div class="ci-sequence-lane">
                                <div class="ci-sequence-lifelines"
                                     style="grid-template-columns:repeat(<%= sipLadder.participants.length %>,minmax(0,1fr))">
                                    <% sipLadder.participants.forEach(() => { %>
                                        <span></span>
                                    <% }) %>
                                </div>

                                <div class="ci-sequence-arrow">
                                    <svg viewBox="0 0 1000 27"
                                         preserveAspectRatio="none"
                                         role="img"
                                         aria-label="SIP message direction">
                                        <defs>
                                            <marker id="ci-sequence-arrow-<%= index %>"
                                                    markerWidth="8"
                                                    markerHeight="8"
                                                    refX="7"
                                                    refY="4"
                                                    orient="auto"
                                                    markerUnits="userSpaceOnUse">
                                                <path d="M0,0 L8,4 L0,8 z"
                                                      fill="<%= message.lineColor %>"></path>
                                            </marker>
                                        </defs>
                                        <line
                                            x1="<%= message.sourceX %>"
                                            y1="19"
                                            x2="<%= message.destinationX %>"
                                            y2="19"
                                            stroke="<%= message.lineColor %>"
                                            stroke-width="2"
                                            marker-end="url(#ci-sequence-arrow-<%= index %>)">
                                        </line>
                                    </svg>

                                    <span class="ci-sequence-label"
                                          style="left:<%= message.labelLeftPercent %>%;color:<%= message.lineColor %>">
                                        <%= message.label %>
                                    </span>
                                </div>

                                <div class="ci-sequence-callid">
                                    <%= message.callId
                                        ? String(message.callId).slice(0,58)
                                        : 'SIP Call-ID unavailable' %>
                                </div>

                                <details class="ci-sequence-detail">
                                    <summary>
                                        Message details
                                        · <%= message.transportLabel %>
                                        · CSeq <%= message.cseq || '—' %>
                                        <% if (message.elapsedMs !== null) { %>
                                            · +<%= message.elapsedMs.toFixed(1) %> ms
                                        <% } %>
                                    </summary>
                                    <div class="ci-sequence-detail-content">
                                        <div><strong>Source:</strong> <%= message.sourceLabel %></div>
                                        <div><strong>Destination:</strong> <%= message.destinationLabel %></div>
                                        <div><strong>Channel:</strong> <%= message.channelName || '—' %></div>
                                        <div><strong>Request URI:</strong> <%= message.requestUri || '—' %></div>
                                        <div><strong>From URI:</strong> <%= message.fromUri || '—' %></div>
                                        <div><strong>To URI:</strong> <%= message.toUri || '—' %></div>

                                        <% if (message.payloadPreview) { %>
                                            <pre><%= message.payloadPreview %></pre>
                                            <% if (message.payloadTruncated) { %>
                                                <p>Payload display limited to 12 KB.</p>
                                            <% } %>
                                        <% } else { %>
                                            <p>No raw SIP payload preview stored.</p>
                                        <% } %>
                                    </div>
                                </details>
                            </div>
                        </div>
                    <% }) %>
                </div>
                </div>

                <p class="ci-muted">
                    Each row is one observed SIP packet. Arrow direction is taken
                    from the actual source and destination IP/port. Message details
                    are expandable; authentication headers are redacted.
                </p>
            <% } else { %>
                <div class="ci-sequence-no-packets">
                    No SIP packets were captured for this call. The verified CEL
                    call flow and event history remain available above. Start a
                    capture session before placing a new test call to populate this
                    signalling diagram.
                </div>
            <% } %>

            <div>
                <h3>DTMF events</h3>
                <% if (callDtmfEvents.length) { %>
                    <div class="ci-table">
                        <table>
                            <thead>
                                <tr>
                                    <th>Time</th>
                                    <th>Event</th>
                                    <th>Digit</th>
                                    <th>Duration</th>
                                    <th>Channel</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% callDtmfEvents.forEach(event => { %>
                                    <tr>
                                        <td><%= event.event_time ? new Date(event.event_time).toLocaleString() : '—' %></td>
                                        <td><%= event.event_type || '—' %></td>
                                        <td><strong><%= event.digit || '—' %></strong></td>
                                        <td><%= event.duration_ms == null ? '—' : event.duration_ms + ' ms' %></td>
                                        <td><code><%= event.channel_name || '—' %></code></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <p class="ci-muted">No captured DTMF events are linked to this call.</p>
                <% } %>
            </div>

            <div>
                <h3>RTCP records</h3>
                <% if (callRtcpPackets.length) { %>
                    <% callRtcpPackets.forEach(packet => { %>
                        <div class="ci-media-record">
                            <strong><%= packet.packet_time ? new Date(packet.packet_time).toLocaleString() : 'Time unavailable' %></strong>
                            <div class="ci-muted">
                                <%= packet.source_ip || 'Unknown source' %>:<%= packet.source_port || '?' %>
                                → <%= packet.destination_ip || 'Unknown destination' %>:<%= packet.destination_port || '?' %>
                            </div>
                            <div class="ci-muted">
                                Channel: <%= packet.channel_name || '—' %>
                            </div>
                        </div>
                    <% }) %>
                    <p class="ci-muted">
                        These are captured RTCP records. Packet presence alone does not
                        establish MOS, jitter, packet loss or one-way audio; those metrics
                        require RTCP report decoding and correlation.
                    </p>
                <% } else { %>
                    <p class="ci-muted">No RTCP records were captured for this call.</p>
                <% } %>
            </div>
        </section>

        <section class="tl-card ci-section">
            <h2>Call timing</h2>
            <div class="ci-grid">
                <div class="ci-stat"><span class="ci-muted">Started</span><strong><%= selectedCall.start_time ? new Date(selectedCall.start_time).toLocaleString() : '—' %></strong></div>
                <div class="ci-stat"><span class="ci-muted">Ringing</span><strong><%= selectedCall.ring_time ? new Date(selectedCall.ring_time).toLocaleString() : '—' %></strong></div>
                <div class="ci-stat"><span class="ci-muted">Answered</span><strong><%= selectedCall.answer_time ? new Date(selectedCall.answer_time).toLocaleString() : '—' %></strong></div>
                <div class="ci-stat"><span class="ci-muted">Ended</span><strong><%= selectedCall.end_time ? new Date(selectedCall.end_time).toLocaleString() : '—' %></strong></div>
                <div class="ci-stat"><span class="ci-muted">Ring seconds</span><strong><%= selectedCall.ring_seconds ?? '—' %></strong></div>
                <div class="ci-stat"><span class="ci-muted">Wait seconds</span><strong><%= selectedCall.wait_seconds ?? '—' %></strong></div>
                <div class="ci-stat"><span class="ci-muted">Talk seconds</span><strong><%= selectedCall.talk_seconds ?? '—' %></strong></div>
                <div class="ci-stat"><span class="ci-muted">Hold seconds</span><strong><%= selectedCall.hold_seconds ?? '—' %></strong></div>
            </div>
            <p class="ci-muted">
                Hangup cause: <%= selectedCall.hangup_cause || '—' %>
                · Hangup by: <%= selectedCall.hangup_by || '—' %>
                · Transfer: <%= selectedCall.is_transfer ? 'Yes' : 'No' %>
            </p>
        </section>

    <% } else { %>
        <section class="tl-card ci-warning">
            <strong>Important: global HEP exporter</strong>
            <p class="ci-muted">
                A capture temporarily enables the Asterisk/Wazo HEP exporter globally.
                During that window, HEP traffic from other channels may reach the local
                receiver. TECH-Life is designed to persist only verified records matching
                the selected tenant and scope. Do not treat the exporter itself as
                tenant-isolated. The receiver must remain local and the capture window
                should be limited to the required investigation.
            </p>
            <p class="ci-muted">
                SIP and RTCP telemetry are supported by this capture worker. Raw RTP media
                capture, full-media PCAP, decoded RTCP QoS reports and downloadable
                artifacts are not yet implemented.
            </p>
        </section>

        <% const activeLiveSession = (captureSessions || []).find(s =>
            s.capture_mode === 'live' && ['starting', 'active', 'stopping'].includes(s.status)
        ); %>
        <section class="tl-card ci-section ci-live-toggle-card">
            <div class="ci-live-toggle-row">
                <div>
                    <h2>Live Capture</h2>
                    <p class="ci-muted">Start or stop tenant-scoped SIP + RTCP observation.</p>
                </div>
                <span class="ci-live-state <%= activeLiveSession ? 'is-on' : 'is-off' %>">
                    <span></span><%= activeLiveSession ? 'ON' : 'OFF' %>
                </span>
            </div>
            <% if (activeLiveSession) { %>
                <div class="ci-live-toggle-row">
                    <a class="tl-btn secondary" href="/admin/call-intelligence/sessions/<%= activeLiveSession.id %>">Open live dashboard</a>
                    <% if (activeLiveSession.status === 'active') { %>
                        <form method="post" action="/admin/call-intelligence/sessions/<%= activeLiveSession.id %>/stop">
                            <input type="hidden" name="_ci_csrf" value="<%= csrfToken %>">
                            <button class="tl-btn" type="submit">Turn Live Capture OFF</button>
                        </form>
                    <% } else if (activeLiveSession.status === 'starting') { %>
                        <form method="post" action="/admin/call-intelligence/sessions/<%= activeLiveSession.id %>/cancel">
                            <input type="hidden" name="_ci_csrf" value="<%= csrfToken %>">
                            <button class="tl-btn secondary" type="submit">Cancel starting capture</button>
                        </form>
                    <% } else { %>
                        <span class="ci-muted">Capture is stopping…</span>
                    <% } %>
                </div>
            <% } else { %>
                <p class="ci-muted">Live Capture is OFF. Choose Live Capture in the session form below and turn it ON.</p>
            <% } %>
        </section>

        <section class="tl-card ci-section">
            <div>
                <h2>Create capture session</h2>
                <p class="ci-muted">
                    Tenant: <strong><%= effectiveTenant ? effectiveTenant.name : 'Current tenant' %></strong>
                    · Timezone: <strong><%= timezone %></strong>
                </p>
            </div>

            <form method="post" action="/admin/call-intelligence/sessions" id="ci-capture-form" data-live-active="<%= activeLiveSession ? 'true' : 'false' %>">
                <input type="hidden" name="_ci_csrf" value="<%= csrfToken %>">

                <div class="ci-form-grid">
                    <div class="ci-field ci-mode-field">
                        <label>Capture mode</label>
                        <div class="ci-mode-switch" role="group" aria-label="Capture mode">
                            <button type="button" class="ci-mode-button active"
                                    data-capture-mode="live" aria-pressed="true">
                                <span class="ci-mode-dot"></span>
                                Live Capture
                            </button>
                            <button type="button" class="ci-mode-button"
                                    data-capture-mode="scheduled" aria-pressed="false">
                                <span class="ci-mode-dot"></span>
                                Scheduled Capture
                            </button>
                        </div>
                        <input type="hidden" id="ci-mode" name="capture_mode" value="live">
                    </div>

                    <div class="ci-field">
                        <label for="ci-scope">Capture scope</label>
                        <select id="ci-scope" name="capture_scope" required>
                            <option value="tenant">Entire tenant</option>
                            <option value="trunk">Specific trunk</option>
                            <option value="agent">Specific agent</option>
                        </select>
                    </div>

                    <div class="ci-field" id="ci-trunk-field" hidden>
                        <label for="ci-trunk">Trunk</label>
                        <select id="ci-trunk" name="trunk_id">
                            <option value="">Select provisioned trunk</option>
                            <% trunks.forEach(trunk => { %>
                                <option value="<%= trunk.id %>"><%= trunk.name %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="ci-field" id="ci-agent-field" hidden>
                        <label for="ci-agent">Agent</label>
                        <select id="ci-agent" name="agent_id">
                            <option value="">Select active agent</option>
                            <% agents.forEach(agent => { %>
                                <option value="<%= agent.id %>">
                                    <%= agent.agent_number || agent.extension || agent.id %>
                                    <% if (agent.extension) { %> · Ext <%= agent.extension %><% } %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="ci-field">
                        <label for="ci-profile">Capture profile</label>
                        <select id="ci-profile" name="capture_profile">
                            <option value="sip_rtcp">SIP + RTCP telemetry</option>
                            <option value="sip">SIP signalling only</option>
                        </select>
                    </div>

                    <div class="ci-field" id="ci-start-field" hidden>
                        <label for="ci-start">Start date and time (<%= timezone %>)</label>
                        <input id="ci-start" name="scheduled_start_at"
                               type="datetime-local"
                               value="<%= defaultScheduledStart %>">
                    </div>

                    <div class="ci-field" id="ci-stop-field" hidden>
                        <label for="ci-stop">Stop date and time (<%= timezone %>)</label>
                        <input id="ci-stop" name="scheduled_stop_at"
                               type="datetime-local"
                               value="<%= defaultScheduledStop %>">
                    </div>

                    <div class="ci-field" id="ci-duration-field">
                        <label for="ci-duration">Maximum live duration (minutes)</label>
                        <input id="ci-duration" type="number" name="duration_minutes"
                               min="1" max="240" value="10" required>
                    </div>

                    <div class="ci-field">
                        <label for="ci-storage">Storage cap (MB)</label>
                        <input id="ci-storage" type="number" name="storage_mb"
                               min="1" max="2048" value="64" required>
                    </div>

                    <div class="ci-field">
                        <label for="ci-retention">Retention (days)</label>
                        <input id="ci-retention" type="number" name="retention_days"
                               min="1" max="30" value="7" required>
                    </div>
                </div>

                <div class="ci-actions" style="margin-top:16px">
                    <button class="tl-btn" type="submit">Create capture session</button>
                </div>
            </form>
            <p class="ci-muted">
                Live sessions enter a validation/start queue. Scheduled sessions are
                started by the background worker at the selected tenant-local time.
                The worker enforces the duration and storage limits.
            </p>
        </section>

        <section class="tl-card ci-section">
            <div>
                <h2>Capture session history</h2>
                <p class="ci-muted">Latest 50 sessions for this tenant.</p>
            </div>

            <div class="ci-table">
                <table>
                    <thead>
                        <tr>
                            <th>Created</th><th>Mode</th><th>Scope</th><th>Target</th>
                            <th>Profile</th><th>Status</th><th>Packets</th>
                            <th>AMI events</th><th>Legs</th><th>Storage</th><th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% captureSessions.forEach(session => { %>
                            <tr>
                                <td><%= new Date(session.created_at).toLocaleString() %></td>
                                <td><%= session.capture_mode %></td>
                                <td><%= session.capture_scope %></td>
                                <td>
                                    <%= session.trunk_name || '' %>
                                    <% if (session.agent_number) { %>Agent <%= session.agent_number %><% } %>
                                    <% if (!session.trunk_name && !session.agent_number) { %>Tenant-wide<% } %>
                                </td>
                                <td><%= session.capture_profile %></td>
                                <td><span class="ci-status <%= session.status %>"><%= session.status %></span></td>
                                <td><%= session.packet_count %></td>
                                <td><%= session.ami_event_count %></td>
                                <td><%= session.leg_count %></td>
                                <td><%= (Number(session.bytes_written || 0) / 1048576).toFixed(2) %> MB</td>
                                <td>
                                    <div class="ci-actions">
                                        <a href="/admin/call-intelligence/sessions/<%= session.id %>">Inspect</a>
                                        <% if (session.status === 'active') { %>
                                            <form method="post" action="/admin/call-intelligence/sessions/<%= session.id %>/stop"
                                                  onsubmit="return confirm('Stop this capture?');">
                                                <input type="hidden" name="_ci_csrf" value="<%= csrfToken %>">
                                                <button class="tl-btn secondary" type="submit">Stop</button>
                                            </form>
                                        <% } %>
                                        <% if (['scheduled','starting'].includes(session.status)) { %>
                                            <form method="post" action="/admin/call-intelligence/sessions/<%= session.id %>/cancel"
                                                  onsubmit="return confirm('Cancel this capture?');">
                                                <input type="hidden" name="_ci_csrf" value="<%= csrfToken %>">
                                                <button class="tl-btn secondary" type="submit">Cancel</button>
                                            </form>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                        <% if (!captureSessions.length) { %>
                            <tr><td colspan="11">No capture sessions have been created for this tenant.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>

        <form method="get" action="/admin/call-intelligence" class="tl-card">
            <h2>Search TECH-Life calls</h2>
            <div class="ci-form-grid">
                <div class="ci-field">
                    <label for="q">Call ID, number or agent</label>
                    <input id="q" name="q" maxlength="120"
                           value="<%= q %>" placeholder="Wazo ID, phone, UUID, agent">
                </div>
                <div class="ci-field">
                    <label for="from">From date</label>
                    <input id="from" name="from" type="date" value="<%= from %>">
                </div>
                <div class="ci-field">
                    <label for="to">To date</label>
                    <input id="to" name="to" type="date" value="<%= to %>">
                </div>
            </div>
            <div class="ci-actions" style="margin-top:14px">
                <button class="tl-btn" type="submit">Search calls</button>
                <a class="tl-btn secondary" href="/admin/call-intelligence">Reset</a>
            </div>
        </form>

        <section class="tl-card ci-section">
            <p class="ci-muted">
                <strong><%= total %></strong> matching call records.
                Showing the latest 100 results. Demo-only synthetic records are excluded.
            </p>
            <div class="ci-table">
                <table>
                    <thead>
                        <tr>
                            <th>Start time</th><th>Wazo Call ID</th><th>Direction</th>
                            <th>From</th><th>To</th><th>Agent</th>
                            <th>Status</th><th>Events</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% calls.forEach(call => { %>
                            <tr>
                                <td><%= call.start_time ? new Date(call.start_time).toLocaleString() : '—' %></td>
                                <td><code><%= call.wazo_call_id || '—' %></code></td>
                                <td><%= call.direction || '—' %></td>
                                <td><%= call.from_number || '—' %></td>
                                <td><%= call.to_number || '—' %></td>
                                <td><%= call.agent_name %></td>
                                <td><span class="ci-status"><%= call.status || '—' %></span></td>
                                <td><%= call.event_count %></td>
                                <td><a href="/admin/call-intelligence/<%= call.id %>">Inspect trace</a></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>
    <% } %>
</div>

<script>
(function () {
    const scope = document.getElementById('ci-scope');
    const mode = document.getElementById('ci-mode');
    const modeButtons = document.querySelectorAll('[data-capture-mode]');
    const trunkField = document.getElementById('ci-trunk-field');
    const agentField = document.getElementById('ci-agent-field');
    const startField = document.getElementById('ci-start-field');
    const stopField = document.getElementById('ci-stop-field');
    const durationField = document.getElementById('ci-duration-field');
    const trunk = document.getElementById('ci-trunk');
    const agent = document.getElementById('ci-agent');
    const start = document.getElementById('ci-start');
    const stop = document.getElementById('ci-stop');
    const duration = document.getElementById('ci-duration');
    const captureForm = document.getElementById('ci-capture-form');
    const captureSubmit = captureForm && captureForm.querySelector('button[type="submit"]');
    const liveAlreadyActive = !!(captureForm && captureForm.dataset.liveActive === 'true');

    if (!scope || !mode) return;

    function updateScope() {
        const value = scope.value;
        trunkField.hidden = !['trunk', 'agent'].includes(value);
        agentField.hidden = value !== 'agent';

        if (trunk) {
            trunk.required = value === 'trunk';
            if (value === 'tenant') trunk.value = '';
        }

        if (agent) {
            agent.required = value === 'agent';
            if (value !== 'agent') agent.value = '';
        }
    }

    function updateMode() {
        const scheduled = mode.value === 'scheduled';

        startField.hidden = !scheduled;
        stopField.hidden = !scheduled;
        durationField.hidden = scheduled;

        if (start) start.required = scheduled;
        if (stop) {
            stop.required = scheduled;
            stop.min = start && start.value ? start.value : '';
        }
        if (duration) duration.required = !scheduled;

        modeButtons.forEach(button => {
            const active = button.dataset.captureMode === mode.value;
            button.classList.toggle('active', active);
            button.setAttribute('aria-pressed', active ? 'true' : 'false');
            if (button.dataset.captureMode === 'live') button.disabled = liveAlreadyActive;
        });
        if (captureSubmit) {
            captureSubmit.disabled = liveAlreadyActive && !scheduled;
            captureSubmit.textContent = scheduled
                ? 'Create Scheduled Capture'
                : liveAlreadyActive
                    ? 'Live Capture Already ON'
                    : 'Turn Live Capture ON';
        }
    }

    modeButtons.forEach(button => {
        button.addEventListener('click', () => {
            mode.value = button.dataset.captureMode;
            updateMode();
        });
    });

    scope.addEventListener('change', updateScope);
    mode.addEventListener('change', updateMode);
    if (start) start.addEventListener('change', updateMode);

    updateScope();
    updateMode();
})();
</script>

<%- include('../partials/foot') %>
